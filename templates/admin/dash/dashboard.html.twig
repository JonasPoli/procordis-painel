{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard & Central de Comunicações{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto space-y-8" id="admin-dashboard-app">

    <!-- Hero Header: Procordis Central Hub -->
    <section class="relative overflow-hidden p-6 lg:p-8 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900/95 to-slate-950 border border-slate-800 shadow-2xl text-white">
        <!-- Glow background accents -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div class="flex items-start gap-4">
                <div class="p-3 rounded-2xl bg-white shadow-md border border-slate-200 shrink-0 hidden sm:flex items-center justify-center">
                    <img src="/images/logo-A3qBa0m.svg" alt="Procordis Medicina Diagnóstica" class="h-11 w-auto max-w-[190px]">
                </div>
                <div class="space-y-1.5">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-slate-800/80 border border-slate-700 text-cyan-400">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Central de Comunicação e Qualidade de Dados
                    </div>
                    <h1 class="text-3xl lg:text-4xl font-black tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                        Painel de Controle e Integração Medware
                    </h1>
                    <p class="text-sm text-slate-400 max-w-2xl">
                        Monitoramento em tempo real de latência, velocidade de sincronização, qualidade dos pacotes de dados e parâmetros de refresh dos painéis.
                    </p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3">
                <sl-button variant="primary" size="medium" id="btn-sync-dash" onclick="executarSyncDashboard()">
                    <sl-icon slot="prefix" name="cloud-arrow-down" id="icon-sync-dash"></sl-icon>
                    Sincronizar Agora
                </sl-button>
                <a href="{{ path('app_admin_testes_index') }}">
                    <sl-button variant="default" size="medium">
                        <sl-icon slot="prefix" name="check2-circle"></sl-icon>
                        Diagnóstico & Testes
                    </sl-button>
                </a>
                <a href="/painel/espera" target="_blank">
                    <sl-button variant="default" size="medium" outline>
                        <sl-icon slot="prefix" name="box-arrow-up-right"></sl-icon>
                        Abrir Painel TV
                    </sl-button>
                </a>
            </div>
        </div>

        <!-- Live Sync Status Banner Inside Hero -->
        <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs">
            <div class="flex items-center gap-3">
                <span class="p-2 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400">
                    <sl-icon name="arrow-repeat" class="text-base"></sl-icon>
                </span>
                <div>
                    <span class="text-slate-400 block font-medium">Última recepção de dados da API Medware:</span>
                    <span id="dash-sync-timestamp" class="text-white font-extrabold text-sm">{{ infoSync.dataHoraFormatada }}</span>
                    <span id="dash-sync-relativo" class="text-cyan-400 font-bold ml-1.5">({{ infoSync.tempoRelativo }})</span>
                </div>
            </div>

            <div class="flex items-center gap-4 text-slate-300">
                <div>
                    <span class="text-slate-500">API Host:</span>
                    <code class="text-cyan-300 font-mono ml-1">{{ infoSync.apiBaseUrl }}</code>
                </div>
                <div class="h-4 w-px bg-slate-800"></div>
                <div>
                    <span class="text-slate-500">Usuário:</span>
                    <strong class="text-slate-200 ml-1">{{ infoSync.apiUsuario }}</strong>
                </div>
            </div>
        </div>
    </section>

    <!-- 4 KPI Cards: Qualidade dos Dados & Velocidade da Internet -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Card 1: Velocidade da Internet / Latência da API -->
        <div class="p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Velocidade / Latência</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-{{ qualidade.corQualidade }}-500/10 text-{{ qualidade.corQualidade }}-500 border border-{{ qualidade.corQualidade }}-500/20">
                    {{ qualidade.qualidadeConexao }}
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900 dark:text-white" id="dash-latencia-media">{{ qualidade.mediaLatencia }}</span>
                <span class="text-sm font-bold text-slate-400">ms (média)</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-emerald-400 to-cyan-500 h-full rounded-full" style="width: {{ min(100, max(10, 100 - (qualidade.mediaLatencia / 10))) }}%"></div>
            </div>
            <p class="text-[11px] text-slate-400">Pico máximo registrado: <strong class="text-slate-600 dark:text-slate-300">{{ qualidade.maiorLatencia }}ms</strong></p>
        </div>

        <!-- Card 2: Taxa de Sucesso das Comunicações -->
        <div class="p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Taxa de Sucesso</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                    Estável
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-emerald-500">{{ qualidade.taxaSucesso }}%</span>
                <span class="text-sm font-bold text-slate-400">respostas 200 OK</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-emerald-500 h-full rounded-full" style="width: {{ qualidade.taxaSucesso }}%"></div>
            </div>
            <p class="text-[11px] text-slate-400">Baseado nas últimas <strong class="text-slate-600 dark:text-slate-300">{{ qualidade.totalAmostras }} chamadas</strong> à API.</p>
        </div>

        <!-- Card 3: Volume de Dados Recebidos Hoje -->
        <div class="p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Volume Recebido Hoje</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-indigo-500/10 text-indigo-500 border border-indigo-500/20">
                    Procordis Real
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-indigo-500" id="dash-volume-hoje">{{ stats.agendamentosHoje }}</span>
                <span class="text-sm font-bold text-slate-400">agendamentos</span>
            </div>
            <div class="flex items-center gap-3 text-[11px] text-slate-400 pt-1">
                <span>Pacientes: <strong class="text-slate-600 dark:text-slate-200">{{ stats.totalPacientes }}</strong></span>
                <span>&bull;</span>
                <span>Médicos: <strong class="text-slate-600 dark:text-slate-200">{{ stats.totalMedicos }}</strong></span>
            </div>
            <p class="text-[11px] text-slate-400">Último pacote recebido: <strong class="text-cyan-600 dark:text-cyan-400" id="dash-ultimo-lote">{{ infoSync.totalRegistrosRecebidos }} registros</strong></p>
        </div>

        <!-- Card 4: Status da Conexão & Modo -->
        <div class="p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Modo de Operação</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider {{ infoSync.statusConexao == 'conectado' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-500 border border-rose-500/20' }}">
                    {{ infoSync.statusConexao|capitalize }}
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-cyan-500">Produção Real</span>
            </div>
            <div class="text-[11px] text-slate-400 space-y-1">
                <p>Fonte: <strong class="text-slate-600 dark:text-slate-300">Medware Clínica Procordis</strong></p>
                <p>Auto-sync: <strong class="text-emerald-500 font-bold">Ativo a cada 10s</strong></p>
            </div>
            <p class="text-[10px] text-slate-500">Dados protegidos com mascaramento LGPD.</p>
        </div>
    </div>

    <!-- Seção Explicativa: Como Funcionam as Variáveis e Tempos de Sincronismo -->
    <div class="p-6 lg:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-3 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-500 text-2xl">
                    <sl-icon name="sliders"></sl-icon>
                </div>
                <div>
                    <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">Variáveis e Intervalos de Sincronismo</h3>
                    <p class="text-xs text-slate-400">Entenda como a esteira de atualização de dados opera entre o Medware, o servidor Symfony e os painéis visuais.</p>
                </div>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                Arquitetura Dual-Layer
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {% for v in variaveisSincronismo %}
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800/80 space-y-3 hover:shadow-md transition">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <h4 class="font-bold text-sm text-slate-900 dark:text-white">{{ v.nome }}</h4>
                        <code class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 block mt-0.5">{{ v.chave }}</code>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-{{ v.corBadge }}-500/10 text-{{ v.corBadge }}-500 border border-{{ v.corBadge }}-500/20 flex-shrink-0">
                        {{ v.badge }}
                    </span>
                </div>

                <div class="flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800/60">
                    <span class="text-xs text-slate-400 font-medium">Intervalo de Refresh:</span>
                    <span class="text-sm font-black font-mono text-cyan-600 dark:text-cyan-400">{{ v.intervalo }}</span>
                </div>

                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{{ v.descricao }}</p>

                <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800/60 text-[11px] text-slate-400">
                    <strong class="text-slate-500 dark:text-slate-400">Impacto:</strong> {{ v.impacto }}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Resumo dos Atendimentos de Hoje na Clínica -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <sl-icon name="calendar-check" class="text-2xl text-emerald-500"></sl-icon>
                <div>
                    <h3 class="font-bold text-lg text-slate-900 dark:text-white">Status dos Agendamentos de Hoje</h3>
                    <p class="text-xs text-slate-400">Distribuição dos pacientes da Procordis pelas etapas de atendimento.</p>
                </div>
            </div>
            <span class="text-xs font-bold text-cyan-500">Data: {{ "now"|date("d/m/Y") }}</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center">
                <span class="text-[10px] uppercase font-bold text-slate-400">Agendados</span>
                <p class="text-2xl font-black text-slate-700 dark:text-slate-200 mt-1">{{ metricasHoje.agendado }}</p>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center">
                <span class="text-[10px] uppercase font-bold text-amber-500">Aguardando Triagem</span>
                <p class="text-2xl font-black text-amber-500 mt-1">{{ metricasHoje.aguardando_triagem }}</p>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center">
                <span class="text-[10px] uppercase font-bold text-cyan-500">Aguardando Médico</span>
                <p class="text-2xl font-black text-cyan-500 mt-1">{{ metricasHoje.aguardando_medico }}</p>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center">
                <span class="text-[10px] uppercase font-bold text-indigo-500">Em Atendimento</span>
                <p class="text-2xl font-black text-indigo-500 mt-1">{{ metricasHoje.em_consulta + metricasHoje.em_exame + metricasHoje.em_triagem }}</p>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center">
                <span class="text-[10px] uppercase font-bold text-emerald-500">Finalizados</span>
                <p class="text-2xl font-black text-emerald-500 mt-1">{{ metricasHoje.finalizado }}</p>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center">
                <span class="text-[10px] uppercase font-bold text-rose-500">Cancelados</span>
                <p class="text-2xl font-black text-rose-500 mt-1">{{ metricasHoje.cancelado }}</p>
            </div>
        </div>
    </div>

    <!-- Tabela de Histórico Recente de Comunicações da API -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <sl-icon name="journal-text" class="text-2xl text-cyan-500"></sl-icon>
                <div>
                    <h3 class="font-bold text-lg text-slate-900 dark:text-white">Últimas Requisições e Transações com a API Medware</h3>
                    <p class="text-xs text-slate-400">Auditoria das últimas chamadas efetuadas pelo backend para monitoramento de latência e integridade.</p>
                </div>
            </div>
            <a href="{{ path('app_admin_testes_index') }}" class="text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:underline">
                Ver Diagnóstico Detalhado &rarr;
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full text-left text-xs">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                        <th class="py-3 px-3">Data / Hora</th>
                        <th class="py-3 px-3">Endpoint Medware</th>
                        <th class="py-3 px-3">Método</th>
                        <th class="py-3 px-3">Status HTTP</th>
                        <th class="py-3 px-3">Tempo de Resposta</th>
                        <th class="py-3 px-3">Registros Recebidos</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono">
                    {% for log in ultimosLogs %}
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                        <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">{{ log.dataHora ? log.dataHora|date('d/m/Y H:i:s') : '---' }}</td>
                        <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200">{{ log.endpoint }}</td>
                        <td class="py-2.5 px-3">
                            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold {{ log.metodo == 'POST' ? 'bg-indigo-500/10 text-indigo-500' : 'bg-cyan-500/10 text-cyan-500' }}">
                                {{ log.metodo }}
                            </span>
                        </td>
                        <td class="py-2.5 px-3">
                            {% if log.httpStatus == 200 %}
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">200 OK</span>
                            {% else %}
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20">{{ log.httpStatus ?? 'ERR' }}</span>
                            {% endif %}
                        </td>
                        <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300">{{ log.tempoRespostaMs }} ms</td>
                        <td class="py-2.5 px-3 font-bold text-cyan-600 dark:text-cyan-400">{{ log.registrosProcessados }} itens</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="py-6 text-center text-slate-400">Nenhum log registrado até o momento.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
async function executarSyncDashboard() {
    const btn = document.getElementById('btn-sync-dash');
    const icon = document.getElementById('icon-sync-dash');
    btn.loading = true;

    try {
        const resp = await fetch('{{ path("app_admin_testes_sincronizar") }}', { method: 'POST' });
        const res = await resp.json();
        if (res.sucesso) {
            window.location.reload();
        } else {
            alert('Erro na sincronização: ' + (res.resultado.erro || 'Falha na resposta.'));
        }
    } catch (e) {
        alert('Erro ao conectar: ' + e.message);
    } finally {
        btn.loading = false;
    }
}
</script>
{% endblock %}
