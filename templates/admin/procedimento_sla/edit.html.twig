{% extends 'admin/base.html.twig' %}

{% block title %}Editar Regra de SLA{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <sl-card class="w-full">
        <div slot="header" class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <sl-icon name="pencil-square" class="text-3xl text-cyan-500"></sl-icon>
                <div>
                    <h2 class="text-xl font-bold dark:text-white">Editar Regra de SLA: {{ sla.nomeProcedimento }}</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Atualizar limites de tolerância de tempo (Verde, Amarelo e Vermelho)</p>
                </div>
            </div>

            <sl-button variant="neutral" size="small" href="{{ path('app_admin_sla_index') }}">
                Voltar à Lista
            </sl-button>
        </div>

        {{ include('admin/procedimento_sla/_form.html.twig', {'button_label': 'Atualizar Regra SLA'}) }}
    </sl-card>
</div>
{% endblock %}
