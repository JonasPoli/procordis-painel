{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.codigo, null, {'label_attr': {'class': 'block text-xs font-bold uppercase text-slate-500 mb-1'}}) }}
            {{ form_widget(form.codigo, {'attr': {'class': 'w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-sm outline-none focus:border-cyan-500'}}) }}
            {{ form_errors(form.codigo) }}
        </div>

        <div>
            {{ form_label(form.nomeProcedimento, null, {'label_attr': {'class': 'block text-xs font-bold uppercase text-slate-500 mb-1'}}) }}
            {{ form_widget(form.nomeProcedimento, {'attr': {'class': 'w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-sm outline-none focus:border-cyan-500'}}) }}
            {{ form_errors(form.nomeProcedimento) }}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800">
        <div>
            {{ form_label(form.limiteVerdeMinutos, null, {'label_attr': {'class': 'block text-xs font-bold uppercase text-emerald-600 dark:text-emerald-400 mb-1'}}) }}
            {{ form_widget(form.limiteVerdeMinutos, {'attr': {'class': 'w-full px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-400 font-mono font-bold text-sm outline-none focus:ring-2 focus:ring-emerald-500'}}) }}
            <p class="text-[11px] text-slate-400 mt-1">🟢 <strong>Abaixo ou igual a este número:</strong> Status <strong>Verde</strong> (Aceitável)</p>
            {{ form_errors(form.limiteVerdeMinutos) }}
        </div>

        <div>
            {{ form_label(form.limiteAmareloMinutos, null, {'label_attr': {'class': 'block text-xs font-bold uppercase text-amber-600 dark:text-amber-400 mb-1'}}) }}
            {{ form_widget(form.limiteAmareloMinutos, {'attr': {'class': 'w-full px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-amber-300 dark:border-amber-800 text-amber-800 dark:text-amber-400 font-mono font-bold text-sm outline-none focus:ring-2 focus:ring-amber-500'}}) }}
            <p class="text-[11px] text-slate-400 mt-1">🟡 <strong>Entre o Limite 1 e este número:</strong> Status <strong>Amarelo</strong> (Atenção)<br>🔴 <strong>Acima deste número:</strong> Status <strong>Vermelho</strong> (Crítico)</p>
            {{ form_errors(form.limiteAmareloMinutos) }}
        </div>
    </div>

    <div>
        {{ form_label(form.descricao, null, {'label_attr': {'class': 'block text-xs font-bold uppercase text-slate-500 mb-1'}}) }}
        {{ form_widget(form.descricao, {'attr': {'class': 'w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-sm outline-none focus:border-cyan-500'}}) }}
        {{ form_errors(form.descricao) }}
    </div>

    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
        <sl-button variant="neutral" href="{{ path('app_admin_sla_index') }}">Cancelar</sl-button>
        <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm px-5 py-2.5 rounded-lg transition active:scale-95 shadow">
            {{ button_label|default('Salvar Regra de SLA') }}
        </button>
    </div>
{{ form_end(form) }}
