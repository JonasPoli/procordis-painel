{#
    Panorama de um item da anamnese em folhas A4 (para imprimir ou salvar em PDF).
    Mesmo formato de relatorio.html.twig: página independente, assets/styles/relatorio-a4.css e gráficos em SVG.
    Cada <section class="folha"> é uma página; o conteúdo de cada uma é dimensionado para caber em 297 mm.
#}
{% import 'admin/anamnese/relatorio-graficos.html.twig' as g %}

{% set nome = p.item.nome %}
{% set temDados = p.com > 0 %}
{% set total = temDados ? 12 : 1 %}
{% set intervalo = filtros.inicio|date('d/m/Y') ~ ' a ' ~ filtros.fim|date('d/m/Y') %}
{% set periodos = {'30d': 'Últimos 30 dias', '6m': 'Últimos 6 meses', '12m': 'Últimos 12 meses', 'ano': 'Ano corrente', '24m': 'Últimos 24 meses', 'tudo': 'Todo o histórico', 'personalizado': 'Período personalizado'} %}

{% set recorte = [] %}
{% if filtros.sexo %}{% set recorte = recorte|merge(['Sexo: ' ~ filtros.sexo]) %}{% endif %}
{% if filtros.faixa %}{% set recorte = recorte|merge(['Faixa etária: ' ~ filtros.faixa ~ ' anos']) %}{% endif %}
{% if filtros.tipo %}{% set recorte = recorte|merge(['Atendimento: ' ~ (tipos[filtros.tipo] ?? filtros.tipo)]) %}{% endif %}
{% if filtros.procedimento %}{% set recorte = recorte|merge(['Procedimento: ' ~ filtros.procedimento]) %}{% endif %}
{% if filtros.medico %}{% set recorte = recorte|merge(['Médico: ' ~ (medicos[filtros.medico] ?? filtros.medico)]) %}{% endif %}

{% macro cab(nome, intervalo) %}
    <header class="folha-cab">
        <span><b>Associação Procordis</b> · Anamnese — Panorama do item: {{ nome }}</span>
        <span>Período: {{ intervalo }}</span>
    </header>
{% endmacro %}

{% macro rodape(pagina, total, emitidoEm) %}
    <footer class="folha-rodape">
        <span>Emitido em {{ emitidoEm|date('d/m/Y') }} às {{ emitidoEm|date('H:i') }} · Dados agregados, sem identificação de pacientes</span>
        <span class="pagina">Página {{ pagina }} de {{ total }}</span>
    </footer>
{% endmacro %}

{# Número com casas decimais ou travessão quando não há valor #}
{% macro num(v, casas = 1, sufixo = '') -%}
    {{- v is null ? '—' : v|number_format(casas, ',', '.') ~ sufixo -}}
{%- endmacro %}

{# "12,3% (45)" ou travessão #}
{% macro parte(x) -%}
    {%- if x.pct is null -%}—{%- else -%}{{ x.pct|number_format(1, ',', '.') }}% ({{ x.n|number_format(0, ',', '.') }}){%- endif -%}
{%- endmacro %}

{# Antecedente por faixa etária, com x sem o item #}
{% macro estratificado(linhas, nome, compacta = false) %}
    <table class="tab{{ compacta ? ' compacta' }}">
        <thead><tr><th>Faixa etária</th><th class="num">Com {{ nome }}: pacientes</th><th class="num">Com: %</th><th class="num">Sem: pacientes</th><th class="num">Sem: %</th><th class="num">Diferença</th></tr></thead>
        <tbody>
            {% for r in linhas %}
                <tr>
                    <td>{{ r.faixa }} anos</td>
                    <td class="num">{{ r.comN|number_format(0, ',', '.') }}{{ r.comPct is null and r.comN > 0 ? '*' }}</td>
                    <td class="num forte">{{ r.comPct is null ? '—' : r.comPct|number_format(1, ',', '.') ~ '%' }} ({{ r.comK }})</td>
                    <td class="num">{{ r.semN|number_format(0, ',', '.') }}{{ r.semPct is null and r.semN > 0 ? '*' }}</td>
                    <td class="num">{{ r.semPct is null ? '—' : r.semPct|number_format(1, ',', '.') ~ '%' }} ({{ r.semK }})</td>
                    <td class="num">{% if r.diferenca is null %}—{% else %}{{ r.diferenca > 0 ? '+' }}{{ r.diferenca|number_format(1, ',', '.') }} p.p.{% endif %}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{# Tabela "grupo | com o item / pacientes | %" #}
{% macro grupos(coluna, linhas, limite, comBarra = true) %}
    {% import 'admin/anamnese/relatorio-graficos.html.twig' as g %}
    {% if linhas|length %}
        <table class="tab fixa">
            <colgroup><col><col style="width: {{ comBarra ? 40 : 22 }}mm"><col style="width: 14mm">{% if comBarra %}<col style="width: 36mm">{% endif %}</colgroup>
            <thead><tr><th>{{ coluna }}</th><th class="num">{{ comBarra ? 'Com o item / pacientes' : 'Com / pacientes' }}</th><th class="num">%</th>{% if comBarra %}<th class="barra"></th>{% endif %}</tr></thead>
            <tbody>
                {% for r in linhas|slice(0, limite) %}
                    <tr>
                        <td>{{ r.nome }}{{ r.pequena ? '*' }}</td>
                        <td class="num">{{ r.n|number_format(0, ',', '.') }} / {{ r.total|number_format(0, ',', '.') }}</td>
                        <td class="num forte">{{ r.pct|number_format(1, ',', '.') }}%</td>
                        {% if comBarra %}<td class="barra">{{ g.fita(r.pct) }}</td>{% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="vazio">Sem dados no recorte.</p>
    {% endif %}
{% endmacro %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Anamnese — {{ nome }} — {{ filtros.inicio|date('d-m-Y') }} a {{ filtros.fim|date('d-m-Y') }}</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo-A3qBa0m.svg">
    <link rel="stylesheet" href="{{ asset('styles/relatorio-a4.css') }}">
</head>
<body>

<nav class="barra-acoes" aria-label="Ações do relatório">
    <a href="{{ path('app_admin_anamnese_item', app.request ? app.request.query.all : {}) }}">← Voltar ao panorama</a>
    <button type="button" class="principal" onclick="window.print()">Imprimir / Salvar em PDF</button>
    <span class="dica">Formato A4 retrato · {{ total }} {{ total == 1 ? 'página' : 'páginas' }} · na impressão, mantenha a escala em 100%</span>
</nav>

{# ======================================================================================
   Folha 1 — identificação e síntese
   ====================================================================================== #}
<section class="folha">
    <div class="folha-corpo">
        <div class="timbre">
            <img src="/images/logo-A3qBa0m.svg" alt="Procordis">
            <div class="orgao"><b>Associação Procordis</b>Painel de Gestão · Anamnese</div>
        </div>

        <p class="rotulo-doc">Panorama de item da anamnese</p>
        <h1>{{ nome }}</h1>
        <p class="subtitulo-doc">{{ p.item.categoriaRotulo }} — estatísticas agregadas do item, comparando os pacientes que o têm registrado com os que não têm.</p>

        <dl class="ficha">
            <dt>Período analisado</dt>
            <dd class="larga">{{ intervalo }} <span>({{ periodos[filtros.periodo] ?? filtros.periodo }})</span></dd>

            <dt>Recorte aplicado</dt>
            <dd class="larga">{{ recorte|length ? recorte|join(' · ') : 'Nenhum (todos os pacientes com anamnese no período)' }}</dd>

            <dt>Fonte dos dados</dt>
            <dd class="larga">Classificações de estudo dos exames e agendamentos atendidos (API Procordis)</dd>

            <dt>Última sincronização</dt>
            <dd class="larga">{% if ultimaExecucao %}{{ ultimaExecucao.iniciadoEm|date('d/m/Y H:i') }} <span>({{ ultimaExecucao.modo }}, {{ ultimaExecucao.status }})</span>{% else %}Nenhuma execução registrada{% endif %}</dd>

            <dt>Data de emissão</dt>
            <dd>{{ emitidoEm|date('d/m/Y H:i') }}</dd>
            <dt>Emitido por</dt>
            <dd>{{ app.user ? app.user.userIdentifier : '—' }}</dd>
        </dl>

        {% if modoSimulacao %}
            <p class="aviso">DADOS SIMULADOS — a integração está em modo simulação. Este documento não tem valor estatístico.</p>
        {% endif %}

        <h2><span class="num">1</span> Síntese</h2>
        {% if not temDados %}
            <p class="vazio">Nenhum paciente com “{{ nome }}” registrado neste período e recorte.</p>
        {% else %}
            {% set a = p.perfilCom %}
            {% set b = p.perfilSem %}
            <div class="indicadores">
                <div><p class="rotulo">Pacientes com o item</p><p class="valor">{{ p.com|number_format(0, ',', '.') }}</p><p class="obs">{{ p.prevalencia|number_format(1, ',', '.') }}% dos {{ p.pacientes|number_format(0, ',', '.') }} pacientes com anamnese</p></div>
                <div><p class="rotulo">Posição entre os itens</p><p class="valor">{{ p.posicao }}º</p><p class="obs">de {{ p.totalItens }} itens registrados no recorte</p></div>
                <div><p class="rotulo">Exames com o item</p><p class="valor">{{ p.examesCom|number_format(0, ',', '.') }}</p><p class="obs">{{ p.pctExames|number_format(1, ',', '.') }}% dos {{ p.exames|number_format(0, ',', '.') }} exames com anamnese</p></div>
                <div><p class="rotulo">Idade mediana</p><p class="valor">{{ _self.num(a.idadeMediana, 0) }} anos</p><p class="obs">sem o item: {{ _self.num(b.idadeMediana, 0) }} anos</p></div>
                <div><p class="rotulo">Outras comorbidades</p><p class="valor">{{ _self.num(a.outrasMedia, 2) }}</p><p class="obs">média por paciente · sem o item: {{ _self.num(b.outrasMedia, 2) }}</p></div>
                <div><p class="rotulo">Novos registros</p><p class="valor">{{ p.novos|number_format(0, ',', '.') }}</p><p class="obs">vezes em que o item surgiu entre exames do mesmo paciente</p></div>
            </div>

            <p>
                No período de {{ intervalo }}, <strong>{{ p.com|number_format(0, ',', '.') }} pacientes</strong> tiveram <strong>{{ nome }}</strong>
                registrado na anamnese, o que corresponde a {{ p.prevalencia|number_format(1, ',', '.') }}% dos {{ p.pacientes|number_format(0, ',', '.') }}
                pacientes com anamnese. O item foi marcado em {{ p.examesCom|number_format(0, ',', '.') }} exames.
                {% if a.idadeMediana is not null %}A idade mediana desses pacientes é de {{ _self.num(a.idadeMediana, 0) }} anos{% if a.pctFeminino is not null %}, e {{ _self.num(a.pctFeminino, 1, '%') }} são do sexo feminino{% endif %}.{% endif %}
                Além deste item, eles têm em média {{ _self.num(a.outrasMedia, 2) }} outras comorbidades registradas
                (contra {{ _self.num(b.outrasMedia, 2) }} entre os pacientes sem o item).
            </p>
            {% if p.semelhantes|length %}
                <p class="nota intro">Atenção: o catálogo tem item com nome parecido, e a contagem pode estar dividida entre eles —
                    {% for s in p.semelhantes %}{{ s.nome }} ({{ s.n|number_format(0, ',', '.') }} pacientes){{ not loop.last ? ', ' }}{% endfor %}. Os itens não são somados.</p>
            {% endif %}

        {% endif %}
    </div>
    {{ _self.rodape(1, total, emitidoEm) }}
</section>

{% if temDados %}

{# ======================================================================================
   Folha 2 — quem tem e quem não tem o item
   ====================================================================================== #}
{% set a = p.perfilCom %}
{% set b = p.perfilSem %}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">2</span> Quem tem e quem não tem o item</h2>
        <figure>
            <figcaption><b>Tabela 1</b> — Pacientes com e sem o item</figcaption>
            <table class="tab">
                <thead><tr><th>Indicador</th><th class="num">Com {{ nome }}</th><th class="num">Sem</th></tr></thead>
                <tbody>
                    <tr><td>Pacientes</td><td class="num forte">{{ a.n|number_format(0, ',', '.') }}</td><td class="num">{{ b.n|number_format(0, ',', '.') }}</td></tr>
                    <tr><td>Idade média (anos)</td><td class="num forte">{{ _self.num(a.idadeMedia, 1) }}</td><td class="num">{{ _self.num(b.idadeMedia, 1) }}</td></tr>
                    <tr><td>Idade mediana (anos)</td><td class="num forte">{{ _self.num(a.idadeMediana, 0) }}</td><td class="num">{{ _self.num(b.idadeMediana, 0) }}</td></tr>
                    <tr><td>Com 60 anos ou mais</td><td class="num forte">{{ _self.num(a.pct60, 1, '%') }}</td><td class="num">{{ _self.num(b.pct60, 1, '%') }}</td></tr>
                    <tr><td>Sexo feminino</td><td class="num forte">{{ _self.num(a.pctFeminino, 1, '%') }}</td><td class="num">{{ _self.num(b.pctFeminino, 1, '%') }}</td></tr>
                    <tr><td>Outras comorbidades (média)</td><td class="num forte">{{ _self.num(a.outrasMedia, 2) }}</td><td class="num">{{ _self.num(b.outrasMedia, 2) }}</td></tr>
                    <tr><td>Com 2 ou mais outras comorbidades</td><td class="num forte">{{ _self.num(a.pct2Outras, 1, '%') }}</td><td class="num">{{ _self.num(b.pct2Outras, 1, '%') }}</td></tr>
                    <tr><td>{{ p.ehHistorico ? 'Histórico cardiovascular (inclui este item)' : 'Com histórico cardiovascular registrado' }}</td><td class="num forte">{{ _self.num(a.pctEvento, 1, '%') }}</td><td class="num">{{ _self.num(b.pctEvento, 1, '%') }}</td></tr>
                    <tr><td>Exames com anamnese por paciente</td><td class="num forte">{{ _self.num(a.examesPorPaciente, 2) }}</td><td class="num">{{ _self.num(b.examesPorPaciente, 2) }}</td></tr>
                </tbody>
            </table>
            <p class="nota">Cada paciente conta uma vez (itens = tudo o que foi marcado nos exames do período; sexo e idade do exame mais recente). Histórico cardiovascular = infarto, AVC, cateterismo ou angioplastia. As diferenças descrevem os registros e não indicam causa; a ausência de marcação não prova a ausência da condição.</p>
        </figure>
        <figure>
            <figcaption><b>Figura 1</b> — Outras comorbidades dos pacientes com e sem {{ nome }}</figcaption>
            {{ g.legenda([{classe: 'f-s1', rotulo: 'Com ' ~ nome, extra: '(n = ' ~ p.com|number_format(0, ',', '.') ~ ')'}, {classe: 'f-neutro', rotulo: 'Sem', extra: '(n = ' ~ p.sem|number_format(0, ',', '.') ~ ')'}]) }}
            {{ g.barras_agrupadas(p.outras.rotulos|map((r, i) => {nome: r == 'Nenhuma' ? 'Nenhuma outra comorbidade' : r ~ (r == '1' ? ' outra' : ' outras'), valores: [p.outras.com.pct[i], p.outras.sem.pct[i]]}), ['Com o item', 'Sem o item'], ['f-s1', 'f-neutro'], 'Outras comorbidades com e sem o item', 160) }}
            <p class="nota">Comorbidades registradas além deste item; cada grupo soma 100%.</p>
        </figure>
    </div>
    {{ _self.rodape(2, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 3 — perfil demográfico e evolução mensal
   ====================================================================================== #}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">3</span> Perfil demográfico</h2>
        <figure>
            <figcaption><b>Figura 2</b> — Prevalência de {{ nome }} por faixa etária e sexo</figcaption>
            {% set itensLegenda = [] %}
            {% for s in p.porSexo|filter(s => s.nome != 'Não informado') %}
                {% set itensLegenda = itensLegenda|merge([{classe: 'f-' ~ (s.nome == 'Feminino' ? 's1' : 's2'), rotulo: s.nome, extra: '(' ~ s.pct|number_format(1, ',', '.') ~ '% · ' ~ s.n|number_format(0, ',', '.') ~ ' de ' ~ s.total|number_format(0, ',', '.') ~ ' pacientes)'}]) %}
            {% endfor %}
            {{ g.legenda(itensLegenda) }}
            {{ g.barras_agrupadas(p.porFaixa|map(f => {nome: f.faixa ~ ' anos (' ~ f.geral.n ~ ' de ' ~ f.geral.total ~ ')', valores: [f.Feminino.pct, f.Masculino.pct]}), ['Feminino', 'Masculino'], ['f-s1', 'f-s2'], 'Prevalência do item por faixa etária e sexo', 160) }}
            <p class="nota">Pacientes do grupo com o item ÷ pacientes do grupo. Ao lado de cada faixa, pacientes com o item e total da faixa. Grupos com menos de {{ p.minGrupo }} pacientes ficam sem percentual (—).</p>
        </figure>
        <figure>
            <figcaption><b>Figura 3</b> — Pacientes com {{ nome }}, por sexo e faixa etária</figcaption>
            {{ g.piramide(p.piramide.faixas, p.piramide.Feminino, p.piramide.Masculino, 'Pacientes com o item por sexo e faixa etária') }}
        </figure>

        <h2><span class="num">4</span> Evolução no período</h2>
        <figure>
            <figcaption><b>Figura 4</b> — Prevalência mensal de {{ nome }}</figcaption>
            {{ g.linhas(p.mensal.meses, [{nome: nome, valores: p.mensal.pct}], ['s1'], 'Prevalência mensal do item', 150) }}
            <p class="nota">Percentual dos pacientes atendidos no mês com o item marcado. Meses com menos de {{ p.minMes }} pacientes não são medidos; a linha liga os meses vizinhos.</p>
        </figure>
    </div>
    {{ _self.rodape(3, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 4 — novos registros e itens associados
   ====================================================================================== #}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <figure>
            <figcaption><b>Figura 5</b> — Novos registros de {{ nome }} por mês</figcaption>
            {{ g.colunas(p.mensal.meses, p.mensal.novos, 'Novos registros do item por mês', p.mensal.meses|length <= 14 ? p.mensal.novos : null, null, '', 130) }}
            <p class="nota">Vezes em que o item foi marcado pela primeira vez em paciente que já tinha anamnese anterior sem ele.</p>
        </figure>

        <h2><span class="num">5</span> Itens associados</h2>
        <figure>
            <figcaption><b>Tabela 2</b> — Itens que mais aparecem junto com {{ nome }}</figcaption>
            {% if p.associados|length %}
                <table class="tab fixa">
                    <colgroup><col><col style="width: 36mm"><col style="width: 30mm"><col style="width: 30mm"><col style="width: 24mm"></colgroup>
                    <thead><tr><th>Item</th><th>Categoria</th><th class="num">Entre quem tem</th><th class="num">Entre quem não tem</th><th class="num">Diferença</th></tr></thead>
                    <tbody>
                        {% for it in p.associados|slice(0, 12) %}
                            <tr>
                                <td>{{ it.nome }}</td>
                                <td class="cat">{{ it.categoria }}</td>
                                <td class="num"><b>{{ it.pctCom|number_format(1, ',', '.') }}%</b> ({{ it.nCom|number_format(0, ',', '.') }})</td>
                                <td class="num">{{ _self.num(it.pctSem, 1, '%') }} ({{ it.nSem|number_format(0, ',', '.') }})</td>
                                <td class="num forte">{% if it.diferenca is null %}—{% else %}{{ it.diferenca > 0 ? '+' }}{{ it.diferenca|number_format(1, ',', '.') }} p.p.{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="nota">Percentual dos pacientes com {{ nome }} que também têm o item, ao lado do percentual entre quem não tem; entre parênteses, o número de pacientes; diferença em pontos percentuais. Associação não indica causa. Vacinas ficam de fora.</p>
            {% else %}
                <p class="vazio">Nenhum outro item registrado nesses pacientes.</p>
            {% endif %}
        </figure>
    </div>
    {{ _self.rodape(4, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 5 — combinações, perfis e consistência do registro
   ====================================================================================== #}
{% set k = p.consistencia %}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <figure>
            <figcaption><b>Tabela 3</b> — Combinações mais frequentes de outras comorbidades</figcaption>
            {% set maxComb = (p.combinacoes|first).n %}
            <table class="tab fixa">
                <colgroup><col style="width: 8mm"><col><col style="width: 18mm"><col style="width: 16mm"><col style="width: 28mm"></colgroup>
                <thead><tr><th class="ordem num">Nº</th><th>Outras comorbidades do paciente</th><th class="num">Pacientes</th><th class="num">%</th><th class="barra"></th></tr></thead>
                <tbody>
                    {% for cb in p.combinacoes %}
                        <tr>
                            <td class="ordem num">{{ loop.index }}</td>
                            <td>{{ cb.itens|length ? cb.itens|join(' + ') : 'Nenhuma outra comorbidade' }}</td>
                            <td class="num">{{ cb.n|number_format(0, ',', '.') }}</td>
                            <td class="num forte">{{ cb.pct|number_format(1, ',', '.') }}%</td>
                            <td class="barra">{{ g.fita(cb.n / maxComb * 100) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Conjuntos exatos das outras comorbidades dos pacientes com {{ nome }}; percentual sobre esses pacientes.</p>
        </figure>
        <figure>
            <figcaption><b>Tabela 4</b> — Perfis clínicos dos pacientes com {{ nome }}</figcaption>
            <table class="tab fixa">
                <colgroup><col><col style="width: 22mm"><col style="width: 18mm"><col style="width: 40mm"></colgroup>
                <thead><tr><th>Perfil</th><th class="num">Pacientes</th><th class="num">%</th><th class="barra"></th></tr></thead>
                <tbody>
                    {% for pf in p.perfis %}
                        <tr><td>{{ pf.nome }}</td><td class="num">{{ pf.n|number_format(0, ',', '.') }}</td><td class="num forte">{{ pf.pct|number_format(1, ',', '.') }}%</td><td class="barra">{{ g.fita(pf.pct) }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Perfis interpretativos e mutuamente exclusivos (vale o primeiro critério atendido, na ordem da tabela). Não substituem diagnóstico médico.</p>
        </figure>

        <h2><span class="num">6</span> Consistência do registro entre anamneses</h2>
        {% if k.acompanhados == 0 %}
            <p class="vazio">Nenhum paciente com o item e anamnese em mais de um dia no período.</p>
        {% else %}
            <div class="indicadores">
                <div><p class="rotulo">Marcado em todas as anamneses</p><p class="valor">{{ k.pctEmTodas|number_format(1, ',', '.') }}%</p><p class="obs">{{ k.emTodas|number_format(0, ',', '.') }} de {{ k.acompanhados|number_format(0, ',', '.') }} pacientes acompanhados</p></div>
                <div><p class="rotulo">Surgiu depois da primeira</p><p class="valor">{{ k.pctApareceuDepois|number_format(1, ',', '.') }}%</p><p class="obs">{{ k.apareceuDepois|number_format(0, ',', '.') }} pacientes{% if k.diasAteAparecer is not null %} · mediana de {{ _self.num(k.diasAteAparecer, 0) }} dias{% endif %}</p></div>
                <div><p class="rotulo">Não repetido depois</p><p class="valor">{{ k.pctNaoRepetido|number_format(1, ',', '.') }}%</p><p class="obs">{{ k.naoRepetido|number_format(0, ',', '.') }} pacientes · não indica cura</p></div>
            </div>
            <p class="nota">Entre os pacientes com o item e anamnese em dois ou mais dias do período (anamneses do mesmo dia contam como um só momento). Um item que deixa de ser marcado não é interpretado como cura: costuma refletir o preenchimento.</p>
        {% endif %}
    </div>
    {{ _self.rodape(5, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 6 — onde o item aparece
   ====================================================================================== #}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">7</span> Onde o item aparece</h2>
        <figure>
            <figcaption><b>Tabela 5</b> — Prevalência de {{ nome }} por procedimento</figcaption>
            {{ _self.grupos('Procedimento', p.porProcedimento, 10) }}
        </figure>
        <div class="duas-colunas">
            <figure>
                <figcaption><b>Tabela 6</b> — Por tipo de atendimento</figcaption>
                {{ _self.grupos('Atendimento', p.porTipo, 6, false) }}
            </figure>
            <figure>
                <figcaption><b>Tabela 7</b> — Por médico</figcaption>
                {{ _self.grupos('Médico', p.porMedico, 10, false) }}
            </figure>
        </div>
        <p class="nota">Pacientes do grupo com o item ÷ pacientes do grupo; o paciente conta uma vez em cada procedimento, tipo de atendimento e médico em que foi atendido. São listados os grupos com mais pacientes. Por médico, o percentual reflete o perfil dos pacientes e também o hábito de preenchimento. * menos de {{ p.minGrupo }} pacientes no grupo.</p>
    </div>
    {{ _self.rodape(6, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 7 — multimorbidade por faixa etária
   ====================================================================================== #}
{% set cv = p.cardio %}
{% set sg = p.subgrupo %}
{% set lg = p.longitudinal %}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">8</span> Multimorbidade por faixa etária</h2>
        <p class="nota intro">A partir desta seção, os blocos consideram só os pacientes com {{ nome }} registrado e descrevem registros de anamnese, não diagnósticos confirmados. Antecedentes cardiovasculares registrados = {{ cv.eventos|map(e => e.rotulo)|join(', ') }}{% if p.ehHistorico %} (o próprio item não entra nessa contagem){% endif %}.{% if cv.semItem|length %} Atenção: nenhum item do catálogo foi reconhecido para {{ cv.semItem|join(', ') }}; essas condições aparecem zeradas.{% endif %}</p>
        <figure>
            <figcaption><b>Figura 6</b> — Outras comorbidades dos pacientes com {{ nome }}, por faixa etária</figcaption>
            {{ g.calor(
                p.outras.rotulos|map(r => {nome: r == 'Nenhuma' ? 'Nenhuma outra' : r}),
                p.multiFaixa|map(f => {nome: f.faixa ~ (f.faixa != 'Sem idade' ? ' anos'), sub: '(n = ' ~ f.n ~ (f.pequena and f.n > 0 ? '*') ~ ')', celulas: f.celulas|map(cel => {v: f.n > 0 ? cel.pct : null, texto: f.n > 0 ? cel.n ~ ' · ' ~ cel.pct|number_format(0) ~ '%' : '—'})}),
                'Outras comorbidades →'
            ) }}
            <p class="nota">Cada célula: número de pacientes · percentual dentro da faixa etária (cada linha soma 100%). Conta comorbidades além de {{ nome }}.</p>
        </figure>
        <figure>
            <figcaption><b>Tabela 8</b> — Outras comorbidades por faixa etária</figcaption>
            <table class="tab">
                <thead><tr><th>Faixa etária</th><th class="num">Pacientes com {{ nome }}</th><th class="num">Média de outras</th><th class="num">Mediana</th><th class="num">Com 2 ou mais</th><th class="num">Com 4 ou mais</th></tr></thead>
                <tbody>
                    {% for f in p.multiFaixa %}
                        <tr>
                            <td>{{ f.faixa }}{{ f.faixa != 'Sem idade' ? ' anos' }}</td>
                            <td class="num">{{ f.n|number_format(0, ',', '.') }}{{ f.pequena and f.n > 0 ? '*' }}</td>
                            <td class="num forte">{{ _self.num(f.media, 2) }}</td>
                            <td class="num">{{ _self.num(f.mediana, 1) }}</td>
                            <td class="num">{{ _self.parte(f.dois) }}</td>
                            <td class="num">{{ _self.parte(f.quatro) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Faixa etária pela idade no exame mais recente do período. Entre parênteses, o número de pacientes. * faixa com menos de {{ p.minGrupo }} pacientes: leia com cautela.</p>
        </figure>
    </div>
    {{ _self.rodape(7, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 8 — carga cardiovascular registrada
   ====================================================================================== #}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">9</span> Carga cardiovascular registrada</h2>
        <figure>
            <figcaption><b>Figura 7</b> — Pacientes com {{ nome }} por número de antecedentes cardiovasculares registrados</figcaption>
            {{ g.colunas(cv.classes|map(cl => cl.rotulo), cv.classes|map(cl => cl.n), 'Pacientes por número de antecedentes cardiovasculares registrados', cv.classes|map(cl => cl.n|number_format(0, ',', '.') ~ ' (' ~ cl.pct|number_format(1, ',', '.') ~ '%)'), null, 'Antecedentes cardiovasculares registrados', 140) }}
        </figure>
        <figure>
            <figcaption><b>Tabela 9</b> — Perfil dos pacientes por carga cardiovascular registrada</figcaption>
            <table class="tab">
                <thead><tr><th>Carga cardiovascular</th><th class="num">Pacientes</th><th class="num">%</th><th class="num">Idade média</th><th class="num">Idade mediana</th><th class="num">Média de outras comorbidades</th></tr></thead>
                <tbody>
                    {% for cl in cv.classes %}
                        <tr>
                            <td>{{ cl.rotulo == 'Nenhum' ? 'Nenhum antecedente' : cl.rotulo ~ (cl.rotulo == '1' ? ' antecedente' : ' antecedentes') }}</td>
                            <td class="num">{{ cl.n|number_format(0, ',', '.') }}{{ cl.pequena and cl.n > 0 ? '*' }}</td>
                            <td class="num forte">{{ _self.num(cl.pct, 1, '%') }}</td>
                            <td class="num">{{ _self.num(cl.idadeMedia, 1) }}</td>
                            <td class="num">{{ _self.num(cl.idadeMediana, 0) }}</td>
                            <td class="num">{{ _self.num(cl.outrasMedia, 2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Contagem de registros, não medida de risco. {{ _self.parte(cv.comAlgum) }} dos pacientes com {{ nome }} têm ao menos um antecedente registrado. Outras comorbidades = além de {{ nome }}. * menos de {{ p.minGrupo }} pacientes.</p>
        </figure>
        <figure>
            <figcaption><b>Figura 8</b> — Prevalência de cada antecedente entre os pacientes com {{ nome }}</figcaption>
            {{ g.barras(cv.eventos|map(e => {nome: e.rotulo ~ ' (' ~ e.n ~ ' pacientes)', valor: e.pct, classe: 'f-s1', dica: e.rotulo}), 'Prevalência de cada antecedente cardiovascular') }}
            <p class="nota">Itens do catálogo considerados: {% for e in cv.eventos %}{{ e.rotulo }} = {{ e.itens|length ? e.itens|join(', ') : 'nenhum item encontrado' }}{{ not loop.last ? '; ' : '.' }}{% endfor %}</p>
        </figure>
    </div>
    {{ _self.rodape(8, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 9 — subgrupo com hipertensão e matriz de condições
   ====================================================================================== #}
{% set mz = p.matriz %}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">10</span> {{ nome }} associado à {{ sg.parceiro }}</h2>
        {% if not sg.disponivel %}
            <p class="vazio">Nenhum item do catálogo foi reconhecido como {{ sg.parceiro }}: não é possível formar os dois grupos.</p>
        {% else %}
            <figure>
                <figcaption><b>Tabela 10</b> — Pacientes com {{ nome }}, sem e com {{ sg.parceiro }} registrada</figcaption>
                <table class="tab">
                    <thead><tr><th>Indicador</th><th class="num">{{ nome }} sem {{ sg.parceiro }}</th><th class="num">{{ nome }} + {{ sg.parceiro }}</th></tr></thead>
                    <tbody>
                        <tr><td>Pacientes</td><td class="num">{{ sg.sem.n|number_format(0, ',', '.') }}{{ sg.sem.pequena ? '*' }}</td><td class="num forte">{{ sg.com.n|number_format(0, ',', '.') }}{{ sg.com.pequena ? '*' }}</td></tr>
                        <tr><td>% dos pacientes com {{ nome }}</td><td class="num">{{ _self.num(sg.sem.pct, 1, '%') }}</td><td class="num forte">{{ _self.num(sg.com.pct, 1, '%') }}</td></tr>
                        <tr><td>Idade média · mediana (anos)</td><td class="num">{{ _self.num(sg.sem.idadeMedia, 1) }} · {{ _self.num(sg.sem.idadeMediana, 0) }}</td><td class="num forte">{{ _self.num(sg.com.idadeMedia, 1) }} · {{ _self.num(sg.com.idadeMediana, 0) }}</td></tr>
                        <tr><td>Sexo feminino · masculino</td><td class="num">{{ _self.num(sg.sem.pctFeminino, 1, '%') }} · {{ _self.num(sg.sem.pctMasculino, 1, '%') }}</td><td class="num forte">{{ _self.num(sg.com.pctFeminino, 1, '%') }} · {{ _self.num(sg.com.pctMasculino, 1, '%') }}</td></tr>
                        <tr><td>Média de outras comorbidades</td><td class="num">{{ _self.num(sg.sem.outrasMedia, 2) }}</td><td class="num forte">{{ _self.num(sg.com.outrasMedia, 2) }}</td></tr>
                        {% for e in cv.eventos %}
                            <tr><td>{{ e.rotulo }}</td><td class="num">{{ _self.parte(sg.sem.eventos[e.chave]) }}</td><td class="num forte">{{ _self.parte(sg.com.eventos[e.chave]) }}</td></tr>
                        {% endfor %}
                        <tr><td>Algum antecedente cardiovascular</td><td class="num">{{ _self.parte(sg.sem.algum) }}</td><td class="num forte">{{ _self.parte(sg.com.algum) }}</td></tr>
                    </tbody>
                </table>
            </figure>
            <figure>
                <figcaption><b>Figura 9</b> — Antecedentes cardiovasculares sem e com {{ sg.parceiro }}</figcaption>
                {{ g.legenda([{classe: 'f-neutro', rotulo: 'Sem ' ~ sg.parceiro, extra: '(n = ' ~ sg.sem.n ~ ')'}, {classe: 'f-s1', rotulo: 'Com ' ~ sg.parceiro, extra: '(n = ' ~ sg.com.n ~ ')'}]) }}
                {{ g.barras_agrupadas(cv.eventos|map(e => {nome: e.rotulo, valores: [sg.sem.eventos[e.chave].pct, sg.com.eventos[e.chave].pct]})|merge([{nome: 'Algum antecedente', valores: [sg.sem.algum.pct, sg.com.algum.pct]}]), ['Sem ' ~ sg.parceiro, 'Com ' ~ sg.parceiro], ['f-neutro', 'f-s1'], 'Antecedentes cardiovasculares com e sem ' ~ sg.parceiro, 130) }}
                <p class="nota">Percentuais dentro de cada grupo; entre parênteses, o número de pacientes. Outras comorbidades = além de {{ nome }} e de {{ sg.parceiro }}. {{ sg.parceiro }} reconhecida pelos itens: {{ sg.itens|join(', ') }}. As diferenças não indicam relação causal. * grupo com menos de {{ p.minGrupo }} pacientes.</p>
            </figure>
        {% endif %}

        <h2><span class="num">11</span> Associação entre comorbidades nos pacientes com {{ nome }}</h2>
        <figure>
            <figcaption><b>Figura 10</b> — Matriz de condições registradas</figcaption>
            {{ g.calor(
                mz.itens|map((nomeCol, j) => {nome: nomeCol, sub: 'n = ' ~ mz.totais[j]}),
                mz.itens|map((nomeLinha, i) => {nome: nomeLinha, sub: '(n = ' ~ mz.totais[i] ~ (mz.totais[i] < p.minGrupo and mz.totais[i] > 0 ? '*') ~ ')', celulas: mz.itens|map((nomeCol, j) => {
                    v: mz.pct[i][j],
                    texto: i == j ? '—' : (mz.pct[i][j] is null ? (mz.totais[i] > 0 ? mz.n[i][j] ~ ' de ' ~ mz.totais[i] : '—') : mz.pct[i][j]|number_format(0) ~ '% (' ~ mz.n[i][j] ~ ')')
                })})
            ) }}
            <p class="nota">Linha = pacientes com {{ nome }} que têm a condição da linha (n); coluna = percentual deles que também têm a condição da coluna, com o número de pacientes entre parênteses. * linha com menos de {{ p.minGrupo }} pacientes: só a contagem. <b>Associação não significa causalidade.</b></p>
        </figure>
    </div>
    {{ _self.rodape(9, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 10 — histórico cardiovascular por faixa etária
   ====================================================================================== #}
{% set algum = p.estratificado|first %}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">12</span> Histórico cardiovascular por faixa etária — {{ nome }} × sem {{ nome }}</h2>
        <figure>
            <figcaption><b>Figura 11</b> — Pacientes com algum antecedente cardiovascular registrado, por faixa etária</figcaption>
            {{ g.legenda([{classe: 'f-s1', rotulo: 'Com ' ~ nome}, {classe: 'f-neutro', rotulo: 'Sem ' ~ nome}]) }}
            {{ g.barras_agrupadas(algum.linhas|map(r => {nome: r.faixa ~ ' anos', valores: [r.comPct, r.semPct]}), ['Com ' ~ nome, 'Sem ' ~ nome], ['f-s1', 'f-neutro'], 'Histórico cardiovascular por faixa etária, com e sem ' ~ nome, 90) }}
        </figure>
        <figure>
            <figcaption><b>Tabela 11</b> — Algum antecedente cardiovascular, por faixa etária</figcaption>
            {{ _self.estratificado(algum.linhas, nome) }}
        </figure>
        {% set individuais = p.estratificado|slice(1) %}
        <figure>
            <figcaption><b>Tabela 12</b> — Cada antecedente, por faixa etária (% com {{ nome }} · % sem {{ nome }})</figcaption>
            <table class="tab">
                <thead><tr><th>Faixa etária</th>{% for serie in individuais %}<th class="num">{{ serie.rotulo }}</th>{% endfor %}</tr></thead>
                <tbody>
                    {% for r in algum.linhas %}
                        {% set i = loop.index0 %}
                        <tr>
                            <td>{{ r.faixa }} anos</td>
                            {% for serie in individuais %}
                                {% set x = serie.linhas[i] %}
                                <td class="num"><b>{{ x.comPct is null ? '—' : x.comPct|number_format(1, ',', '.') ~ '%' }}</b> · {{ x.semPct is null ? '—' : x.semPct|number_format(1, ',', '.') ~ '%' }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Tabelas 11 e 12: percentual dos pacientes de cada grupo e faixa com o antecedente registrado; na Tabela 11, entre parênteses, o número de pacientes com o antecedente. Grupos com menos de {{ p.minGrupo }} pacientes ficam sem percentual (* ou —); os números absolutos de cada antecedente estão no CSV. A faixa de 0–17 anos não entra. Associação observada nos registros; não indica causalidade.</p>
        </figure>
    </div>
    {{ _self.rodape(10, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 11 — volume mensal e procedimentos
   ====================================================================================== #}
{% set v = p.volume %}
{% set ultimos = max(0, v.meses|length - 12) %}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">13</span> Volume mensal de pacientes com {{ nome }}</h2>
        <figure>
            <figcaption><b>Figura 12</b> — Pacientes com anamnese por mês, com e sem {{ nome }}</figcaption>
            {{ g.legenda([{classe: 'f-s1', rotulo: 'Com ' ~ nome}, {classe: 'f-neutro', rotulo: 'Demais pacientes com anamnese'}]) }}
            {{ g.colunas_pilha(v.meses, [{nome: 'Com ' ~ nome, valores: v.pacientesCom}, {nome: 'Demais', valores: v.pacientesTotal|map((t, i) => t - v.pacientesCom[i])}], ['f-s1', 'f-neutro'], 'Volume mensal de pacientes com e sem o item', 130) }}
        </figure>
        <figure>
            <figcaption><b>Tabela 13</b> — Volume mensal de pacientes e exames{% if ultimos > 0 %} (últimos 12 meses do período){% endif %}</figcaption>
            <table class="tab compacta">
                <thead><tr><th>Mês</th><th class="num">Pacientes com {{ nome }}</th><th class="num">Total de pacientes</th><th class="num">%</th><th class="num">Exames com {{ nome }}</th><th class="num">Total de exames</th></tr></thead>
                <tbody>
                    {% for mes in v.meses|slice(ultimos) %}
                        {% set i = ultimos + loop.index0 %}
                        <tr>
                            <td>{{ mes }}</td>
                            <td class="num forte">{{ v.pacientesCom[i]|number_format(0, ',', '.') }}</td>
                            <td class="num">{{ v.pacientesTotal[i]|number_format(0, ',', '.') }}</td>
                            <td class="num">{{ _self.num(v.pct[i], 1, '%') }}{{ v.pacientesTotal[i] > 0 and v.pacientesTotal[i] < p.minMes ? '*' }}</td>
                            <td class="num">{{ v.examesCom[i]|number_format(0, ',', '.') }}</td>
                            <td class="num">{{ v.examesTotal[i]|number_format(0, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Volume assistencial, não prevalência: paciente = pessoa atendida no mês (conta uma vez por mês); exame = cada agendamento com anamnese. Sobre cada coluna da figura, o total de pacientes do mês. * mês com menos de {{ p.minMes }} pacientes.</p>
        </figure>

        <h2><span class="num">14</span> Onde os pacientes com {{ nome }} são atendidos</h2>
        <figure>
            <figcaption><b>Tabela 14</b> — Pacientes com {{ nome }} por procedimento</figcaption>
            <table class="tab fixa compacta">
                <colgroup><col><col style="width: 40mm"><col style="width: 32mm"><col style="width: 16mm"><col style="width: 28mm"></colgroup>
                <thead><tr><th>Procedimento</th><th class="num">Pacientes com {{ nome }}</th><th class="num">% desses pacientes</th><th class="num">Exames</th><th class="barra"></th></tr></thead>
                <tbody>
                    {% for r in p.procedimentos|slice(0, 8) %}
                        <tr><td>{{ r.nome }}</td><td class="num">{{ r.n|number_format(0, ',', '.') }}</td><td class="num forte">{{ r.pct|number_format(1, ',', '.') }}%</td><td class="num">{{ r.exames|number_format(0, ',', '.') }}</td><td class="barra">{{ g.fita(r.pct) }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="nota">Só pacientes com {{ nome }}. Um mesmo paciente pode aparecer em mais de um procedimento: <b>os percentuais não precisam somar 100%</b>.</p>
        </figure>
    </div>
    {{ _self.rodape(11, total, emitidoEm) }}
</section>

{# ======================================================================================
   Folha 12 — acompanhamento longitudinal
   ====================================================================================== #}
<section class="folha">
    {{ _self.cab(nome, intervalo) }}
    <div class="folha-corpo">
        <h2><span class="num">15</span> Acompanhamento longitudinal dos pacientes com {{ nome }}</h2>
        <p class="nota intro">Pacientes com {{ nome }} e anamnese em dois ou mais momentos distintos do período. Anamneses do mesmo dia contam como um só momento; vacinas ficam de fora. “Apareceu posteriormente” não equivale a novo diagnóstico, e a redução de itens não é interpretada como cura ou melhora.</p>
        {% if lg.acompanhados == 0 %}
            <p class="vazio">Nenhum paciente com {{ nome }} e anamnese em mais de um dia no período.</p>
        {% else %}
            <div class="indicadores">
                <div><p class="rotulo">Pacientes acompanhados</p><p class="valor">{{ lg.acompanhados|number_format(0, ',', '.') }}</p><p class="obs">{{ (lg.acompanhados * 100 / p.com)|number_format(1, ',', '.') }}% dos pacientes com {{ nome }}</p></div>
                <div><p class="rotulo">Momentos por paciente</p><p class="valor">{{ _self.num(lg.momentosMedia, 2) }}</p><p class="obs">média · mediana de {{ _self.num(lg.momentosMediana, 1) }}</p></div>
                <div><p class="rotulo">Da primeira à última anamnese</p><p class="valor">{{ _self.num(lg.intervaloMedio, 0) }} dias</p><p class="obs">média · mediana de {{ _self.num(lg.intervaloMediano, 0) }} dias · maior: {{ lg.intervaloMaior }} dias</p></div>
            </div>
            <div class="duas-colunas">
                {% for bloco in [{n: 15, t: 'Momentos de anamnese por paciente', l: lg.distribuicao}, {n: 16, t: 'Comorbidades: primeira × última anamnese', l: lg.mudanca}] %}
                    <figure>
                        <figcaption><b>Tabela {{ bloco.n }}</b> — {{ bloco.t }}</figcaption>
                        <table class="tab">
                            <thead><tr><th>Situação</th><th class="num">Pacientes</th><th class="num">%</th></tr></thead>
                            <tbody>
                                {% for r in bloco.l %}<tr><td>{{ r.rotulo }}</td><td class="num">{{ r.n|number_format(0, ',', '.') }}</td><td class="num forte">{{ _self.num(r.pct, 1, '%') }}</td></tr>{% endfor %}
                            </tbody>
                        </table>
                    </figure>
                {% endfor %}
            </div>
            <figure>
                <figcaption><b>Tabela 17</b> — Novos registros após a primeira anamnese</figcaption>
                {% if lg.novos|length %}
                    <table class="tab fixa">
                        <colgroup><col><col style="width: 40mm"><col style="width: 22mm"><col style="width: 32mm"><col style="width: 30mm"></colgroup>
                        <thead><tr><th>Item</th><th>Categoria</th><th class="num">Pacientes</th><th class="num">% dos acompanhados</th><th class="num">Mediana de dias</th></tr></thead>
                        <tbody>
                            {% for it in lg.novos|slice(0, 12) %}
                                <tr><td>{{ it.nome }}{{ it.destaque ? ' †' }}</td><td class="cat">{{ it.categoria }}</td><td class="num">{{ it.n|number_format(0, ',', '.') }}</td><td class="num forte">{{ it.pct|number_format(1, ',', '.') }}%</td><td class="num">{{ _self.num(it.diasMediana, 0) }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <p class="nota">Pacientes em que o item apareceu depois da primeira anamnese, e mediana de dias até aparecer. † condição cardiovascular, listada primeiro; depois os demais itens por frequência.</p>
                {% else %}
                    <p class="vazio">Nenhum item apareceu depois da primeira anamnese nesses pacientes.</p>
                {% endif %}
            </figure>
        {% endif %}
    </div>
    {{ _self.rodape(12, total, emitidoEm) }}
</section>

{% endif %}

</body>
</html>
