{% extends 'admin/base.html.twig' %}

{% block title %}Atendimentos — Procedimentos{% endblock %}

{% set card = 'bg-white/80 dark:bg-slate-900/80 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm' %}

{% block body %}
<div class="space-y-6">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <sl-alert variant="{{ label == 'success' ? 'success' : 'warning' }}" open closable>
                <sl-icon slot="icon" name="{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }}"></sl-icon>
                {{ message }}
            </sl-alert>
        {% endfor %}
    {% endfor %}

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 {{ card }} p-5">
        <div>
            <div class="flex items-center gap-2">
                <sl-icon name="list-check" class="text-cyan-500 text-2xl"></sl-icon>
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Procedimentos e tipos de atendimento</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Cada procedimento da Medware entra no gráfico pelo tipo escolhido aqui. Novos procedimentos são classificados automaticamente pela descrição;
                ao trocar o tipo ele passa a ser <b>manual</b> e a sincronização não altera mais. "Automático" devolve à regra.
            </p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_admin_atendimentos_categorias') }}" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-xl text-xs flex items-center gap-2 transition"><sl-icon name="palette"></sl-icon> Categorias</a>
            <a href="{{ path('app_admin_atendimentos_painel') }}" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-xl text-xs flex items-center gap-2 transition"><sl-icon name="graph-up-arrow"></sl-icon> Voltar ao painel</a>
        </div>
    </div>

    <form method="POST" action="{{ path('app_admin_atendimentos_procedimentos_salvar') }}" class="{{ card }} p-5">
        <input type="hidden" name="_token" value="{{ csrf_token('atendimentos_procedimentos') }}">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-200 dark:border-slate-800">
                        <th class="py-2 pr-2">Cód.</th>
                        <th class="py-2 px-2">Procedimento (Medware)</th>
                        <th class="py-2 px-2">Consulta?</th>
                        <th class="py-2 px-2">Tipo no gráfico</th>
                        <th class="py-2 px-2 text-right">Realizados</th>
                        <th class="py-2 px-2">Último realizado</th>
                        <th class="py-2 pl-2">Visto pela última vez</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in procedimentos %}
                        {% set ct = contagens[p.id] ?? null %}
                        <tr class="border-b border-slate-100 dark:border-slate-800/60">
                            <td class="py-2 pr-2 tabular-nums text-slate-400">{{ p.codProcedimento }}</td>
                            <td class="py-2 px-2 font-semibold text-slate-800 dark:text-slate-100">{{ p.descricao }}</td>
                            <td class="py-2 px-2 text-xs">{{ p.consulta ? 'sim' : 'não' }}</td>
                            <td class="py-2 px-2 whitespace-nowrap">
                                {% if p.categoria %}<span class="inline-block w-2.5 h-2.5 rounded-full mr-1 align-middle" style="background: {{ p.categoria.cor }}"></span>{% endif %}
                                <select name="categoria[{{ p.id }}]" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-800 dark:text-slate-200">
                                    {% for c in categorias %}<option value="{{ c.id }}" {{ p.categoria and p.categoria.id == c.id ? 'selected' }}>{{ c.nome }}{{ c.exibirNoSite ? '' : ' (oculto no site)' }}</option>{% endfor %}
                                    <option value="auto">↺ Automático (pela descrição)</option>
                                </select>
                                {% if p.categoriaManual %}<span class="ml-1 text-[10px] text-slate-400" title="Definido manualmente; a sincronização não altera">manual</span>{% endif %}
                            </td>
                            <td class="py-2 px-2 text-right tabular-nums">{{ ct ? ct.total|number_format(0, ',', '.') : 0 }}</td>
                            <td class="py-2 px-2 text-xs text-slate-500">{{ ct and ct.ultimo ? ct.ultimo|date('d/m/Y') : '—' }}</td>
                            <td class="py-2 pl-2 text-xs text-slate-500">{{ p.ultimoVistoEm|date('d/m/Y') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="py-6 text-center text-slate-400">Nenhum procedimento ainda. Rode a captura e a consolidação.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="flex justify-end mt-4">
            <button type="submit" class="px-5 py-2 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow-sm">Salvar alterações</button>
        </div>
    </form>
</div>
{% endblock %}
