{% extends 'admin/base.html.twig' %}

{% block title %}Atendimentos — Categorias{% endblock %}

{% set card = 'bg-white/80 dark:bg-slate-900/80 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm' %}
{% set campo = 'bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-800 dark:text-slate-200' %}

{% block body %}
<div class="space-y-6">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <sl-alert variant="{{ label == 'success' ? 'success' : 'warning' }}" open closable>
                <sl-icon slot="icon" name="{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }}"></sl-icon>
                {{ message }}
            </sl-alert>
        {% endfor %}
    {% endfor %}

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 {{ card }} p-5">
        <div>
            <div class="flex items-center gap-2">
                <sl-icon name="palette" class="text-cyan-500 text-2xl"></sl-icon>
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Tipos de atendimento</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Nome, cor e ordem das linhas do gráfico. Tipos desmarcados em "No site" ficam fora da API pública e do total.
            </p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_admin_atendimentos_procedimentos') }}" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-xl text-xs flex items-center gap-2 transition"><sl-icon name="list-check"></sl-icon> Procedimentos</a>
            <a href="{{ path('app_admin_atendimentos_painel') }}" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-xl text-xs flex items-center gap-2 transition"><sl-icon name="graph-up-arrow"></sl-icon> Voltar ao painel</a>
        </div>
    </div>

    <form method="POST" action="{{ path('app_admin_atendimentos_categorias_salvar') }}" class="{{ card }} p-5">
        <input type="hidden" name="_token" value="{{ csrf_token('atendimentos_categorias') }}">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-200 dark:border-slate-800">
                    <th class="py-2 pr-2">Identificador</th>
                    <th class="py-2 px-2">Nome exibido</th>
                    <th class="py-2 px-2">Cor</th>
                    <th class="py-2 px-2">Ordem</th>
                    <th class="py-2 pl-2 text-center">No site</th>
                </tr>
            </thead>
            <tbody>
                {% for c in categorias %}
                    <tr class="border-b border-slate-100 dark:border-slate-800/60 {{ not c.exibirNoSite ? 'opacity-60' }}">
                        <td class="py-2 pr-2 text-xs text-slate-400 font-mono">{{ c.slug }}</td>
                        <td class="py-2 px-2"><input name="cat[{{ c.id }}][nome]" value="{{ c.nome }}" class="{{ campo }} w-full" maxlength="100" required></td>
                        <td class="py-2 px-2"><input type="color" name="cat[{{ c.id }}][cor]" value="{{ c.cor }}" class="h-8 w-14 rounded cursor-pointer"></td>
                        <td class="py-2 px-2"><input type="number" name="cat[{{ c.id }}][ordem]" value="{{ c.ordem }}" class="{{ campo }} w-20"></td>
                        <td class="py-2 pl-2 text-center"><input type="checkbox" name="cat[{{ c.id }}][site]" value="1" {{ c.exibirNoSite ? 'checked' }} class="w-4 h-4 accent-cyan-600"></td>
                    </tr>
                {% endfor %}
                <tr class="bg-slate-50/60 dark:bg-slate-950/40">
                    <td class="py-2 pr-2"><input name="nova[slug]" placeholder="novo-tipo" class="{{ campo }} font-mono w-32" pattern="[a-z0-9-]{2,60}"></td>
                    <td class="py-2 px-2"><input name="nova[nome]" placeholder="Novo tipo de atendimento" class="{{ campo }} w-full" maxlength="100"></td>
                    <td class="py-2 px-2"><input type="color" name="nova[cor]" value="#0ea5e9" class="h-8 w-14 rounded cursor-pointer"></td>
                    <td class="py-2 px-2"><input type="number" name="nova[ordem]" value="{{ categorias|length + 1 }}" class="{{ campo }} w-20"></td>
                    <td class="py-2 pl-2 text-center"><input type="checkbox" name="nova[site]" value="1" checked class="w-4 h-4 accent-cyan-600"></td>
                </tr>
            </tbody>
        </table>
        <div class="flex justify-end mt-4">
            <button type="submit" class="px-5 py-2 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow-sm">Salvar</button>
        </div>
    </form>
</div>
{% endblock %}
