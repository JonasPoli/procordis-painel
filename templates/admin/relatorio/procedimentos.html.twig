                    <p class="text-xs text-slate-400">Nenhum registro no período.</p>
                {% endfor %}
            </div>
        </div>

        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-4">Atendimentos por Especialidade</h3>
            <div class="space-y-2.5 max-h-60 overflow-y-auto pr-2">
                {% for esp, count in dados.porEspecialidade %}
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200/60 dark:border-slate-800">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{{ esp }}</span>
                        <span class="text-xs font-mono font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 px-2 py-0.5 rounded-lg">{{ count }} consultas</span>
                    </div>
                {% else %}
                    <p class="text-xs text-slate-400">Nenhum registro no período.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Registros Analíticos do Período (Paginados de 100 em 100) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Registros Analíticos do Período</h3>
                <p class="text-xs text-slate-500">Lista completa com paginação de 100 em 100 registros por página</p>
            </div>
            <span class="text-xs font-semibold text-slate-500">Total de {{ dados.totalItems }} registros</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-3 px-2">Data/Hora</th>
                        <th class="py-3 px-2">Paciente</th>
                        <th class="py-3 px-2">Procedimento</th>
                        <th class="py-3 px-2">Financiamento</th>
                        <th class="py-3 px-2">Médico</th>
                        <th class="py-3 px-2">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                    {% for ag in dados.agendamentosPaginados %}
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                            <td class="py-2.5 px-2 font-mono text-slate-700 dark:text-slate-300">
                                {{ ag.dataHoraAgendada ? ag.dataHoraAgendada|date('d/m/Y H:i') : '--' }}
                            </td>
                            <td class="py-2.5 px-2 font-bold text-slate-900 dark:text-white">
                                {{ ag.pacienteNome|default('Paciente') }}
                            </td>
                            <td class="py-2.5 px-2 text-cyan-600 dark:text-cyan-400 font-medium">
                                {{ ag.procedimentoNome ?? 'Procedimento Geral' }}
                            </td>
                            <td class="py-2.5 px-2">
                                {% set t = ag.tipoAtendimento|default('sus') %}
                                {% if 'sus' in t %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">SUS</span>
                                {% elseif 'filantrop' in t %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Filantrópico</span>
                                {% else %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300">Convênio</span>
                                {% endif %}
                            </td>
                            <td class="py-2.5 px-2 text-slate-700 dark:text-slate-300">
                                {{ ag.medicoNome|default('Não informado') }}
                            </td>
                            <td class="py-2.5 px-2">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                    {{ ag.status }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-4 text-center text-slate-400">Nenhum agendamento encontrado para o período selecionado.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Paginação de 100 em 100 -->
        {% if dados.totalPages > 1 %}
            <div class="p-4 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                <span class="text-slate-500">
                    Mostrando página <strong>{{ dados.page }}</strong> de <strong>{{ dados.totalPages }}</strong> (100 itens por página)
                </span>

                <div class="flex items-center gap-1">
                    {% if dados.page > 1 %}
                        <a href="{{ path('app_admin_relatorio_procedimentos', app.request.query.all|merge({'page': dados.page - 1})) }}" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-lg transition">
                            &laquo; Anterior
                        </a>
                    {% endif %}

                    {% set startP = max(1, dados.page - 2) %}
                    {% set endP = min(dados.totalPages, dados.page + 2) %}

                    {% for p in startP..endP %}
                        <a href="{{ path('app_admin_relatorio_procedimentos', app.request.query.all|merge({'page': p})) }}" class="px-3 py-1.5 font-bold rounded-lg transition {% if p == dados.page %}bg-cyan-600 text-white shadow-sm{% else %}bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700{% endif %}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if dados.page < dados.totalPages %}
                        <a href="{{ path('app_admin_relatorio_procedimentos', app.request.query.all|merge({'page': dados.page + 1})) }}" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-lg transition">
                            Próximo &raquo;
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
    function toggleFiltroPeriodo() {
        const select = document.getElementById('tipoPeriodoSelect');
        const containerMes = document.getElementById('containerMesEspecifico');
        const containerAno = document.getElementById('containerAnoEspecifico');
        const containerPersonalizado = document.getElementById('containerPersonalizado');

        const val = select.value;
        if (val === 'mes_especifico') {
            containerMes.classList.remove('hidden');
            containerAno.classList.remove('hidden');
            containerPersonalizado.classList.add('hidden');
        } else if (val === 'ano_especifico') {
            containerMes.classList.add('hidden');
            containerAno.classList.remove('hidden');
            containerPersonalizado.classList.add('hidden');
        } else if (val === 'personalizado') {
            containerMes.classList.add('hidden');
            containerAno.classList.add('hidden');
            containerPersonalizado.classList.remove('hidden');
        } else {
            containerMes.classList.add('hidden');
            containerAno.classList.add('hidden');
            containerPersonalizado.classList.add('hidden');
        }
    }

    function mostrarTabelaAgregada(aba) {
        document.querySelectorAll('.tabela-agregada-painel').forEach(el => el.classList.add('hidden'));
        document.getElementById('tabConceito' + aba.charAt(0).toUpperCase() + aba.slice(1)).classList.remove('hidden');

        ['Dia', 'Mes', 'Trimestre', 'Quadrimestre', 'Semestre', 'Ano'].forEach(item => {
            const btn = document.getElementById('btnTab' + item);
            if (btn) {
                if (item.toLowerCase() === aba) {
                    btn.className = "px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-sm";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
                }
            }
        });
    }

    // Mapa de dados para troca dinâmica do agrupamento do Gráfico
    const mapasAgrupamentos = {
        dia: {
            labels: {{ dados.porDiaKeys|json_encode|raw }},
            data: {{ dados.porDiaValues|json_encode|raw }}
        },
        mes: {
            labels: {{ dados.porMesKeys|json_encode|raw }},
            data: {{ dados.porMesValues|json_encode|raw }}
        },
        trimestre: {
            labels: {{ dados.porTrimestreKeys|json_encode|raw }},
            data: {{ dados.porTrimestreValues|json_encode|raw }}
        },
        quadrimestre: {
            labels: {{ dados.porQuadrimestreKeys|json_encode|raw }},
            data: {{ dados.porQuadrimestreValues|json_encode|raw }}
        },
        semestre: {
            labels: {{ dados.porSemestreKeys|json_encode|raw }},
            data: {{ dados.porSemestreValues|json_encode|raw }}
        },
        ano: {
            labels: {{ dados.porAnoKeys|json_encode|raw }},
            data: {{ dados.porAnoValues|json_encode|raw }}
        }
    };

    let meuGraficoComparativo = null;
    const rawDatasetsProcedimentos = {{ dados.datasetsProcedimentos|json_encode|raw }};
    const mesesLabels = {{ dados.porMesKeys|json_encode|raw }};

    function toggleLinhaProcedimento(index, btnEl) {
        if (!meuGraficoComparativo) return;
        const isHidden = !meuGraficoComparativo.isDatasetVisible(index);
        meuGraficoComparativo.setDatasetVisibility(index, isHidden);
        meuGraficoComparativo.update();

        if (isHidden) {
            btnEl.classList.remove('opacity-40', 'line-through');
            btnEl.classList.add('active-chip');
        } else {
            btnEl.classList.add('opacity-40', 'line-through');
            btnEl.classList.remove('active-chip');
        }
    }

    function atualizarAgrupamentoGraficoComparativo(modalidade) {
        if (!meuGraficoComparativo) return;
        const config = mapasAgrupamentos[modalidade] || mapasAgrupamentos.mes;
        meuGraficoComparativo.data.labels = config.labels;

        rawDatasetsProcedimentos.forEach((ds, idx) => {
            if (meuGraficoComparativo.data.datasets[idx]) {
                const arrVal = ds.series && ds.series[modalidade] ? ds.series[modalidade] : ds.data;
                meuGraficoComparativo.data.datasets[idx].data = arrVal;
            }
        });

        meuGraficoComparativo.update();
    }

    function marcarTodosProcedimentos(visivel) {
        if (!meuGraficoComparativo) return;
        rawDatasetsProcedimentos.forEach((_, idx) => {
            meuGraficoComparativo.setDatasetVisibility(idx, visivel);
            const btnEl = document.getElementById('chipProc_' + idx);
            if (btnEl) {
                if (visivel) {
                    btnEl.classList.remove('opacity-40', 'line-through');
                    btnEl.classList.add('active-chip');
                } else {
                    btnEl.classList.add('opacity-40', 'line-through');
                    btnEl.classList.remove('active-chip');
                }
            }
        });
        meuGraficoComparativo.update();
    }

    // Inicialização dos Gráficos Chart.js
    document.addEventListener('DOMContentLoaded', function() {
        // 0. Gráfico Inteligente Comparativo por Procedimento (Linhas Individuais)
        const ctxComparativo = document.getElementById('graficoComparativoProcedimentos');
        if (ctxComparativo) {
            const chartDatasets = rawDatasetsProcedimentos.map(ds => ({
                label: ds.nome,
                data: ds.data,
                borderColor: ds.cor,
                backgroundColor: ds.cor + '15',
                borderWidth: 2,
                tension: 0.3,
                pointRadius: 2,
                pointHoverRadius: 5
            }));

            meuGraficoComparativo = new Chart(ctxComparativo, {
                type: 'line',
                data: {
                    labels: mesesLabels,
                    datasets: chartDatasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // 1. Gráfico de Evolução Temporal (Linha)
        const ctxLinha = document.getElementById('graficoEvolucaoTemporal');
        if (ctxLinha) {
            const configInicial = mapasAgrupamentos.mes;

            meuGraficoEvolucao = new Chart(ctxLinha, {
                type: 'line',
                data: {
                    labels: configInicial.labels,
                    datasets: [{
                        label: 'Atendimentos Realizados',
                        data: configInicial.data,
                        borderColor: '#0891b2',
                        backgroundColor: 'rgba(8, 145, 178, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // 2. Gráfico de Rosca (Financiamento)
        const ctxRosca = document.getElementById('graficoFinanciamentoRosca');
        if (ctxRosca) {
            new Chart(ctxRosca, {
                type: 'doughnut',
                data: {
                    labels: ['SUS', 'Filantrópico', 'Particular/Convênio'],
                    datasets: [{
                        data: [
                            {{ dados.financiamento.sus }},
                            {{ dados.financiamento.filantropico }},
                            {{ dados.financiamento.convenio }}
                        ],
                        backgroundColor: ['#10b981', '#6366f1', '#0284c7'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    },
                    cutout: '70%'
                }
            });
        }

        // 3. Gráfico Top 10 Procedimentos e Exames Mais Realizados (Barras Horizontais)
        const ctxTop = document.getElementById('graficoTopProcedimentos');
        if (ctxTop) {
            const top10 = rawDatasetsProcedimentos.slice(0, 10);
            new Chart(ctxTop, {
                type: 'bar',
                data: {
                    labels: top10.map(d => d.nome.length > 25 ? d.nome.substring(0, 25) + '...' : d.nome),
                    datasets: [{
                        label: 'Volume de Exames',
                        data: top10.map(d => d.total),
                        backgroundColor: top10.map(d => d.cor),
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { display: false } },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        // 4. Gráfico por Status dos Agendamentos (Pizza)
        const ctxStatus = document.getElementById('graficoStatusPizza');
        if (ctxStatus) {
            const statusObj = {{ dados.porStatus|json_encode|raw }};
            new Chart(ctxStatus, {
                type: 'pie',
                data: {
                    labels: Object.keys(statusObj),
                    datasets: [{
                        data: Object.values(statusObj),
                        backgroundColor: ['#0891b2', '#059669', '#f59e0b', '#ef4444', '#64748b', '#8b5cf6'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    });
</script>
{% endblock %}
