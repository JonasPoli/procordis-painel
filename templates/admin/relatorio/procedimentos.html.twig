{% extends 'admin/base.html.twig' %}

{% block title %}Relatório Estratégico de Procedimentos & Atendimentos - Procordis Painel{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .active-chip {
        box-shadow: 0 0 0 2px rgba(8, 145, 178, 0.4);
    }
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(150, 150, 150, 0.25);
        border-radius: 4px;
    }
</style>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Cabeçalho da Página e Ações de Exportação -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="p-2 bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 rounded-xl">
                    <sl-icon name="clipboard2-data-fill" class="text-xl"></sl-icon>
                </span>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Relatório Estratégico de Procedimentos & Atendimentos</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Dashboard analítico completo com volumetria, pessoas atendidas, tempos de espera e execução, produtividade médica, perfil demográfico e convênios.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ path('app_admin_relatorio_procedimentos_csv', {'tipoPeriodo': 'sem_filtro'}) }}" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-sm transition">
                <sl-icon name="file-earmark-spreadsheet"></sl-icon> 1. Baixar Base Completa em CSV (Todos os Atendimentos)
            </a>
            <a href="{{ path('app_admin_relatorio_procedimentos_excel') }}" class="px-3.5 py-2 bg-green-700 hover:bg-green-800 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-sm transition">
                <sl-icon name="file-earmark-excel"></sl-icon> 2. Baixar Modelo Excel (8 Abas com Fórmulas)
            </a>
        </div>
    </div>

    <!-- Dica de Uso da Planilha Rápida -->
    <div class="bg-gradient-to-r from-cyan-50 to-emerald-50 dark:from-slate-900 dark:to-slate-800 p-3.5 rounded-2xl border border-cyan-200/60 dark:border-slate-700 text-xs flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs">
        <div class="flex items-start gap-2.5">
            <div class="p-1.5 bg-cyan-600 text-white rounded-lg mt-0.5">
                <sl-icon name="lightning-charge"></sl-icon>
            </div>
            <div>
                <span class="font-bold text-slate-900 dark:text-white block">Como utilizar o Modelo Excel com Fórmulas Integradas:</span>
                <span class="text-slate-600 dark:text-slate-300 text-[11px] leading-relaxed">
                    <strong>Passo 1:</strong> Clique em <em>"1. Baixar Base Completa em CSV"</em> para extrair todos os atendimentos. <br class="hidden sm:inline">
                    <strong>Passo 2:</strong> Baixe o <em>"2. Baixar Modelo Excel"</em> (abre instantaneamente com 8 abas de dashboards). <br class="hidden sm:inline">
                    <strong>Passo 3:</strong> Abra o CSV, copie os registros e cole na aba <code>procedimentos</code> do Excel. Todas as 7 abas analíticas atualizarão sozinhas em tempo real!
                </span>
            </div>
        </div>
    </div>

    <!-- Filtro de Período Ampliado -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <form method="GET" action="{{ path('app_admin_relatorio_procedimentos') }}" class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Período:</label>
                <select name="tipoPeriodo" id="tipoPeriodoSelect" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none" onchange="toggleFiltroPeriodo()">
                    <option value="ultimos_6_meses" {% if dados.tipoPeriodo == 'ultimos_6_meses' %}selected{% endif %}>Últimos 6 Meses</option>
                    <option value="mes_especifico" {% if dados.tipoPeriodo == 'mes_especifico' %}selected{% endif %}>Mês Específico</option>
                    <option value="ano_especifico" {% if dados.tipoPeriodo == 'ano_especifico' %}selected{% endif %}>Por Ano Inteiro</option>
                    <option value="personalizado" {% if dados.tipoPeriodo == 'personalizado' %}selected{% endif %}>Período Personalizado (De / Até)</option>
                    <option value="sem_filtro" {% if dados.tipoPeriodo == 'sem_filtro' %}selected{% endif %}>Tudo (Sem filtro de data)</option>
                </select>
            </div>

            <!-- Seleção de Mês + Ano -->
            <div id="containerMesEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' %}hidden{% endif %}">
                <select name="mes" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for m in 1..12 %}
                        <option value="{{ m }}" {% if dados.mes == m %}selected{% endif %}>
                            {{ attribute(['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'], m-1) }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Seleção de Ano Inteiro -->
            <div id="containerAnoEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' and dados.tipoPeriodo != 'ano_especifico' %}hidden{% endif %}">
                <select name="ano" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for a in "now"|date("Y")..2005 %}
                        <option value="{{ a }}" {% if dados.ano == a %}selected{% endif %}>Ano {{ a }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Período Personalizado (Data Início / Data Fim) -->
            <div id="containerPersonalizado" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'personalizado' %}hidden{% endif %}">
                <input type="date" name="dataInicio" value="{{ dados.dataInicioCustom }}" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium">
                <span class="text-xs text-slate-400">até</span>
                <input type="date" name="dataFim" value="{{ dados.dataFimCustom }}" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium">
            </div>

            <button type="submit" class="px-4 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow-sm flex items-center gap-1">
                <sl-icon name="funnel-fill"></sl-icon> Filtrar Relatório
            </button>
        </form>
    </div>

    <!-- 1. Grid de Indicadores Estratégicos (9 Cards de KPIs Macro) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-9 gap-3">
        <!-- Total de Procedimentos -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total Atendimentos</span>
            <p class="text-xl font-black text-slate-900 dark:text-white mt-1">{{ dados.totalProcedimentos }}</p>
            <span class="text-[10px] text-cyan-600 font-semibold truncate block mt-0.5">{{ dados.rotuloPeriodo }}</span>
        </div>

        <!-- Pessoas Únicas Atendidas -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Pessoas Atendidas</span>
            <p class="text-xl font-black text-emerald-600 dark:text-emerald-400 mt-1">{{ dados.totalPessoasUnicas }}</p>
            <span class="text-[10px] font-bold text-emerald-500 bg-emerald-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">{{ dados.mediaProcedimentosPorPessoa }} exames/pessoa</span>
        </div>

        <!-- Pacientes SUS -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Mix SUS</span>
            <p class="text-xl font-black text-teal-600 dark:text-teal-400 mt-1">{{ dados.financiamento.sus }}</p>
            <span class="text-[10px] font-bold text-teal-500 bg-teal-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">{{ dados.financiamento.pctSus }}% do mix</span>
        </div>

        <!-- Convênios & Particular -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Convênios / Planos</span>
            <p class="text-xl font-black text-sky-600 dark:text-sky-400 mt-1">{{ dados.financiamento.convenio }}</p>
            <span class="text-[10px] font-bold text-sky-500 bg-sky-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">{{ dados.financiamento.pctConvenio }}% do mix</span>
        </div>

        <!-- Filantrópicos -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Filantropia</span>
            <p class="text-xl font-black text-indigo-600 dark:text-indigo-400 mt-1">{{ dados.financiamento.filantropico }}</p>
            <span class="text-[10px] font-bold text-indigo-500 bg-indigo-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">{{ dados.financiamento.pctFilantropico }}% do mix</span>
        </div>

        <!-- Eficiência / Conclusão -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Taxa Conclusão</span>
            <p class="text-xl font-black text-cyan-600 dark:text-cyan-400 mt-1">{{ (100 - dados.eficiencia.taxaCancelamentoGeral)|number_format(1, ',', '.') }}%</p>
            <span class="text-[10px] text-slate-500 block truncate mt-0.5">atendimentos realizados</span>
        </div>

        <!-- Taxa de Cancelamento / No-Show -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Taxa Cancelamento</span>
            <p class="text-xl font-black text-rose-600 dark:text-rose-400 mt-1">{{ dados.eficiencia.taxaCancelamentoGeral }}%</p>
            <span class="text-[10px] text-rose-500 bg-rose-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">{{ dados.eficiencia.totalCancelados }} cancelados</span>
        </div>

        <!-- Tempo Médio de Espera -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Média Espera</span>
            <p class="text-xl font-black text-amber-600 dark:text-amber-400 mt-1">{{ dados.eficiencia.tempoMedioEsperaMin }}<span class="text-xs font-normal"> min</span></p>
            <span class="text-[10px] text-amber-500 bg-amber-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">chegada até início</span>
        </div>

        <!-- Tempo Médio de Atendimento / Execução -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Média Execução</span>
            <p class="text-xl font-black text-purple-600 dark:text-purple-400 mt-1">{{ dados.eficiencia.tempoMedioExecucaoMin }}<span class="text-xs font-normal"> min</span></p>
            <span class="text-[10px] text-purple-500 bg-purple-500/10 px-1.5 py-0.5 rounded-md inline-block mt-0.5">início até término</span>
        </div>
    </div>

    <!-- 2. MÓDULO DE TEMPOS: Espera e Execução por Procedimento -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="stopwatch" class="text-amber-500"></sl-icon> 
                    Eficiência Clínica: Tempos de Espera e Execução por Procedimento
                </h3>
                <p class="text-xs text-slate-500">Acompanhe a evolução histórica dos tempos de espera (chegada até consulta) e tempo de execução/duração de cada exame ao longo dos dias, meses e anos</p>
            </div>

            <!-- Controles do Módulo de Tempos -->
            <div class="flex flex-wrap items-center gap-2">
                <!-- Seletor de Procedimento -->
                <select id="seletorProcedimentoTempos" onchange="atualizarGraficoTempos()" class="bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-2.5 py-1 text-xs text-slate-800 dark:text-slate-200 font-bold focus:outline-none focus:ring-2 focus:ring-amber-500 max-w-xs truncate">
                    <option value="__geral__" selected>🩺 Todos os Procedimentos (Média Global)</option>
                    {% for proc in dados.datasetsProcedimentos %}
                        <option value="{{ proc.nome }}">{{ proc.nome }}</option>
                    {% endfor %}
                </select>

                <!-- Seletor de Métrica de Tempo -->
                <div class="inline-flex p-0.5 bg-slate-100 dark:bg-slate-950 rounded-xl text-xs font-semibold">
                    <button type="button" id="btnMetricaTempoAmbos" onclick="alterarMetricaTempo('ambos')" class="px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-amber-600 dark:text-amber-400 shadow-xs">Espera vs Execução</button>
                    <button type="button" id="btnMetricaTempoEspera" onclick="alterarMetricaTempo('espera')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Só Espera</button>
                    <button type="button" id="btnMetricaTempoExecucao" onclick="alterarMetricaTempo('execucao')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Só Execução</button>
                    <button type="button" id="btnMetricaTempoTotal" onclick="alterarMetricaTempo('total')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Total na Clínica</button>
                </div>

                <!-- Tipo de Visualização (Barras Agrupadas / Linha / Área) -->
                <div class="inline-flex p-0.5 bg-slate-100 dark:bg-slate-950 rounded-xl text-xs font-semibold">
                    <button type="button" id="btnTipoTempoBarra" onclick="alterarTipoGraficoTempo('bar')" title="Barras Comparativas" class="px-2 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-amber-600 dark:text-amber-400 shadow-xs">
                        <sl-icon name="bar-chart-line"></sl-icon>
                    </button>
                    <button type="button" id="btnTipoTempoLinha" onclick="alterarTipoGraficoTempo('line')" title="Linhas Suaves" class="px-2 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">
                        <sl-icon name="activity"></sl-icon>
                    </button>
                    <button type="button" id="btnTipoTempoArea" onclick="alterarTipoGraficoTempo('area')" title="Área Preenchida" class="px-2 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">
                        <sl-icon name="water"></sl-icon>
                    </button>
                </div>

                <!-- Seletor de Resolução Temporal -->
                <select id="seletorAgrupamentoTempo" onchange="alterarAgrupamentoTempo(this.value)" class="bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-2.5 py-1 text-xs text-slate-800 dark:text-slate-200 font-bold focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <option value="dia">Por Dia</option>
                    <option value="mes" selected>Por Mês</option>
                    <option value="trimestre">Por Trimestre</option>
                    <option value="quadrimestre">Por Quadrimestre</option>
                    <option value="semestre">Por Semestre</option>
                    <option value="ano">Por Ano</option>
                </select>
            </div>
        </div>

        <!-- Mini Painel de Estatísticas de Tempo do Procedimento / Exame Ativo -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="bg-amber-50/60 dark:bg-slate-950/60 p-3 rounded-xl border border-amber-200/60 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-bold text-amber-700 dark:text-amber-400 block tracking-wider">⏳ Tempo Médio de Espera</span>
                    <span id="statTempoEsperaValor" class="text-lg font-black text-amber-600 dark:text-amber-400">{{ dados.eficiencia.tempoMedioEsperaMin }} min</span>
                    <span class="text-[10px] text-slate-500 block">Tempo entre chegada e recepção até início</span>
                </div>
                <div class="p-2 bg-amber-500/10 text-amber-600 rounded-xl">
                    <sl-icon name="hourglass-split" class="text-xl"></sl-icon>
                </div>
            </div>

            <div class="bg-purple-50/60 dark:bg-slate-950/60 p-3 rounded-xl border border-purple-200/60 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-bold text-purple-700 dark:text-purple-400 block tracking-wider">🩺 Tempo Médio de Execução</span>
                    <span id="statTempoExecucaoValor" class="text-lg font-black text-purple-600 dark:text-purple-400">{{ dados.eficiencia.tempoMedioExecucaoMin }} min</span>
                    <span class="text-[10px] text-slate-500 block">Duração do exame / consulta no consultório</span>
                </div>
                <div class="p-2 bg-purple-500/10 text-purple-600 rounded-xl">
                    <sl-icon name="heart-pulse" class="text-xl"></sl-icon>
                </div>
            </div>

            <div class="bg-cyan-50/60 dark:bg-slate-950/60 p-3 rounded-xl border border-cyan-200/60 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-bold text-cyan-700 dark:text-cyan-400 block tracking-wider">⏱️ Tempo Total na Clínica</span>
                    <span id="statTempoTotalValor" class="text-lg font-black text-cyan-600 dark:text-cyan-400">{{ dados.eficiencia.tempoMedioPermanenciaMin }} min</span>
                    <span class="text-[10px] text-slate-500 block">Permanência total (espera + atendimento)</span>
                </div>
                <div class="p-2 bg-cyan-500/10 text-cyan-600 rounded-xl">
                    <sl-icon name="clock-history" class="text-xl"></sl-icon>
                </div>
            </div>
        </div>

        <!-- Grid: Gráfico de Evolução de Tempos + Tabela Analítica Comparativa -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Gráfico de Tempos -->
            <div class="lg:col-span-2 bg-slate-50/50 dark:bg-slate-950/40 p-4 rounded-xl border border-slate-100 dark:border-slate-800">
                <div class="h-72 w-full">
                    <canvas id="graficoTemposEvolucao"></canvas>
                </div>
            </div>

            <!-- Tabela Comparativa de Tempos por Exame / Procedimento -->
            <div class="bg-slate-50/50 dark:bg-slate-950/40 p-4 rounded-xl border border-slate-100 dark:border-slate-800 flex flex-col justify-between space-y-3">
                <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Média por Procedimento</span>
                    <input type="text" id="filtroTabelaTemposInput" onkeyup="filtrarTabelaTempos()" placeholder="Filtrar..." class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-0.5 text-[11px] w-28 focus:outline-none">
                </div>

                <div class="max-h-60 overflow-y-auto custom-scrollbar">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="sticky top-0 bg-slate-200/80 dark:bg-slate-900 text-[10px] uppercase font-bold text-slate-500">
                            <tr>
                                <th class="py-1.5 px-2">Procedimento</th>
                                <th class="py-1.5 px-1 text-right">Espera</th>
                                <th class="py-1.5 px-1 text-right">Exec.</th>
                                <th class="py-1.5 px-2 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody id="corpoTabelaTempos" class="divide-y divide-slate-200/60 dark:divide-slate-800 text-[11px]">
                            {% for tp in dados.tabelaTemposProcedimentos %}
                                <tr class="item-tempo-linha hover:bg-white dark:hover:bg-slate-800/60 cursor-pointer" onclick="selecionarProcedimentoNoGrafico('{{ tp.nome|e('js') }}')">
                                    <td class="py-1.5 px-2 font-medium text-slate-800 dark:text-slate-200 item-tempo-nome truncate max-w-[120px]" title="{{ tp.nome }}">{{ tp.nome }}</td>
                                    <td class="py-1.5 px-1 text-right font-mono text-amber-600 font-bold">{{ tp.mediaEsperaMin }}m</td>
                                    <td class="py-1.5 px-1 text-right font-mono text-purple-600 font-bold">{{ tp.mediaExecucaoMin }}m</td>
                                    <td class="py-1.5 px-2 text-right font-mono text-cyan-600 font-bold">{{ tp.mediaPermanenciaMin }}m</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="py-3 text-center text-slate-400">Nenhum dado temporal.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p class="text-[10px] text-slate-400 text-center">Clique em qualquer exame da lista para visualizá-lo no gráfico</p>
            </div>
        </div>
    </div>

    <!-- 3. Gráfico Inteligente de Comparação por Procedimentos (Linhas Individuais com Liga/Desliga) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="sliders" class="text-cyan-500"></sl-icon> Gráfico Inteligente: Comparativo Volumétrico por Exame
                </h3>
                <p class="text-xs text-slate-500">Selecione abaixo quais exames deseja ligar ou desligar na visualização gráfica em linha</p>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-xl text-xs font-bold">
                    <span class="text-[10px] text-slate-400 px-1 uppercase">Agrupar gráfico:</span>
                    <select id="seletorAgrupamentoComparativo" onchange="atualizarAgrupamentoGraficoComparativo(this.value)" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-1 text-xs text-cyan-600 dark:text-cyan-400 font-bold focus:outline-none">
                        <option value="dia">Por Dia</option>
                        <option value="mes" selected>Por Mês</option>
                        <option value="trimestre">Por Trimestre</option>
                        <option value="quadrimestre">Por Quadrimestre</option>
                        <option value="semestre">Por Semestre</option>
                        <option value="ano">Por Ano</option>
                    </select>
                </div>

                <div class="flex items-center gap-1">
                    <button type="button" onclick="marcarTodosProcedimentos(true)" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition">
                        Ativar Todos
                    </button>
                    <button type="button" onclick="marcarTodosProcedimentos(false)" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition">
                        Desativar Todos
                    </button>
                </div>
            </div>
        </div>

        <!-- Chips interativos de procedimentos -->
        <div class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto custom-scrollbar p-1">
            {% for idx, proc in dados.datasetsProcedimentos %}
                <button type="button" 
                        id="chipProc_{{ idx }}" 
                        onclick="toggleLinhaProcedimento({{ idx }}, this)" 
                        class="px-2.5 py-1 rounded-xl text-xs font-bold border transition flex items-center gap-1.5 active-chip"
                        style="background-color: {{ proc.cor }}15; border-color: {{ proc.cor }}; color: {{ proc.cor }};">
                    <span class="w-2 h-2 rounded-full inline-block" style="background-color: {{ proc.cor }};"></span>
                    <span>{{ proc.nome }}</span>
                    <span class="opacity-70 text-[10px]">({{ proc.total }})</span>
                </button>
            {% endfor %}
        </div>

        <div class="h-80 w-full">
            <canvas id="graficoComparativoProcedimentos"></canvas>
        </div>
    </div>

    <!-- 4. Gráficos de Evolução Geral (Atendimentos & Pessoas Atendidas) e Composição -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Gráfico de Evolução Temporal Interativo com Multi-Métricas e Agrupamentos -->
        <div class="lg:col-span-2 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <sl-icon name="graph-up-arrow" class="text-cyan-600 dark:text-cyan-400"></sl-icon>
                        Evolução Temporal: Atendimentos & Pessoas Atendidas
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Volume de exames, contagem de pacientes únicos, segmentação por convênio e status</p>
                </div>
                
                <!-- Controles do Gráfico -->
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Seletor de Métrica/Camada -->
                    <div class="inline-flex p-0.5 bg-slate-100 dark:bg-slate-950 rounded-xl text-xs font-semibold">
                        <button type="button" id="btnMetricaTotal" onclick="alterarMetricaEvolucao('total')" class="px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-xs">Total Atendimentos</button>
                        <button type="button" id="btnMetricaPessoas" onclick="alterarMetricaEvolucao('pessoas')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">👥 Pessoas Atendidas</button>
                        <button type="button" id="btnMetricaComparativoPessoas" onclick="alterarMetricaEvolucao('comparativo_pessoas')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Exames x Pessoas</button>
                        <button type="button" id="btnMetricaFinanciamento" onclick="alterarMetricaEvolucao('financiamento')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">SUS x Convênios</button>
                        <button type="button" id="btnMetricaStatus" onclick="alterarMetricaEvolucao('status')" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Status</button>
                    </div>

                    <!-- Tipo de Gráfico (Linha / Barra / Área) -->
                    <div class="inline-flex p-0.5 bg-slate-100 dark:bg-slate-950 rounded-xl text-xs font-semibold">
                        <button type="button" id="btnTipoLinha" onclick="alterarTipoGraficoEvolucao('line')" title="Linha Suave" class="px-2 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-xs">
                            <sl-icon name="activity"></sl-icon>
                        </button>
                        <button type="button" id="btnTipoBarra" onclick="alterarTipoGraficoEvolucao('bar')" title="Barras" class="px-2 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">
                            <sl-icon name="bar-chart-line"></sl-icon>
                        </button>
                        <button type="button" id="btnTipoArea" onclick="alterarTipoGraficoEvolucao('area')" title="Área Preenchida" class="px-2 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">
                            <sl-icon name="water"></sl-icon>
                        </button>
                    </div>

                    <!-- Seletor de Resolução Temporal -->
                    <select id="seletorAgrupamentoGrafico" onchange="alterarAgrupamentoEvolucao(this.value)" class="bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-2.5 py-1 text-xs text-slate-800 dark:text-slate-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-500">
                        <option value="dia">Por Dia</option>
                        <option value="mes" selected>Por Mês</option>
                        <option value="trimestre">Por Trimestre</option>
                        <option value="quadrimestre">Por Quadrimestre</option>
                        <option value="semestre">Por Semestre</option>
                        <option value="ano">Por Ano</option>
                    </select>
                </div>
            </div>

            <!-- Mini KPIs de Insights Estatísticos -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3">
                <div class="bg-slate-50/80 dark:bg-slate-950/60 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">🏆 Pico no Período</span>
                    <span class="text-sm font-black text-emerald-600 dark:text-emerald-400">{{ dados.insights.picoValor }}</span>
                    <span class="text-[10px] text-slate-500 block truncate font-medium">em {{ dados.insights.picoPeriodo }}</span>
                </div>
                <div class="bg-slate-50/80 dark:bg-slate-950/60 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">📉 Menor Volume</span>
                    <span class="text-sm font-black text-amber-600 dark:text-amber-400">{{ dados.insights.minValor }}</span>
                    <span class="text-[10px] text-slate-500 block truncate font-medium">em {{ dados.insights.minPeriodo }}</span>
                </div>
                <div class="bg-slate-50/80 dark:bg-slate-950/60 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">📊 Média / Mês</span>
                    <span class="text-sm font-black text-cyan-600 dark:text-cyan-400">{{ dados.insights.mediaPeriodoMes }}</span>
                    <span class="text-[10px] text-slate-500 block font-medium">atendimentos</span>
                </div>
                <div class="bg-slate-50/80 dark:bg-slate-950/60 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">⚡ Média Diária</span>
                    <span class="text-sm font-black text-indigo-600 dark:text-indigo-400">{{ dados.mediaDia }}</span>
                    <span class="text-[10px] text-slate-500 block font-medium">por dia útil</span>
                </div>
            </div>

            <div class="h-64 w-full relative">
                <canvas id="graficoEvolucaoTemporal"></canvas>
            </div>
        </div>

        <!-- Gráfico de Rosca (Financiamento) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="pie-chart-fill" class="text-cyan-500"></sl-icon> Composição de Convênios
                </h3>
                <p class="text-xs text-slate-500">Divisão SUS vs Filantropia vs Convênios</p>
            </div>
            <div class="h-56 w-full flex items-center justify-center">
                <canvas id="graficoFinanciamentoRosca"></canvas>
            </div>
            <div class="grid grid-cols-3 gap-1 text-center pt-3 border-t border-slate-100 dark:border-slate-800 text-[10px]">
                <div>
                    <span class="block font-bold text-emerald-600">SUS</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctSus }}%</span>
                </div>
                <div>
                    <span class="block font-bold text-indigo-600">Filantrópico</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctFilantropico }}%</span>
                </div>
                <div>
                    <span class="block font-bold text-sky-600">Convênios</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctConvenio }}%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Painel de Produtividade Médica & Distribuição por Especialidade -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Tabela de Produtividade Médica com Filtro Rápido -->
        <div class="lg:col-span-2 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <sl-icon name="person-badge" class="text-indigo-600"></sl-icon> Produtividade Médica & Escalas
                    </h3>
                    <p class="text-xs text-slate-500">Volume de atendimentos, conclusão de consultas e taxa de absenteísmo por profissional</p>
                </div>
                <div class="relative">
                    <input type="text" id="filtroMedicosInput" onkeyup="filtrarTabelaMedicos()" placeholder="Buscar médico ou especialidade..." class="bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-60">
                </div>
            </div>

            <div class="max-h-72 overflow-y-auto custom-scrollbar">
                <table id="tabelaMedicosCorpo" class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500 text-[10px]">
                        <tr>
                            <th class="py-2.5 px-3">Médico</th>
                            <th class="py-2.5 px-2">Especialidade</th>
                            <th class="py-2.5 px-2 text-right">Total</th>
                            <th class="py-2.5 px-2 text-right">Concluídos</th>
                            <th class="py-2.5 px-2 text-right">Cancelados</th>
                            <th class="py-2.5 px-2 text-right">No-Show %</th>
                            <th class="py-2.5 px-3 text-right">Mix %</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for med in dados.detalhesMedicos %}
                            <tr class="medico-row hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-bold text-slate-900 dark:text-white medico-nome">{{ med.nome }}</td>
                                <td class="py-2 px-2 text-slate-500 medico-esp">{{ med.especialidade }}</td>
                                <td class="py-2 px-2 text-right font-black font-mono text-indigo-600 dark:text-indigo-400">{{ med.total }}</td>
                                <td class="py-2 px-2 text-right font-mono text-emerald-600">{{ med.finalizados }}</td>
                                <td class="py-2 px-2 text-right font-mono text-rose-500">{{ med.cancelados }}</td>
                                <td class="py-2 px-2 text-right font-mono text-slate-500">{{ med.taxaCancelamento }}%</td>
                                <td class="py-2 px-3 text-right font-mono font-bold text-slate-700 dark:text-slate-300">{{ med.pctTotal }}%</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="py-4 text-center text-slate-400">Nenhum médico com atendimento registrado no período.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Gráfico de Especialidades e Top Exames -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-3">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="award" class="text-amber-500"></sl-icon> Demandas por Especialidade
                </h3>
                <p class="text-xs text-slate-500">Volume consolidado por área clínica</p>
            </div>
            <div class="h-64 w-full">
                <canvas id="graficoEspecialidadesBarra"></canvas>
            </div>
        </div>
    </div>

    <!-- 6. Painel de Padrões de Fluxo: Dias da Semana & Horários de Pico -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Distribuição por Dia da Semana -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between mb-3 border-b border-slate-100 dark:border-slate-800 pb-2">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <sl-icon name="calendar-week" class="text-purple-600"></sl-icon> Fluxo por Dia da Semana
                    </h3>
                    <p class="text-xs text-slate-500">Padrão de comparecimento e volume de atendimentos</p>
                </div>
            </div>
            <div class="h-60 w-full">
                <canvas id="graficoDiasSemanaBarra"></canvas>
            </div>
        </div>

        <!-- Distribuição por Faixa Horária (Gargalos e Pico) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between mb-3 border-b border-slate-100 dark:border-slate-800 pb-2">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <sl-icon name="clock" class="text-rose-500"></sl-icon> Distribuição por Faixa Horária (Horários de Pico)
                    </h3>
                    <p class="text-xs text-slate-500">Concentração de atendimentos entre 06h e 20h para dimensionamento de equipe</p>
                </div>
            </div>
            <div class="h-60 w-full">
                <canvas id="graficoFaixasHorariasArea"></canvas>
            </div>
        </div>
    </div>

    <!-- 7. Painel de Demografia & Perfil Clínico e Operadoras -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Perfil por Gênero (Rosca) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="gender-ambiguous" class="text-pink-500"></sl-icon> Perfil por Gênero
                </h3>
                <p class="text-xs text-slate-500">Distribuição entre pacientes atendidos</p>
            </div>
            <div class="h-52 w-full flex items-center justify-center">
                <canvas id="graficoGeneroRosca"></canvas>
            </div>
            <div class="grid grid-cols-3 gap-1 text-center pt-3 border-t border-slate-100 dark:border-slate-800 text-[10px]">
                <div>
                    <span class="block font-bold text-blue-600">Masculino</span>
                    <span class="font-mono text-slate-500">{{ dados.porGenero.M }} ({{ dados.totalProcedimentos > 0 ? ((dados.porGenero.M / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%)</span>
                </div>
                <div>
                    <span class="block font-bold text-pink-600">Feminino</span>
                    <span class="font-mono text-slate-500">{{ dados.porGenero.F }} ({{ dados.totalProcedimentos > 0 ? ((dados.porGenero.F / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%)</span>
                </div>
                <div>
                    <span class="block font-bold text-slate-500">Não informado</span>
                    <span class="font-mono text-slate-500">{{ dados.porGenero['NÃO INFORMADO'] }}</span>
                </div>
            </div>
        </div>

        <!-- Perfil por Faixa Etária (Barras) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="people" class="text-teal-500"></sl-icon> Perfil por Faixa Etária
                </h3>
                <p class="text-xs text-slate-500">Grupos etários atendidos pela clínica</p>
            </div>
            <div class="h-56 w-full">
                <canvas id="graficoFaixaEtariaBarra"></canvas>
            </div>
        </div>

        <!-- Top Operadoras de Convênio (Barras Horizontais) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="hospital" class="text-sky-500"></sl-icon> Top Convênios / Planos
                </h3>
                <p class="text-xs text-slate-500">Operadoras com maior volume no período</p>
            </div>
            <div class="h-56 w-full">
                <canvas id="graficoTopConveniosBarra"></canvas>
            </div>
        </div>
    </div>

    <!-- 8. Tabelas Planilhadas por Intervalo (Dia / Mês / Trimestre / Quadrimestre / Semestre / Ano) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="table" class="text-cyan-600"></sl-icon> Tabelas Planilhadas por Intervalo Temporal
                </h3>
                <p class="text-xs text-slate-500">Visão estatística agregada de atendimentos, pacientes únicos e média por Dia, Mês, Trimestre, Quadrimestre, Semestre e Ano</p>
            </div>

            <!-- Abas de Navegação das Tabelas -->
            <div class="flex flex-wrap items-center gap-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-xl text-xs font-bold">
                <button type="button" onclick="mostrarTabelaAgregada('dia')" id="btnTabDia" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Dia</button>
                <button type="button" onclick="mostrarTabelaAgregada('mes')" id="btnTabMes" class="px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-sm">Por Mês</button>
                <button type="button" onclick="mostrarTabelaAgregada('trimestre')" id="btnTabTrimestre" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Trimestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('quadrimestre')" id="btnTabQuadrimestre" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Quadrimestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('semestre')" id="btnTabSemestre" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Semestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('ano')" id="btnTabAno" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Ano</button>
            </div>
        </div>

        <!-- Tabela por Dia -->
        <div id="tabConceitoDia" class="tabela-agregada-painel hidden">
            <div class="max-h-72 overflow-y-auto custom-scrollbar">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500 text-[10px]">
