<script>
    function toggleFiltroPeriodo() {
        const select = document.getElementById('tipoPeriodoSelect');
        const mesContainer = document.getElementById('containerMesEspecifico');
        const anoContainer = document.getElementById('containerAnoEspecifico');
        const personalizadoContainer = document.getElementById('containerPersonalizado');

        mesContainer.classList.add('hidden');
        anoContainer.classList.add('hidden');
        personalizadoContainer.classList.add('hidden');

        if (select.value === 'mes_especifico') {
            mesContainer.classList.remove('hidden');
            anoContainer.classList.remove('hidden');
        } else if (select.value === 'ano_especifico') {
            anoContainer.classList.remove('hidden');
        } else if (select.value === 'personalizado') {
            personalizadoContainer.classList.remove('hidden');
        }
    }

    function mostrarTabelaAgregada(aba) {
        document.querySelectorAll('.tabela-agregada-painel').forEach(el => el.classList.add('hidden'));
        document.getElementById('tabConceito' + aba.charAt(0).toUpperCase() + aba.slice(1)).classList.remove('hidden');

        ['Dia', 'Mes', 'Trimestre', 'Quadrimestre', 'Semestre', 'Ano'].forEach(item => {
            const btn = document.getElementById('btnTab' + item);
            if (btn) {
                if (item.toLowerCase() === aba) {
                    btn.className = "px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-sm";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
                }
            }
        });
    }

    function filtrarTabelaMedicos() {
        const query = document.getElementById('filtroMedicosInput').value.toLowerCase();
        const rows = document.querySelectorAll('.medico-row');
        rows.forEach(r => {
            const nome = r.querySelector('.medico-nome')?.textContent.toLowerCase() || '';
            const esp = r.querySelector('.medico-esp')?.textContent.toLowerCase() || '';
            if (nome.includes(query) || esp.includes(query)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function filtrarTabelaTempos() {
        const query = document.getElementById('filtroTabelaTemposInput').value.toLowerCase();
        const rows = document.querySelectorAll('.item-tempo-linha');
        rows.forEach(r => {
            const nome = r.querySelector('.item-tempo-nome')?.textContent.toLowerCase() || '';
            if (nome.includes(query)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    // Mapa de dados para troca dinâmica do agrupamento dos Gráficos
    const mapasAgrupamentos = {
        dia: {
            labels: {{ dados.porDiaKeys|json_encode|raw }},
            data: {{ dados.porDiaValues|json_encode|raw }}
        },
        mes: {
            labels: {{ dados.porMesKeys|json_encode|raw }},
            data: {{ dados.porMesValues|json_encode|raw }}
        },
        trimestre: {
            labels: {{ dados.porTrimestreKeys|json_encode|raw }},
            data: {{ dados.porTrimestreValues|json_encode|raw }}
        },
        quadrimestre: {
            labels: {{ dados.porQuadrimestreKeys|json_encode|raw }},
            data: {{ dados.porQuadrimestreValues|json_encode|raw }}
        },
        semestre: {
            labels: {{ dados.porSemestreKeys|json_encode|raw }},
            data: {{ dados.porSemestreValues|json_encode|raw }}
        },
        ano: {
            labels: {{ dados.porAnoKeys|json_encode|raw }},
            data: {{ dados.porAnoValues|json_encode|raw }}
        }
    };

    const seriesFinanciamento = {{ dados.seriesFinanciamento|json_encode|raw }};
    const seriesStatus = {{ dados.seriesStatus|json_encode|raw }};
    const seriesPessoas = {{ dados.seriesPessoas|json_encode|raw }};
    const seriesTemposGeral = {{ dados.seriesTemposGeral|json_encode|raw }};
    const seriesTemposProcedimentos = {{ dados.seriesTemposProcedimentos|json_encode|raw }};
    const tabelaTemposProcedimentos = {{ dados.tabelaTemposProcedimentos|json_encode|raw }};

    let meuGraficoComparativo = null;
    let meuGraficoEvolucao = null;
    let meuGraficoTempos = null;

    // Estado do Módulo de Tempos
    let metricaTempoAtual = 'ambos'; // ambos, espera, execucao, total
    let tipoGraficoTempoAtual = 'bar'; // bar, line, area
    let agrupamentoTempoAtual = 'mes'; // dia, mes, trimestre, quadrimestre, semestre, ano

    // Estado da Evolução Geral
    let metricaEvolucaoAtual = 'total'; // total, pessoas, comparativo_pessoas, financiamento, status
    let agrupamentoEvolucaoAtual = 'mes';
    let tipoGraficoEvolucaoAtual = 'line';

    const rawDatasetsProcedimentos = {{ dados.datasetsProcedimentos|json_encode|raw }};
    const mesesLabels = {{ dados.porMesKeys|json_encode|raw }};

    // ==========================================
    // MÓDULO DE TEMPOS DE ESPERA E EXECUÇÃO
    // ==========================================
    function obterDatasetsTempos() {
        const procSel = document.getElementById('seletorProcedimentoTempos')?.value || '__geral__';
        const isArea = tipoGraficoTempoAtual === 'area';
        const isBar = tipoGraficoTempoAtual === 'bar';

        let fonteDadosEspera = [];
        let fonteDadosExec = [];
        let fonteDadosTotal = [];

        if (procSel === '__geral__') {
            fonteDadosEspera = (seriesTemposGeral.espera && seriesTemposGeral.espera[agrupamentoTempoAtual]) || [];
            fonteDadosExec = (seriesTemposGeral.execucao && seriesTemposGeral.execucao[agrupamentoTempoAtual]) || [];
            fonteDadosTotal = (seriesTemposGeral.total && seriesTemposGeral.total[agrupamentoTempoAtual]) || [];
        } else {
            const procData = seriesTemposProcedimentos[procSel] || {};
            fonteDadosEspera = (procData.espera && procData.espera[agrupamentoTempoAtual]) || [];
            fonteDadosExec = (procData.execucao && procData.execucao[agrupamentoTempoAtual]) || [];
            fonteDadosTotal = (procData.total && procData.total[agrupamentoTempoAtual]) || [];
        }

        const datasets = [];

        if (metricaTempoAtual === 'ambos' || metricaTempoAtual === 'espera') {
            datasets.push({
                label: 'Tempo Médio de Espera (min)',
                data: fonteDadosEspera,
                borderColor: '#d97706',
                backgroundColor: isBar ? '#d97706' : (isArea ? 'rgba(217, 119, 6, 0.25)' : 'rgba(217, 119, 6, 0.05)'),
                fill: isArea,
                tension: 0.35,
                borderWidth: 2.5,
                borderRadius: isBar ? 5 : 0,
                pointRadius: isBar ? 0 : 3,
                pointHoverRadius: isBar ? 0 : 6
            });
        }

        if (metricaTempoAtual === 'ambos' || metricaTempoAtual === 'execucao') {
            datasets.push({
                label: 'Tempo Médio de Execução / Atendimento (min)',
                data: fonteDadosExec,
                borderColor: '#9333ea',
                backgroundColor: isBar ? '#9333ea' : (isArea ? 'rgba(147, 51, 234, 0.25)' : 'rgba(147, 51, 234, 0.05)'),
                fill: isArea,
                tension: 0.35,
                borderWidth: 2.5,
                borderRadius: isBar ? 5 : 0,
                pointRadius: isBar ? 0 : 3,
                pointHoverRadius: isBar ? 0 : 6
            });
        }

        if (metricaTempoAtual === 'total') {
            datasets.push({
                label: 'Tempo Total na Clínica (Permanência em min)',
                data: fonteDadosTotal,
                borderColor: '#0891b2',
                backgroundColor: isBar ? '#0891b2' : (isArea ? 'rgba(8, 145, 178, 0.25)' : 'rgba(8, 145, 178, 0.05)'),
                fill: isArea,
                tension: 0.35,
                borderWidth: 2.5,
                borderRadius: isBar ? 5 : 0,
                pointRadius: isBar ? 0 : 3,
                pointHoverRadius: isBar ? 0 : 6
            });
        }

        return datasets;
    }

    function renderizarGraficoTempos() {
        const ctxTempos = document.getElementById('graficoTemposEvolucao');
        if (!ctxTempos) return;

        const config = mapasAgrupamentos[agrupamentoTempoAtual] || mapasAgrupamentos.mes;
        const chartType = tipoGraficoTempoAtual === 'bar' ? 'bar' : 'line';

        // Atualizar mini KPIs do procedimento ativo
        const procSel = document.getElementById('seletorProcedimentoTempos')?.value || '__geral__';
        if (procSel === '__geral__') {
            document.getElementById('statTempoEsperaValor').textContent = '{{ dados.eficiencia.tempoMedioEsperaMin }} min';
            document.getElementById('statTempoExecucaoValor').textContent = '{{ dados.eficiencia.tempoMedioExecucaoMin }} min';
            document.getElementById('statTempoTotalValor').textContent = '{{ dados.eficiencia.tempoMedioPermanenciaMin }} min';
        } else {
            const item = tabelaTemposProcedimentos.find(t => t.nome === procSel);
            if (item) {
                document.getElementById('statTempoEsperaValor').textContent = item.mediaEsperaMin + ' min';
                document.getElementById('statTempoExecucaoValor').textContent = item.mediaExecucaoMin + ' min';
                document.getElementById('statTempoTotalValor').textContent = item.mediaPermanenciaMin + ' min';
            }
        }

        if (meuGraficoTempos) {
            meuGraficoTempos.destroy();
        }

        meuGraficoTempos = new Chart(ctxTempos, {
            type: chartType,
            data: {
                labels: config.labels,
                datasets: obterDatasetsTempos()
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            boxWidth: 12,
                            font: { size: 11, weight: 'bold' }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + context.parsed.y + ' minutos';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Minutos', font: { size: 10, weight: 'bold' } },
                        grid: { color: 'rgba(150, 150, 150, 0.08)' }
                    }
                }
            }
        });
    }

    function atualizarGraficoTempos() {
        renderizarGraficoTempos();
    }

    function selecionarProcedimentoNoGrafico(nomeProcedimento) {
        const sel = document.getElementById('seletorProcedimentoTempos');
        if (sel) {
            sel.value = nomeProcedimento;
            atualizarGraficoTempos();
        }
    }

    function alterarMetricaTempo(metrica) {
        metricaTempoAtual = metrica;
        ['Ambos', 'Espera', 'Execucao', 'Total'].forEach(m => {
            const btn = document.getElementById('btnMetricaTempo' + m);
            if (btn) {
                if (m.toLowerCase() === metrica) {
                    btn.className = "px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-amber-600 dark:text-amber-400 shadow-xs";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
                }
            }
        });
        renderizarGraficoTempos();
    }

    function alterarTipoGraficoTempo(tipo) {
        tipoGraficoTempoAtual = tipo;
        const tipos = { bar: 'btnTipoTempoBarra', line: 'btnTipoTempoLinha', area: 'btnTipoTempoArea' };
        Object.keys(tipos).forEach(t => {
            const btn = document.getElementById(tipos[t]);
            if (btn) {
                if (t === tipo) {
                    btn.className = "px-2 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-amber-600 dark:text-amber-400 shadow-xs";
                } else {
                    btn.className = "px-2 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
                }
            }
        });
        renderizarGraficoTempos();
    }

    function alterarAgrupamentoTempo(agrupamento) {
        agrupamentoTempoAtual = agrupamento;
        renderizarGraficoTempos();
    }

    // ==========================================
    // MÓDULO COMPARATIVO POR PROCEDIMENTO (CHIPS)
    // ==========================================
    function toggleLinhaProcedimento(index, btnEl) {
        if (!meuGraficoComparativo) return;
        const isHidden = !meuGraficoComparativo.isDatasetVisible(index);
        meuGraficoComparativo.setDatasetVisibility(index, isHidden);
        meuGraficoComparativo.update();

        if (isHidden) {
            btnEl.classList.remove('opacity-40', 'line-through');
            btnEl.classList.add('active-chip');
        } else {
            btnEl.classList.add('opacity-40', 'line-through');
            btnEl.classList.remove('active-chip');
        }
    }

    function atualizarAgrupamentoGraficoComparativo(modalidade) {
        if (!meuGraficoComparativo) return;
        const config = mapasAgrupamentos[modalidade] || mapasAgrupamentos.mes;
        meuGraficoComparativo.data.labels = config.labels;

        rawDatasetsProcedimentos.forEach((ds, idx) => {
            if (meuGraficoComparativo.data.datasets[idx]) {
                const arrVal = ds.series && ds.series[modalidade] ? ds.series[modalidade] : ds.data;
                meuGraficoComparativo.data.datasets[idx].data = arrVal;
            }
        });

        meuGraficoComparativo.update();
    }

    function marcarTodosProcedimentos(visivel) {
        if (!meuGraficoComparativo) return;
        rawDatasetsProcedimentos.forEach((_, idx) => {
            meuGraficoComparativo.setDatasetVisibility(idx, visivel);
            const btnEl = document.getElementById('chipProc_' + idx);
            if (btnEl) {
                if (visivel) {
                    btnEl.classList.remove('opacity-40', 'line-through');
                    btnEl.classList.add('active-chip');
                } else {
                    btnEl.classList.add('opacity-40', 'line-through');
                    btnEl.classList.remove('active-chip');
                }
            }
        });
        meuGraficoComparativo.update();
    }

    // ==========================================
    // MÓDULO DE EVOLUÇÃO TEMPORAL GERAL & PESSOAS
    // ==========================================
    function obterDatasetsEvolucao() {
        const isArea = tipoGraficoEvolucaoAtual === 'area';
        const isBar = tipoGraficoEvolucaoAtual === 'bar';
        const config = mapasAgrupamentos[agrupamentoEvolucaoAtual] || mapasAgrupamentos.mes;

        if (metricaEvolucaoAtual === 'pessoas') {
            return [{
                label: 'Pessoas Atendidas (Pacientes Únicos)',
                data: (seriesPessoas && seriesPessoas[agrupamentoEvolucaoAtual]) || [],
                borderColor: '#10b981',
                backgroundColor: isBar ? '#10b981' : (isArea ? 'rgba(16, 185, 129, 0.25)' : 'rgba(16, 185, 129, 0.05)'),
                borderWidth: 3,
                fill: isArea,
                tension: 0.35,
                borderRadius: isBar ? 6 : 0,
                pointRadius: isBar ? 0 : 3,
                pointHoverRadius: isBar ? 0 : 6
            }];
        } else if (metricaEvolucaoAtual === 'comparativo_pessoas') {
            return [
                {
                    label: 'Volume de Atendimentos / Exames',
                    data: config.data,
                    borderColor: '#0891b2',
                    backgroundColor: isBar ? '#0891b2' : (isArea ? 'rgba(8, 145, 178, 0.25)' : 'rgba(8, 145, 178, 0.05)'),
                    borderWidth: 2.5,
                    fill: isArea,
                    tension: 0.35,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                },
                {
                    label: 'Pessoas Atendidas (Pacientes Únicos)',
                    data: (seriesPessoas && seriesPessoas[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#10b981',
                    backgroundColor: isBar ? '#10b981' : (isArea ? 'rgba(16, 185, 129, 0.25)' : 'rgba(16, 185, 129, 0.05)'),
                    borderWidth: 2.5,
                    fill: isArea,
                    tension: 0.35,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                }
            ];
        } else if (metricaEvolucaoAtual === 'financiamento') {
            return [
                {
                    label: 'SUS',
                    data: (seriesFinanciamento.sus && seriesFinanciamento.sus[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#10b981',
                    backgroundColor: isBar ? '#10b981' : (isArea ? 'rgba(16, 185, 129, 0.25)' : 'rgba(16, 185, 129, 0.05)'),
                    fill: isArea,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                },
                {
                    label: 'Convênios & Particular',
                    data: (seriesFinanciamento.convenio && seriesFinanciamento.convenio[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#0284c7',
                    backgroundColor: isBar ? '#0284c7' : (isArea ? 'rgba(2, 132, 199, 0.25)' : 'rgba(2, 132, 199, 0.05)'),
                    fill: isArea,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                },
                {
                    label: 'Filantrópico',
                    data: (seriesFinanciamento.filantropico && seriesFinanciamento.filantropico[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#6366f1',
                    backgroundColor: isBar ? '#6366f1' : (isArea ? 'rgba(99, 102, 241, 0.25)' : 'rgba(99, 102, 241, 0.05)'),
                    fill: isArea,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                }
            ];
        } else if (metricaEvolucaoAtual === 'status') {
            return [
                {
                    label: 'Concluídos / Realizados',
                    data: (seriesStatus.finalizado && seriesStatus.finalizado[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#059669',
                    backgroundColor: isBar ? '#059669' : (isArea ? 'rgba(5, 150, 105, 0.25)' : 'rgba(5, 150, 105, 0.05)'),
                    fill: isArea,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                },
                {
                    label: 'Cancelados / Faltas',
                    data: (seriesStatus.cancelado && seriesStatus.cancelado[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#ef4444',
                    backgroundColor: isBar ? '#ef4444' : (isArea ? 'rgba(239, 68, 68, 0.25)' : 'rgba(239, 68, 68, 0.05)'),
                    fill: isArea,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                },
                {
                    label: 'Agendados / Em Aberto',
                    data: (seriesStatus.agendado && seriesStatus.agendado[agrupamentoEvolucaoAtual]) || [],
                    borderColor: '#f59e0b',
                    backgroundColor: isBar ? '#f59e0b' : (isArea ? 'rgba(245, 158, 11, 0.25)' : 'rgba(245, 158, 11, 0.05)'),
                    fill: isArea,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderRadius: isBar ? 6 : 0,
                    pointRadius: isBar ? 0 : 3,
                    pointHoverRadius: isBar ? 0 : 6
                }
            ];
        }

        // Padrão: Total Atendimentos
        return [{
            label: 'Total de Atendimentos',
            data: config.data,
            borderColor: '#0891b2',
            backgroundColor: isBar ? '#0891b2' : (isArea ? 'rgba(8, 145, 178, 0.25)' : 'rgba(8, 145, 178, 0.05)'),
            borderWidth: 3,
            fill: isArea,
            tension: 0.35,
            borderRadius: isBar ? 6 : 0,
            pointRadius: isBar ? 0 : 3,
            pointHoverRadius: isBar ? 0 : 6
        }];
    }

    function renderizarGraficoEvolucao() {
        const ctxLinha = document.getElementById('graficoEvolucaoTemporal');
        if (!ctxLinha) return;

        const config = mapasAgrupamentos[agrupamentoEvolucaoAtual] || mapasAgrupamentos.mes;
        const chartType = tipoGraficoEvolucaoAtual === 'bar' ? 'bar' : 'line';
        const showLegend = metricaEvolucaoAtual !== 'total' && metricaEvolucaoAtual !== 'pessoas';

        if (meuGraficoEvolucao) {
            meuGraficoEvolucao.destroy();
        }

        meuGraficoEvolucao = new Chart(ctxLinha, {
            type: chartType,
            data: {
                labels: config.labels,
                datasets: obterDatasetsEvolucao()
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: showLegend,
                        position: 'top',
                        labels: {
                            boxWidth: 12,
                            font: { size: 11, weight: 'bold' }
                        }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(150, 150, 150, 0.08)' }
                    }
                }
            }
        });
    }

    function alterarMetricaEvolucao(metrica) {
        metricaEvolucaoAtual = metrica;
        
        const metricas = {
            total: 'btnMetricaTotal',
            pessoas: 'btnMetricaPessoas',
            comparativo_pessoas: 'btnMetricaComparativoPessoas',
            financiamento: 'btnMetricaFinanciamento',
            status: 'btnMetricaStatus'
        };

        Object.keys(metricas).forEach(m => {
            const btn = document.getElementById(metricas[m]);
            if (btn) {
                if (m === metrica) {
                    btn.className = "px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-xs";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
                }
            }
        });
        renderizarGraficoEvolucao();
    }

    function alterarTipoGraficoEvolucao(tipo) {
        tipoGraficoEvolucaoAtual = tipo;
        const tipos = { line: 'btnTipoLinha', bar: 'btnTipoBarra', area: 'btnTipoArea' };
        Object.keys(tipos).forEach(t => {
            const btn = document.getElementById(tipos[t]);
            if (btn) {
                if (t === tipo) {
                    btn.className = "px-2 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-xs";
                } else {
                    btn.className = "px-2 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
                }
            }
        });
        renderizarGraficoEvolucao();
    }

    function alterarAgrupamentoEvolucao(agrupamento) {
        agrupamentoEvolucaoAtual = agrupamento;
        renderizarGraficoEvolucao();
    }

    // Inicialização de Todos os Gráficos
    document.addEventListener('DOMContentLoaded', function() {
        // 0. Gráfico Inteligente de Tempos de Espera e Execução
        renderizarGraficoTempos();

        // 1. Gráfico Inteligente Comparativo por Procedimento (Chips)
        const ctxComparativo = document.getElementById('graficoComparativoProcedimentos');
        if (ctxComparativo) {
            const chartDatasets = rawDatasetsProcedimentos.map(ds => ({
                label: ds.nome,
                data: ds.data,
                borderColor: ds.cor,
                backgroundColor: ds.cor + '15',
                borderWidth: 2,
                tension: 0.3,
                pointRadius: 2,
                pointHoverRadius: 5
            }));

            meuGraficoComparativo = new Chart(ctxComparativo, {
                type: 'line',
                data: {
                    labels: mesesLabels,
                    datasets: chartDatasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // 2. Gráfico de Evolução Temporal Geral & Pessoas
        renderizarGraficoEvolucao();

        // 3. Gráfico de Rosca (Financiamento)
        const ctxRosca = document.getElementById('graficoFinanciamentoRosca');
        if (ctxRosca) {
            new Chart(ctxRosca, {
                type: 'doughnut',
                data: {
                    labels: ['SUS', 'Filantrópico', 'Particular/Convênio'],
                    datasets: [{
                        data: [
                            {{ dados.financiamento.sus }},
                            {{ dados.financiamento.filantropico }},
                            {{ dados.financiamento.convenio }}
                        ],
                        backgroundColor: ['#10b981', '#6366f1', '#0284c7'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { size: 10 } } }
                    },
                    cutout: '70%'
                }
            });
        }

        // 4. Gráfico de Especialidades (Barras Horizontais)
        const ctxEsp = document.getElementById('graficoEspecialidadesBarra');
        if (ctxEsp) {
            const espObj = {{ dados.porEspecialidade|json_encode|raw }};
            const labelsEsp = Object.keys(espObj).slice(0, 8);
            const valsEsp = Object.values(espObj).slice(0, 8);

            new Chart(ctxEsp, {
                type: 'bar',
                data: {
                    labels: labelsEsp.map(l => l.length > 20 ? l.substring(0, 20) + '...' : l),
                    datasets: [{
                        label: 'Atendimentos',
                        data: valsEsp,
                        backgroundColor: '#6366f1',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { display: false } },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        // 5. Gráfico Fluxo por Dia da Semana (Barras)
        const ctxDias = document.getElementById('graficoDiasSemanaBarra');
        if (ctxDias) {
            const diasObj = {{ dados.porDiaSemana|json_encode|raw }};
            new Chart(ctxDias, {
                type: 'bar',
                data: {
                    labels: Object.keys(diasObj),
                    datasets: [{
                        label: 'Volume de Atendimentos',
                        data: Object.values(diasObj),
                        backgroundColor: ['#0891b2', '#0284c7', '#3b82f6', '#6366f1', '#8b5cf6', '#a855f7', '#ec4899'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, grid: { color: 'rgba(150, 150, 150, 0.08)' } }
                    }
                }
            });
        }

        // 6. Gráfico Faixas Horárias (Área / Linha)
        const ctxHoras = document.getElementById('graficoFaixasHorariasArea');
        if (ctxHoras) {
            const horasObj = {{ dados.porFaixaHoraria|json_encode|raw }};
            new Chart(ctxHoras, {
                type: 'line',
                data: {
                    labels: Object.keys(horasObj),
                    datasets: [{
                        label: 'Concentração de Atendimentos',
                        data: Object.values(horasObj),
                        borderColor: '#f43f5e',
                        backgroundColor: 'rgba(244, 63, 94, 0.15)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, grid: { color: 'rgba(150, 150, 150, 0.08)' } }
                    }
                }
            });
        }

        // 7. Gráfico Gênero (Rosca)
        const ctxGen = document.getElementById('graficoGeneroRosca');
        if (ctxGen) {
            const genObj = {{ dados.porGenero|json_encode|raw }};
            new Chart(ctxGen, {
                type: 'doughnut',
                data: {
                    labels: ['Masculino (M)', 'Feminino (F)', 'Não informado'],
                    datasets: [{
                        data: [genObj.M || 0, genObj.F || 0, genObj['NÃO INFORMADO'] || 0],
                        backgroundColor: ['#2563eb', '#db2777', '#94a3b8'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } },
                    cutout: '70%'
                }
            });
        }

        // 8. Gráfico Faixa Etária (Barras)
        const ctxFx = document.getElementById('graficoFaixaEtariaBarra');
        if (ctxFx) {
            const fxObj = {{ dados.porFaixaEtaria|json_encode|raw }};
            new Chart(ctxFx, {
                type: 'bar',
                data: {
                    labels: Object.keys(fxObj),
                    datasets: [{
                        label: 'Pacientes',
                        data: Object.values(fxObj),
                        backgroundColor: '#14b8a6',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 9 } } },
                        y: { beginAtZero: true, grid: { color: 'rgba(150, 150, 150, 0.08)' } }
                    }
                }
            });
        }

        // 9. Gráfico Top Convênios (Barras Horizontais)
        const ctxConv = document.getElementById('graficoTopConveniosBarra');
        if (ctxConv) {
            const convObj = {{ dados.porConvenio|json_encode|raw }};
            const labelsConv = Object.keys(convObj).slice(0, 6);
            const valsConv = Object.values(convObj).slice(0, 6);

            new Chart(ctxConv, {
                type: 'bar',
                data: {
                    labels: labelsConv.map(l => l.length > 18 ? l.substring(0, 18) + '...' : l),
                    datasets: [{
                        label: 'Atendimentos',
                        data: valsConv,
                        backgroundColor: '#0284c7',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { display: false } },
                        y: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        }
    });
</script>
{% endblock %}
