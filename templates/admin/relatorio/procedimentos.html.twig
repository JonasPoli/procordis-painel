{% extends 'admin/base.html.twig' %}

{% block title %}Relatório Consolidado de Procedimentos{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Cabeçalho do Relatório -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur">
        <div>
            <div class="flex items-center gap-2">
                <sl-icon name="bar-chart" class="text-cyan-500 text-2xl"></sl-icon>
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Relatório Consolidado de Procedimentos</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Análise temporal da quantidade de exames e consultas por período, distribuição SUS/Filantrópico e agrupamentos.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ path('app_admin_relatorio_procedimentos_csv', {'tipoPeriodo': 'sem_filtro'}) }}" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-sm transition">
                <sl-icon name="file-earmark-spreadsheet"></sl-icon> 1. Baixar Base Completa em CSV (Todos os Atendimentos)
            </a>
            <a href="{{ path('app_admin_relatorio_procedimentos_excel') }}" class="px-3.5 py-2 bg-green-700 hover:bg-green-800 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-sm transition">
                <sl-icon name="file-earmark-excel"></sl-icon> 2. Baixar Modelo Excel (8 Abas com Fórmulas)
            </a>
        </div>
    </div>

    <!-- Dica de Uso da Planilha Rápida -->
    <div class="bg-gradient-to-r from-cyan-50 to-emerald-50 dark:from-slate-900 dark:to-slate-800 p-3.5 rounded-2xl border border-cyan-200/60 dark:border-slate-700 text-xs flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs">
        <div class="flex items-start gap-2.5">
            <div class="p-1.5 bg-cyan-600 text-white rounded-lg mt-0.5">
                <sl-icon name="lightning-charge"></sl-icon>
            </div>
            <div>
                <span class="font-bold text-slate-900 dark:text-white block">Como utilizar o Modelo Excel com Fórmulas Integradas:</span>
                <span class="text-slate-600 dark:text-slate-300 text-[11px] leading-relaxed">
                    <strong>Passo 1:</strong> Clique em <em>"1. Baixar Dados em CSV"</em> para extrair a base completa. <br class="hidden sm:inline">
                    <strong>Passo 2:</strong> Baixe o <em>"2. Baixar Modelo Excel"</em> (abre instantaneamente). <br class="hidden sm:inline">
                    <strong>Passo 3:</strong> Abra o CSV, copie os registros e cole na aba <code>procedimentos</code> da planilha Excel. Todas as 7 abas analíticas (Evolução por Ano, Produtividade Médica, Convênios, Status, Horários de Pico, Demografia e KPIs) atualizarão sozinhas em tempo real!
                </span>
            </div>
        </div>
    </div>

    <!-- Filtro de Período Ampliado -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <form method="GET" action="{{ path('app_admin_relatorio_procedimentos') }}" class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Período:</label>
                <select name="tipoPeriodo" id="tipoPeriodoSelect" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none" onchange="toggleFiltroPeriodo()">
                    <option value="ultimos_6_meses" {% if dados.tipoPeriodo == 'ultimos_6_meses' %}selected{% endif %}>Últimos 6 Meses</option>
                    <option value="mes_especifico" {% if dados.tipoPeriodo == 'mes_especifico' %}selected{% endif %}>Mês Específico</option>
                    <option value="ano_especifico" {% if dados.tipoPeriodo == 'ano_especifico' %}selected{% endif %}>Por Ano Inteiro</option>
                    <option value="personalizado" {% if dados.tipoPeriodo == 'personalizado' %}selected{% endif %}>Período Personalizado (De / Até)</option>
                    <option value="sem_filtro" {% if dados.tipoPeriodo == 'sem_filtro' %}selected{% endif %}>Tudo (Sem filtro de data)</option>
                </select>
            </div>

            <!-- Seleção de Mês + Ano -->
            <div id="containerMesEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' %}hidden{% endif %}">
                <select name="mes" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for m in 1..12 %}
                        <option value="{{ m }}" {% if dados.mes == m %}selected{% endif %}>
                            {{ attribute(['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'], m-1) }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Seleção de Ano Inteiro -->
            <div id="containerAnoEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' and dados.tipoPeriodo != 'ano_especifico' %}hidden{% endif %}">
                <select name="ano" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for a in "now"|date("Y")..2005 %}
                        <option value="{{ a }}" {% if dados.ano == a %}selected{% endif %}>Ano {{ a }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Período Personalizado (Data Início / Data Fim) -->
            <div id="containerPersonalizado" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'personalizado' %}hidden{% endif %}">
                <input type="date" name="dataInicio" value="{{ dados.dataInicioCustom }}" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium">
                <span class="text-xs text-slate-400">até</span>
                <input type="date" name="dataFim" value="{{ dados.dataFimCustom }}" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium">
            </div>

            <button type="submit" class="px-4 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow-sm flex items-center gap-1">
                <sl-icon name="funnel-fill"></sl-icon> Filtrar Relatório
            </button>
        </form>
    </div>

    <!-- Cards de Indicadores (KPIs) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total de Procedimentos -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Procedimentos</span>
                <div class="h-8 w-8 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center">
                    <sl-icon name="layers-fill" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white mt-2">{{ dados.totalProcedimentos }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{{ dados.rotuloPeriodo }}</p>
        </div>

        <!-- Atendimentos SUS -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Pacientes SUS</span>
                <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                    <sl-icon name="heart-fill" class="text-lg"></sl-icon>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{{ dados.financiamento.sus }}</span>
                <span class="text-xs font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded-full">{{ dados.financiamento.pctSus }}%</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Sistema Único de Saúde</p>
        </div>

        <!-- Atendimentos Filantrópicos -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Filantrópicos</span>
                <div class="h-8 w-8 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center">
                    <sl-icon name="hand-thumbs-up-fill" class="text-lg"></sl-icon>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl font-black text-indigo-600 dark:text-indigo-400">{{ dados.financiamento.filantropico }}</span>
                <span class="text-xs font-bold bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 px-2 py-0.5 rounded-full">{{ dados.financiamento.pctFilantropico }}%</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Atendimento Isento Procordis</p>
        </div>

        <!-- Média Diária -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Média Diária</span>
                <div class="h-8 w-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center">
                    <sl-icon name="speedometer" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white mt-2">{{ dados.mediaDia }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Procedimentos / Dia Ativo</p>
        </div>
    </div>

    <!-- Gráfico Inteligente de Comparação por Procedimentos (Linhas Individuais com Liga/Desliga) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="sliders" class="text-cyan-500"></sl-icon> Gráfico Inteligente: Comparativo por Procedimento / Exame
                </h3>
                <p class="text-xs text-slate-500">Selecione abaixo quais exames deseja ligar ou desligar na visualização gráfica em linha ao longo dos meses</p>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-xl text-xs font-bold">
                    <span class="text-[10px] text-slate-400 px-1 uppercase">Agrupar gráfico:</span>
                    <select id="seletorAgrupamentoComparativo" onchange="atualizarAgrupamentoGraficoComparativo(this.value)" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-1 text-xs text-cyan-600 dark:text-cyan-400 font-bold focus:outline-none">
                        <option value="dia">Por Dia</option>
                        <option value="mes" selected>Por Mês</option>
                        <option value="trimestre">Por Trimestre</option>
                        <option value="quadrimestre">Por Quadrimestre</option>
                        <option value="semestre">Por Semestre</option>
                        <option value="ano">Por Ano</option>
                    </select>
                </div>

                <div class="flex items-center gap-1">
                    <button type="button" onclick="marcarTodosProcedimentos(true)" class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-300 font-bold rounded-lg text-[11px] transition">
                        Ligar Todos
                    </button>
                    <button type="button" onclick="marcarTodosProcedimentos(false)" class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-300 font-bold rounded-lg text-[11px] transition">
                        Desligar Todos
                    </button>
                </div>
            </div>
        </div>

        <!-- Chips de Procedimentos para Ativar / Desativar Linhas -->
        <div class="flex flex-wrap gap-2 max-h-36 overflow-y-auto p-1 bg-slate-50 dark:bg-slate-950/50 rounded-xl border border-slate-100 dark:border-slate-800" id="containerChipsProcedimentos">
            {% for dataset in dados.datasetsProcedimentos %}
                <button type="button" 
                        onclick="toggleLinhaProcedimento({{ loop.index0 }}, this)" 
                        id="chipProc_{{ loop.index0 }}"
                        class="px-2.5 py-1 rounded-lg font-bold text-xs flex items-center gap-1.5 transition border shadow-xs active-chip"
                        style="background-color: {{ dataset.cor }}20; color: {{ dataset.cor }}; border-color: {{ dataset.cor }}40;">
                    <span class="w-2.5 h-2.5 rounded-full inline-block" style="background-color: {{ dataset.cor }};"></span>
                    <span class="truncate max-w-[200px]">{{ dataset.nome }}</span>
                    <span class="opacity-70 font-mono text-[10px]">({{ dataset.total }})</span>
                </button>
            {% endfor %}
        </div>

        <div class="h-80 w-full">
            <canvas id="graficoComparativoProcedimentos"></canvas>
        </div>
    </div>

    <!-- Gráficos de Evolução e Composição -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Gráfico de Evolução Temporal (Linha) com Agrupamento Dinâmico -->
        <div class="lg:col-span-2 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Evolução Temporal Geral</h3>
                    <p class="text-xs text-slate-500">Volume total de atendimentos agregados</p>
                </div>
                
                <!-- Seletor de Agrupamento do Gráfico -->
                <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-xl text-xs font-bold">
                    <span class="text-[10px] text-slate-400 px-1 uppercase">Agrupar gráfico:</span>
                    <select id="seletorAgrupamentoGrafico" onchange="atualizarGraficoEvolucao(this.value)" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-1 text-xs text-cyan-600 dark:text-cyan-400 font-bold focus:outline-none">
                        <option value="dia">Por Dia</option>
                        <option value="mes" selected>Por Mês</option>
                        <option value="trimestre">Por Trimestre</option>
                        <option value="quadrimestre">Por Quadrimestre</option>
                        <option value="semestre">Por Semestre</option>
                        <option value="ano">Por Ano</option>
                    </select>
                </div>
            </div>

            <div class="h-64 w-full">
                <canvas id="graficoEvolucaoTemporal"></canvas>
            </div>
        </div>

        <!-- Gráfico de Rosca (Financiamento) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Composição de Convênios</h3>
                <p class="text-xs text-slate-500">Divisão SUS vs Filantropia vs Convênios</p>
            </div>
            <div class="h-56 w-full flex items-center justify-center">
                <canvas id="graficoFinanciamentoRosca"></canvas>
            </div>
            <div class="grid grid-cols-3 gap-1 text-center pt-3 border-t border-slate-100 dark:border-slate-800 text-[10px]">
                <div>
                    <span class="block font-bold text-emerald-600">SUS</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctSus }}%</span>
                </div>
                <div>
                    <span class="block font-bold text-indigo-600">Filantrópico</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctFilantropico }}%</span>
                </div>
                <div>
                    <span class="block font-bold text-sky-600">Convênios</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctConvenio }}%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos Adicionais: Top 10 Exames (Barras Horizontais) + Distribuição por Status (Pizza) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Top 10 Procedimentos e Exames Mais Realizados (Barras Horizontais) -->
        <div class="lg:col-span-2 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="mb-4">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="bar-chart-line" class="text-indigo-500"></sl-icon> Top Exames / Procedimentos Mais Demandados
                </h3>
                <p class="text-xs text-slate-500">Ranking dos 10 procedimentos com maior volume de realizações no período</p>
            </div>
            <div class="h-64 w-full">
                <canvas id="graficoTopProcedimentos"></canvas>
            </div>
        </div>

        <!-- Distribuição por Status de Atendimento (Pizza) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="pie-chart" class="text-emerald-500"></sl-icon> Status dos Agendamentos
                </h3>
                <p class="text-xs text-slate-500">Distribuição entre Agendados, Finalizados, Faltas e Cancelados</p>
            </div>
            <div class="h-56 w-full flex items-center justify-center">
                <canvas id="graficoStatusPizza"></canvas>
            </div>
        </div>
    </div>

    <!-- Tabelas Planilhadas por Intervalo (Dia / Mês / Trimestre / Quadrimestre / Semestre / Ano) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Tabelas Planilhadas por Intervalo Temporal</h3>
                <p class="text-xs text-slate-500">Visão estatística agregada de procedimentos & exames por Dia, Mês, Trimestre, Quadrimestre, Semestre e Ano</p>
            </div>

            <!-- Abas de Navegação das Tabelas -->
            <div class="flex flex-wrap items-center gap-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-xl text-xs font-bold">
                <button type="button" onclick="mostrarTabelaAgregada('dia')" id="btnTabDia" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Dia</button>
                <button type="button" onclick="mostrarTabelaAgregada('mes')" id="btnTabMes" class="px-2.5 py-1 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-sm">Por Mês</button>
                <button type="button" onclick="mostrarTabelaAgregada('trimestre')" id="btnTabTrimestre" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Trimestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('quadrimestre')" id="btnTabQuadrimestre" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Quadrimestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('semestre')" id="btnTabSemestre" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Semestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('ano')" id="btnTabAno" class="px-2.5 py-1 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Ano</button>
            </div>
        </div>

        <!-- Tabela por Dia -->
        <div id="tabConceitoDia" class="tabela-agregada-painel hidden">
            <div class="max-h-72 overflow-y-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500">
                        <tr>
                            <th class="py-2.5 px-3">Data</th>
                            <th class="py-2.5 px-3 text-right">Volume de Atendimentos</th>
                            <th class="py-2.5 px-3 text-right">Participação no Período</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for dia, count in dados.porDia %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-mono font-bold text-slate-800 dark:text-slate-200">{{ dia|date('d/m/Y') }}</td>
                                <td class="py-2 px-3 text-right font-mono font-black text-cyan-600 dark:text-cyan-400">{{ count }} procedimentos / exames</td>
                                <td class="py-2 px-3 text-right font-mono text-slate-500">
                                    {{ dados.totalProcedimentos > 0 ? ((count / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="py-4 text-center text-slate-400">Nenhum dado por dia no período.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabela por Mês -->
        <div id="tabConceitoMes" class="tabela-agregada-painel">
            <div class="max-h-72 overflow-y-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500">
                        <tr>
                            <th class="py-2.5 px-3">Mês / Ano</th>
                            <th class="py-2.5 px-3 text-right">Volume de Atendimentos</th>
                            <th class="py-2.5 px-3 text-right">Participação no Período</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
