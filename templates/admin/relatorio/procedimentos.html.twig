{% extends 'admin/base.html.twig' %}

{% block title %}Relatório Consolidado de Procedimentos{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Cabeçalho do Relatório -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur">
        <div>
            <div class="flex items-center gap-2">
                <sl-icon name="bar-chart" class="text-cyan-500 text-2xl"></sl-icon>
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Relatório Consolidado de Procedimentos</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Análise temporal da quantidade de exames e consultas por período, distribuição SUS/Filantrópico e agrupamentos.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a href="{{ path('app_admin_relatorio_procedimentos_csv', app.request.query.all) }}" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-sm transition">
                <sl-icon name="download"></sl-icon> Exportar CSV Completo
            </a>
        </div>
    </div>

    <!-- Filtro de Período Ampliado -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <form method="GET" action="{{ path('app_admin_relatorio_procedimentos') }}" class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Período:</label>
                <select name="tipoPeriodo" id="tipoPeriodoSelect" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none" onchange="toggleFiltroPeriodo()">
                    <option value="ultimos_6_meses" {% if dados.tipoPeriodo == 'ultimos_6_meses' %}selected{% endif %}>Últimos 6 Meses</option>
                    <option value="mes_especifico" {% if dados.tipoPeriodo == 'mes_especifico' %}selected{% endif %}>Mês Específico</option>
                    <option value="ano_especifico" {% if dados.tipoPeriodo == 'ano_especifico' %}selected{% endif %}>Por Ano Inteiro</option>
                    <option value="personalizado" {% if dados.tipoPeriodo == 'personalizado' %}selected{% endif %}>Período Personalizado (De / Até)</option>
                    <option value="sem_filtro" {% if dados.tipoPeriodo == 'sem_filtro' %}selected{% endif %}>Tudo (Sem filtro de data)</option>
                </select>
            </div>

            <!-- Seleção de Mês + Ano -->
            <div id="containerMesEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' %}hidden{% endif %}">
                <select name="mes" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for m in 1..12 %}
                        <option value="{{ m }}" {% if dados.mes == m %}selected{% endif %}>
                            {{ attribute(['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'], m-1) }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Seleção de Ano Inteiro -->
            <div id="containerAnoEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' and dados.tipoPeriodo != 'ano_especifico' %}hidden{% endif %}">
                <select name="ano" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for a in "now"|date("Y")..2005 %}
                        <option value="{{ a }}" {% if dados.ano == a %}selected{% endif %}>Ano {{ a }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Período Personalizado (Data Início / Data Fim) -->
            <div id="containerPersonalizado" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'personalizado' %}hidden{% endif %}">
                <input type="date" name="dataInicio" value="{{ dados.dataInicioCustom }}" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium">
                <span class="text-xs text-slate-400">até</span>
                <input type="date" name="dataFim" value="{{ dados.dataFimCustom }}" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium">
            </div>

            <button type="submit" class="px-4 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow-sm flex items-center gap-1">
                <sl-icon name="funnel-fill"></sl-icon> Filtrar Relatório
            </button>
        </form>
    </div>

    <!-- Cards de Indicadores (KPIs) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total de Procedimentos -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Procedimentos</span>
                <div class="h-8 w-8 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center">
                    <sl-icon name="layers-fill" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white mt-2">{{ dados.totalProcedimentos }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{{ dados.rotuloPeriodo }}</p>
        </div>

        <!-- Atendimentos SUS -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Pacientes SUS</span>
                <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                    <sl-icon name="heart-fill" class="text-lg"></sl-icon>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{{ dados.financiamento.sus }}</span>
                <span class="text-xs font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded-full">{{ dados.financiamento.pctSus }}%</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Sistema Único de Saúde</p>
        </div>

        <!-- Atendimentos Filantrópicos -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Filantrópicos</span>
                <div class="h-8 w-8 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center">
                    <sl-icon name="hand-thumbs-up-fill" class="text-lg"></sl-icon>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl font-black text-indigo-600 dark:text-indigo-400">{{ dados.financiamento.filantropico }}</span>
                <span class="text-xs font-bold bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 px-2 py-0.5 rounded-full">{{ dados.financiamento.pctFilantropico }}%</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Atendimento Isento Procordis</p>
        </div>

        <!-- Média Diária -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Média Diária</span>
                <div class="h-8 w-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center">
                    <sl-icon name="speedometer" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white mt-2">{{ dados.mediaDia }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Procedimentos / Dia Ativo</p>
        </div>
    </div>

    <!-- Gráficos de Evolução e Composição -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Gráfico de Evolução Temporal (Linha) -->
        <div class="lg:col-span-2 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Evolução Temporal de Atendimentos</h3>
                    <p class="text-xs text-slate-500">Volume de procedimentos e exames realizados no período selecionado</p>
                </div>
                <sl-badge variant="neutral" pill size="small">{{ dados.porDia|length }} dias com movimento</sl-badge>
            </div>
            <div class="h-64 w-full">
                <canvas id="graficoEvolucaoTemporal"></canvas>
            </div>
        </div>

        <!-- Gráfico de Rosca (Financiamento) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="mb-2">
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Composição de Convênios</h3>
                <p class="text-xs text-slate-500">Divisão SUS vs Filantropia vs Convênios</p>
            </div>
            <div class="h-56 w-full flex items-center justify-center">
                <canvas id="graficoFinanciamentoRosca"></canvas>
            </div>
            <div class="grid grid-cols-3 gap-1 text-center pt-3 border-t border-slate-100 dark:border-slate-800 text-[10px]">
                <div>
                    <span class="block font-bold text-emerald-600">SUS</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctSus }}%</span>
                </div>
                <div>
                    <span class="block font-bold text-indigo-600">Filantrópico</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctFilantropico }}%</span>
                </div>
                <div>
                    <span class="block font-bold text-sky-600">Convênios</span>
                    <span class="font-mono text-slate-500">{{ dados.financiamento.pctConvenio }}%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabelas Planilhadas por Intervalo (Dia / Mês / Semestre / Ano) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Tabelas Planilhadas por Intervalo Temporal</h3>
                <p class="text-xs text-slate-500">Visão estatística agregada de procedimentos & exames por Dia, Mês, Semestre e Ano</p>
            </div>

            <!-- Abas de Navegação das Tabelas -->
            <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-xl text-xs font-bold">
                <button type="button" onclick="mostrarTabelaAgregada('dia')" id="btnTabDia" class="px-3 py-1.5 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-sm">Por Dia</button>
                <button type="button" onclick="mostrarTabelaAgregada('mes')" id="btnTabMes" class="px-3 py-1.5 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Mês</button>
                <button type="button" onclick="mostrarTabelaAgregada('semestre')" id="btnTabSemestre" class="px-3 py-1.5 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Semestre</button>
                <button type="button" onclick="mostrarTabelaAgregada('ano')" id="btnTabAno" class="px-3 py-1.5 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900">Por Ano</button>
            </div>
        </div>

        <!-- Tabela por Dia -->
        <div id="tabConceitoDia" class="tabela-agregada-painel">
            <div class="max-h-72 overflow-y-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500">
                        <tr>
                            <th class="py-2.5 px-3">Data</th>
                            <th class="py-2.5 px-3 text-right">Volume de Atendimentos</th>
                            <th class="py-2.5 px-3 text-right">Participação no Período</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for dia, count in dados.porDia %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-mono font-bold text-slate-800 dark:text-slate-200">{{ dia|date('d/m/Y') }}</td>
                                <td class="py-2 px-3 text-right font-mono font-black text-cyan-600 dark:text-cyan-400">{{ count }} exames</td>
                                <td class="py-2 px-3 text-right font-mono text-slate-500">
                                    {{ dados.totalProcedimentos > 0 ? ((count / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="py-4 text-center text-slate-400">Nenhum dado por dia no período.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabela por Mês -->
        <div id="tabConceitoMes" class="tabela-agregada-painel hidden">
            <div class="max-h-72 overflow-y-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500">
                        <tr>
                            <th class="py-2.5 px-3">Mês / Ano</th>
                            <th class="py-2.5 px-3 text-right">Volume de Atendimentos</th>
                            <th class="py-2.5 px-3 text-right">Participação no Período</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for mesAno, count in dados.porMes %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-mono font-bold text-slate-800 dark:text-slate-200">{{ mesAno }}</td>
                                <td class="py-2 px-3 text-right font-mono font-black text-indigo-600 dark:text-indigo-400">{{ count }} exames</td>
                                <td class="py-2 px-3 text-right font-mono text-slate-500">
                                    {{ dados.totalProcedimentos > 0 ? ((count / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="py-4 text-center text-slate-400">Nenhum dado mensal.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabela por Semestre -->
        <div id="tabConceitoSemestre" class="tabela-agregada-painel hidden">
            <div class="max-h-72 overflow-y-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500">
                        <tr>
                            <th class="py-2.5 px-3">Semestre / Ano</th>
                            <th class="py-2.5 px-3 text-right">Volume de Atendimentos</th>
                            <th class="py-2.5 px-3 text-right">Participação no Período</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for sem, count in dados.porSemestre %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-mono font-bold text-slate-800 dark:text-slate-200">{{ sem }}</td>
                                <td class="py-2 px-3 text-right font-mono font-black text-emerald-600 dark:text-emerald-400">{{ count }} exames</td>
                                <td class="py-2 px-3 text-right font-mono text-slate-500">
                                    {{ dados.totalProcedimentos > 0 ? ((count / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="py-4 text-center text-slate-400">Nenhum dado por semestre.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabela por Ano -->
        <div id="tabConceitoAno" class="tabela-agregada-painel hidden">
            <div class="max-h-72 overflow-y-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 bg-slate-100 dark:bg-slate-950 font-bold uppercase text-slate-500">
                        <tr>
                            <th class="py-2.5 px-3">Ano</th>
                            <th class="py-2.5 px-3 text-right">Volume de Atendimentos</th>
                            <th class="py-2.5 px-3 text-right">Participação no Período</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {% for anoVal, count in dados.porAno %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                                <td class="py-2 px-3 font-mono font-bold text-slate-800 dark:text-slate-200">{{ anoVal }}</td>
                                <td class="py-2 px-3 text-right font-mono font-black text-amber-600 dark:text-amber-400">{{ count }} exames</td>
                                <td class="py-2 px-3 text-right font-mono text-slate-500">
                                    {{ dados.totalProcedimentos > 0 ? ((count / dados.totalProcedimentos) * 100)|number_format(1, ',', '.') : 0 }}%
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="py-4 text-center text-slate-400">Nenhum dado anual.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Ranking de Procedimentos e Especialidades -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-4">Procedimentos & Exames Mais Frequentes</h3>
            <div class="space-y-2.5 max-h-60 overflow-y-auto pr-2">
                {% for proc, count in dados.porProcedimento %}
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200/60 dark:border-slate-800">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{{ proc }}</span>
                        <span class="text-xs font-mono font-black text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950 border border-cyan-200 dark:border-cyan-800 px-2 py-0.5 rounded-lg">{{ count }} exames</span>
                    </div>
                {% else %}
                    <p class="text-xs text-slate-400">Nenhum registro no período.</p>
                {% endfor %}
            </div>
        </div>

        <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-4">Atendimentos por Especialidade</h3>
            <div class="space-y-2.5 max-h-60 overflow-y-auto pr-2">
                {% for esp, count in dados.porEspecialidade %}
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200/60 dark:border-slate-800">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{{ esp }}</span>
                        <span class="text-xs font-mono font-black text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 px-2 py-0.5 rounded-lg">{{ count }} consultas</span>
                    </div>
                {% else %}
                    <p class="text-xs text-slate-400">Nenhum registro no período.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Registros Analíticos do Período (Paginados de 100 em 100) -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Registros Analíticos do Período</h3>
                <p class="text-xs text-slate-500">Lista completa com paginação de 100 em 100 registros por página</p>
            </div>
            <span class="text-xs font-semibold text-slate-500">Total de {{ dados.totalItems }} registros</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-3 px-2">Data/Hora</th>
                        <th class="py-3 px-2">Paciente</th>
                        <th class="py-3 px-2">Procedimento</th>
                        <th class="py-3 px-2">Financiamento</th>
                        <th class="py-3 px-2">Médico</th>
                        <th class="py-3 px-2">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                    {% for ag in dados.agendamentosPaginados %}
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                            <td class="py-2.5 px-2 font-mono text-slate-700 dark:text-slate-300">
                                {{ ag.dataHoraAgendada ? ag.dataHoraAgendada|date('d/m/Y H:i') : '--' }}
                            </td>
                            <td class="py-2.5 px-2 font-bold text-slate-900 dark:text-white">
                                {{ ag.paciente ? ag.paciente.nomeCompleto : 'Paciente' }}
                            </td>
                            <td class="py-2.5 px-2 text-cyan-600 dark:text-cyan-400 font-medium">
                                {{ ag.procedimentoNome ?? 'Procedimento Geral' }}
                            </td>
                            <td class="py-2.5 px-2">
                                {% set t = ag.tipoAtendimento|default('sus') %}
                                {% if 'sus' in t %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">SUS</span>
                                {% elseif 'filantrop' in t %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Filantrópico</span>
                                {% else %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300">Convênio</span>
                                {% endif %}
                            </td>
                            <td class="py-2.5 px-2 text-slate-700 dark:text-slate-300">
                                {{ ag.medico ? ag.medico.nome : 'Não informado' }}
                            </td>
                            <td class="py-2.5 px-2">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                    {{ ag.status }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-4 text-center text-slate-400">Nenhum agendamento encontrado para o período selecionado.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Paginação de 100 em 100 -->
        {% if dados.totalPages > 1 %}
            <div class="p-4 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                <span class="text-slate-500">
                    Mostrando página <strong>{{ dados.page }}</strong> de <strong>{{ dados.totalPages }}</strong> (100 itens por página)
                </span>

                <div class="flex items-center gap-1">
                    {% if dados.page > 1 %}
                        <a href="{{ path('app_admin_relatorio_procedimentos', app.request.query.all|merge({'page': dados.page - 1})) }}" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-lg transition">
                            &laquo; Anterior
                        </a>
                    {% endif %}

                    {% set startP = max(1, dados.page - 2) %}
                    {% set endP = min(dados.totalPages, dados.page + 2) %}

                    {% for p in startP..endP %}
                        <a href="{{ path('app_admin_relatorio_procedimentos', app.request.query.all|merge({'page': p})) }}" class="px-3 py-1.5 font-bold rounded-lg transition {% if p == dados.page %}bg-cyan-600 text-white shadow-sm{% else %}bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700{% endif %}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if dados.page < dados.totalPages %}
                        <a href="{{ path('app_admin_relatorio_procedimentos', app.request.query.all|merge({'page': dados.page + 1})) }}" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-lg transition">
                            Próximo &raquo;
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
    function toggleFiltroPeriodo() {
        const select = document.getElementById('tipoPeriodoSelect');
        const containerMes = document.getElementById('containerMesEspecifico');
        const containerAno = document.getElementById('containerAnoEspecifico');
        const containerPersonalizado = document.getElementById('containerPersonalizado');

        const val = select.value;
        if (val === 'mes_especifico') {
            containerMes.classList.remove('hidden');
            containerAno.classList.remove('hidden');
            containerPersonalizado.classList.add('hidden');
        } else if (val === 'ano_especifico') {
            containerMes.classList.add('hidden');
            containerAno.classList.remove('hidden');
            containerPersonalizado.classList.add('hidden');
        } else if (val === 'personalizado') {
            containerMes.classList.add('hidden');
            containerAno.classList.add('hidden');
            containerPersonalizado.classList.remove('hidden');
        } else {
            containerMes.classList.add('hidden');
            containerAno.classList.add('hidden');
            containerPersonalizado.classList.add('hidden');
        }
    }

    function mostrarTabelaAgregada(aba) {
        document.querySelectorAll('.tabela-agregada-painel').forEach(el => el.classList.add('hidden'));
        document.getElementById('tabConceito' + aba.charAt(0).toUpperCase() + aba.slice(1)).classList.remove('hidden');

        ['Dia', 'Mes', 'Semestre', 'Ano'].forEach(item => {
            const btn = document.getElementById('btnTab' + item);
            if (item.toLowerCase() === aba) {
                btn.className = "px-3 py-1.5 rounded-lg transition bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-sm";
            } else {
                btn.className = "px-3 py-1.5 rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900";
            }
        });
    }

    // Inicialização dos Gráficos Chart.js
    document.addEventListener('DOMContentLoaded', function() {
        // 1. Gráfico de Evolução Temporal (Linha)
        const ctxLinha = document.getElementById('graficoEvolucaoTemporal');
        if (ctxLinha) {
            const diasLabels = {{ dados.porDiaKeys|json_encode|raw }};
            const diasData = {{ dados.porDiaValues|json_encode|raw }};

            new Chart(ctxLinha, {
                type: 'line',
                data: {
                    labels: diasLabels,
                    datasets: [{
                        label: 'Atendimentos Realizados',
                        data: diasData,
                        borderColor: '#0891b2',
                        backgroundColor: 'rgba(8, 145, 178, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // 2. Gráfico de Rosca (Financiamento)
        const ctxRosca = document.getElementById('graficoFinanciamentoRosca');
        if (ctxRosca) {
            new Chart(ctxRosca, {
                type: 'doughnut',
                data: {
                    labels: ['SUS', 'Filantrópico', 'Particular/Convênio'],
                    datasets: [{
                        data: [
                            {{ dados.financiamento.sus }},
                            {{ dados.financiamento.filantropico }},
                            {{ dados.financiamento.convenio }}
                        ],
                        backgroundColor: ['#10b981', '#6366f1', '#0284c7'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    },
                    cutout: '70%'
                }
            });
        }
    });
</script>
{% endblock %}
