{% extends 'admin/base.html.twig' %}

{% block title %}Relatório de Anamneses & Triagem{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Cabeçalho -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur">
        <div>
            <div class="flex items-center gap-2">
                <sl-icon name="heart-pulse" class="text-rose-500 text-2xl"></sl-icon>
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Relatório de Anamneses & Triagens</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Consolidação de anamneses clínicas, sinais vitais, classificação de risco e tempos de triagem por período.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a href="{{ path('app_admin_relatorio_anamneses_csv', {tipoPeriodo: dados.tipoPeriodo, ano: dados.ano, mes: dados.mes}) }}" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-sm transition">
                <sl-icon name="download"></sl-icon> Exportar CSV
            </a>
        </div>
    </div>

    <!-- Filtro de Período -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <form method="GET" action="{{ path('app_admin_relatorio_anamneses') }}" class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Período:</label>
                <select name="tipoPeriodo" id="tipoPeriodoSelect" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none" onchange="toggleFiltroMes()">
                    <option value="ultimos_6_meses" {% if dados.tipoPeriodo == 'ultimos_6_meses' %}selected{% endif %}>Últimos 6 Meses</option>
                    <option value="mes_especifico" {% if dados.tipoPeriodo == 'mes_especifico' %}selected{% endif %}>Mês Específico</option>
                </select>
            </div>

            <div id="containerMesEspecifico" class="flex items-center gap-2 {% if dados.tipoPeriodo != 'mes_especifico' %}hidden{% endif %}">
                <select name="mes" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    {% for m in 1..12 %}
                        <option value="{{ m }}" {% if dados.mes == m %}selected{% endif %}>
                            {{ attribute(['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'], m-1) }}
                        </option>
                    {% endfor %}
                </select>

                <select name="ano" class="bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-800 dark:text-slate-200 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    <option value="2026" {% if dados.ano == 2026 %}selected{% endif %}>2026</option>
                    <option value="2025" {% if dados.ano == 2025 %}selected{% endif %}>2025</option>
                </select>
            </div>

            <button type="submit" class="px-4 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow-sm">
                Filtrar Relatório
            </button>
        </form>
    </div>

    <!-- Cards de KPIs da Anamnese -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total de Anamneses -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Anamneses</span>
                <div class="h-8 w-8 rounded-lg bg-rose-500/10 text-rose-500 flex items-center justify-center">
                    <sl-icon name="journal-medical" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-900 dark:text-white mt-2">{{ dados.totalAnamneses }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{{ dados.rotuloPeriodo }}</p>
        </div>

        <!-- Casos Prioritários / Amarelo / Vermelho -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Risco Amarelo/Vermelho</span>
                <div class="h-8 w-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center">
                    <sl-icon name="exclamation-triangle" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-2">{{ dados.riscos.amarelo + dados.riscos.vermelho }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Classificação de Risco Elevado</p>
        </div>

        <!-- Tempo Médio de Triagem -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Tempo Médio Triagem</span>
                <div class="h-8 w-8 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center">
                    <sl-icon name="clock" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-cyan-600 dark:text-cyan-400 mt-2">{{ dados.tempoMedioTriagemMin }} min</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Duração da Anamnese de Enfermagem</p>
        </div>

        <!-- Casos Pouco Urgentes (Verde/Azul) -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Risco Verde/Azul</span>
                <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                    <sl-icon name="check-circle" class="text-lg"></sl-icon>
                </div>
            </div>
            <p class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-2">{{ dados.riscos.verde + dados.riscos.azul }}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Rotina / Habitual</p>
        </div>
    </div>

    <!-- Tabela de Anamneses e Triagens Realizadas -->
    <div class="bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Registros Clínicos de Triagem & Anamnese</h3>
            <span class="text-xs font-semibold text-slate-500">{{ dados.triagens|length }} anamneses listadas</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-3 px-2">Data/Hora</th>
                        <th class="py-3 px-2">Paciente</th>
                        <th class="py-3 px-2">Sinais Vitais (PA / FC / Peso)</th>
                        <th class="py-3 px-2">Classificação Risco</th>
                        <th class="py-3 px-2">Queixa Principal / Sintomas</th>
                        <th class="py-3 px-2">Responsável</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                    {% for t in dados.triagens %}
                        {% set ag = t.agendamento %}
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                            <td class="py-2.5 px-2 font-mono text-slate-700 dark:text-slate-300">
                                {{ t.dataHoraInicio ? t.dataHoraInicio|date('d/m/Y H:i') : '--' }}
                            </td>
                            <td class="py-2.5 px-2 font-bold text-slate-900 dark:text-white">
                                {{ (ag and ag.paciente) ? ag.paciente.nomeCompleto : 'Paciente' }}
                            </td>
                            <td class="py-2.5 px-2 font-mono text-slate-800 dark:text-slate-200">
                                PA: <strong class="text-cyan-600 dark:text-cyan-400">{{ t.pressaoArterial|default('120x80') }}</strong> | 
                                FC: <strong class="text-indigo-600 dark:text-indigo-400">{{ t.frequenciaCardiaca|default(75) }} bpm</strong> | 
                                Peso: <strong>{{ t.peso|default(70.0) }} kg</strong>
                            </td>
                            <td class="py-2.5 px-2">
                                {% set r = t.classificacaoRisco|default('verde') %}
                                {% if r == 'vermelho' %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">Vermelho (Emergência)</span>
                                {% elseif r == 'amarelo' %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300">Amarelo (Urgente)</span>
                                {% elseif r == 'azul' %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300">Azul (Não Urgente)</span>
                                {% else %}
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Verde (Habitual)</span>
                                {% endif %}
                            </td>
                            <td class="py-2.5 px-2 text-slate-700 dark:text-slate-300 italic max-w-xs truncate">
                                "{{ t.queixaPrincipal|default('Sem queixas específicas registradas.') }}"
                            </td>
                            <td class="py-2.5 px-2 text-slate-700 dark:text-slate-300 font-medium">
                                {{ t.responsavel|default('Enf. Responsável') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-4 text-center text-slate-400">Nenhuma anamnese registrada no período selecionado.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleFiltroMes() {
        const select = document.getElementById('tipoPeriodoSelect');
        const container = document.getElementById('containerMesEspecifico');
        if (select.value === 'mes_especifico') {
            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
        }
    }
</script>
{% endblock %}
