{% extends 'admin/base.html.twig' %}

{% block title %}Configurações de Integração Medware API{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto space-y-6">
    <!-- Status Bar -->
    <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full {{ config.statusConexao == 'conectado' ? 'bg-emerald-500 animate-pulse' : (config.statusConexao == 'modo_simulacao' ? 'bg-amber-500' : 'bg-rose-500') }}"></div>
            <div>
                <span class="text-xs uppercase font-bold text-slate-400">Status da Conexão</span>
                <p class="font-bold text-sm dark:text-white capitalize">{{ config.statusConexao|replace({'_': ' '}) }}</p>
            </div>
        </div>
        <div class="text-xs text-slate-500">
            Último sync: <strong class="dark:text-slate-200">{{ config.ultimoSyncEm ? config.ultimoSyncEm|date('d/m/Y H:i:s') : 'Nunca' }}</strong>
        </div>
        {% if not config.modoSimulacao %}
        <form method="post" class="inline">
            <input type="hidden" name="action" value="sync">
            <sl-button type="submit" variant="default" size="small">
                <sl-icon slot="prefix" name="arrow-repeat"></sl-icon>
                Sincronizar Agora
            </sl-button>
        </form>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Formulário de Credenciais API -->
        <div class="lg:col-span-2 space-y-6">
            <sl-card class="w-full">
                <div slot="header" class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <sl-icon name="gear" class="text-3xl text-cyan-500"></sl-icon>
                        <div>
                            <h2 class="text-xl font-bold dark:text-white">Integração API Medware</h2>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Conexão oficial com a API da Clínica Procordis (`api.procordis.org.br`)</p>
                        </div>
                    </div>
                </div>

                <form method="post" class="space-y-4">
                    <input type="hidden" name="action" value="save">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Endereço Base da API (Base URL)</label>
                        <input type="text" name="apiBaseUrl" value="{{ config.apiBaseUrl }}" required class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
                        <p class="text-[11px] text-slate-400 mt-1">Ex: <code>https://api.procordis.org.br/api</code> ou <code>https://api.procordis.org.br</code></p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Usuário API / Identificação</label>
                            <input type="text" name="apiUsuario" value="{{ config.apiUsuario }}" placeholder="Ex: agendamentoweb" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Senha de Acesso</label>
                            <input type="password" name="apiSenha" placeholder="••••••••" class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                        <div>
                            <p class="font-bold text-sm dark:text-slate-200">Fonte de Dados Ativa</p>
                            <p class="text-xs text-slate-500">Alterne entre simulação de testes e dados de produção reais da Medware.</p>
                        </div>
                        <select name="modoSimulacao" class="p-2 rounded-xl bg-white dark:bg-slate-950 border text-xs font-bold">
                            <option value="1" {% if config.modoSimulacao %}selected{% endif %}>Modo Simulador Local</option>
                            <option value="0" {% if not config.modoSimulacao %}selected{% endif %}>API Medware Real (Produção)</option>
                        </select>
                    </div>

                    <sl-button type="submit" variant="primary">
                        <sl-icon slot="prefix" name="save"></sl-icon>
                        Salvar e Conectar
                    </sl-button>
                </form>
            </sl-card>

            <!-- Card de Importação Histórica Completa via API -->
            <sl-card class="w-full">
                <div slot="header" class="flex items-center gap-3">
                    <sl-icon name="cloud-download" class="text-3xl text-indigo-500"></sl-icon>
                    <div>
                        <h2 class="text-xl font-bold dark:text-white">Importação Histórica Retroativa (API Medware)</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Abasteça o sistema novo com todo o histórico de exames, consultas, pacientes e triagens do sistema antigo.</p>
                    </div>
                </div>

                <form method="post" class="space-y-4">
                    <input type="hidden" name="action" value="import_history">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Data Inicial do Histórico</label>
                            <input type="date" name="dataInicio" value="{{ "now"|date_modify("-6 months")|date("Y-m-d") }}" required class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Data Final</label>
                            <input type="date" name="dataFim" value="{{ "now"|date("Y-m-d") }}" required class="w-full p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
                        </div>
                    </div>

                    <div class="p-3 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-xs text-indigo-700 dark:text-indigo-300">
                        <sl-icon name="info-circle" class="mr-1"></sl-icon>
                        A importação é realizada paginada dia a dia. Registros existentes serão atualizados e novos pacientes/procedimentos serão inseridos sem duplicação.
                    </div>

                    <sl-button type="submit" variant="success">
                        <sl-icon slot="prefix" name="download"></sl-icon>
                        Iniciar Carga Histórica da API
                    </sl-button>
                </form>
            </sl-card>
        </div>

        <!-- Logs de Sincronização -->
        <div class="space-y-6">
            <sl-card class="w-full">
                <div slot="header">
                    <h3 class="font-bold dark:text-white">Logs da API Medware</h3>
                </div>

                <div class="space-y-2 max-h-96 overflow-y-auto pr-1">
                    {% for l in logs %}
                        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-mono">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-cyan-500">{{ l.metodo }} {{ l.endpoint }}</span>
                                <sl-badge variant="{{ l.httpStatus == 200 ? 'success' : 'danger' }}" size="small">{{ l.httpStatus ?? 'ERR' }}</sl-badge>
                            </div>
                            <div class="flex items-center justify-between text-[10px] text-slate-400 mt-1">
                                <span>{{ l.dataHora|date("H:i:s") }} ({{ l.tempoRespostaMs }}ms)</span>
                                <span>{{ l.registrosProcessados }} iten(s)</span>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-center py-6 text-slate-400 text-xs">Nenhum log gravado ainda.</p>
                    {% endfor %}
                </div>
            </sl-card>
        </div>
    </div>
</div>
{% endblock %}
