{% extends 'admin/base.html.twig' %}

{% block title %}Backup & Restauração do Sistema{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Cabeçalho -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white/80 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur">
        <div>
            <div class="flex items-center gap-2">
                <sl-icon name="database-fill-down" class="text-cyan-500 text-2xl"></sl-icon>
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Central de Backup & Restauração</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gere cópias de segurança integrais do banco de dados ou restaure a partir de um arquivo.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button" onclick="executarDiagnosticoOnline()" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600 text-cyan-400 font-bold rounded-xl text-xs flex items-center gap-2 shadow transition">
                <sl-icon name="activity"></sl-icon> <span>Diagnóstico Online do Servidor</span>
            </button>
            <a href="{{ path('app_admin_backup_download') }}" data-turbo="false" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-md transition">
                <sl-icon name="download"></sl-icon> <span>Gerar & Baixar Backup Completo (.bak)</span>
            </a>
        </div>
    </div>

    <!-- Painel de Diagnóstico em Tempo Real (Expandível) -->
    <div id="painelDiagnostico" class="hidden bg-slate-900 text-slate-100 p-6 rounded-2xl border border-cyan-500/30 shadow-xl space-y-4 transition-all">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div class="flex items-center gap-2">
                <sl-icon name="cpu" class="text-cyan-400 text-xl"></sl-icon>
                <h3 class="text-base font-bold text-white">Resultado do Diagnóstico em Tempo Real (Servidor Online)</h3>
            </div>
            <button type="button" onclick="document.getElementById('painelDiagnostico').classList.add('hidden')" class="text-slate-400 hover:text-white text-xs">Fechar [x]</button>
        </div>

        <div id="diagLoading" class="text-center py-6">
            <sl-icon name="arrow-repeat" class="text-cyan-400 text-3xl animate-spin"></sl-icon>
            <p class="text-xs text-slate-400 mt-2 font-mono">Executando varredura de permissões, banco e teste de geração de backup...</p>
        </div>

        <div id="diagContent" class="hidden space-y-4 text-xs">
            <!-- Grid de Métricas -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Card 1: Ambiente PHP -->
                <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800 space-y-2">
                    <h4 class="font-bold text-cyan-400 flex items-center gap-1.5"><sl-icon name="gear"></sl-icon> Ambiente PHP</h4>
                    <div class="space-y-1 text-slate-300">
                        <div>Versão PHP: <span id="diagPhpVersion" class="font-mono text-emerald-400 font-bold"></span></div>
                        <div>Memory Limit: <span id="diagMemoryLimit" class="font-mono text-cyan-300"></span></div>
                        <div>Max Execution Time: <span id="diagMaxTime" class="font-mono text-cyan-300"></span></div>
                        <div>open_basedir: <span id="diagOpenBasedir" class="font-mono text-slate-400"></span></div>
                        <div>Extensão ZIP: <span id="diagExtZip" class="font-mono"></span></div>
                        <div>Extensão GZ/Zlib: <span id="diagExtGz" class="font-mono text-emerald-400 font-bold"></span></div>
                    </div>
                </div>

                <!-- Card 2: Permissões de Disco -->
                <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800 space-y-2">
                    <h4 class="font-bold text-emerald-400 flex items-center gap-1.5"><sl-icon name="folder-check"></sl-icon> Diretórios & Permissões</h4>
                    <div class="space-y-1 text-slate-300">
                        <div>Pasta <code>var/backup</code>: <span id="diagVarBackupStatus" class="font-bold"></span></div>
                        <div class="text-[11px] text-slate-500 break-all" id="diagVarBackupPath"></div>
                        <div class="mt-2">Pasta Temp Sistema: <span id="diagSysTempStatus" class="font-bold"></span></div>
                        <div class="text-[11px] text-slate-500 break-all" id="diagSysTempPath"></div>
                    </div>
                </div>

                <!-- Card 3: Teste de Backup em Tempo Real -->
                <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800 space-y-2">
                    <h4 class="font-bold text-amber-400 flex items-center gap-1.5"><sl-icon name="lightning-charge"></sl-icon> Teste Real de Geração</h4>
                    <div class="space-y-1 text-slate-300">
                        <div>Status do Teste: <span id="diagTesteStatus" class="font-bold"></span></div>
                        <div>Tempo de Geração: <span id="diagTesteTempo" class="font-mono text-cyan-300"></span></div>
                        <div>Pico de RAM: <span id="diagTesteRam" class="font-mono text-cyan-300"></span></div>
                        <div>Tamanho do Backup: <span id="diagTesteTamanho" class="font-mono text-emerald-400 font-bold"></span></div>
                    </div>
                </div>
            </div>

            <!-- Alerta de Erro se houver no teste -->
            <div id="diagAlertaErro" class="hidden p-3.5 rounded-xl bg-red-950/70 border border-red-500/50 text-red-300">
                <div class="font-bold text-red-200 flex items-center gap-2">
                    <sl-icon name="exclamation-octagon" class="text-red-400 text-base"></sl-icon> ERRO DETECTADO NA EXECUÇÃO:
                </div>
                <div id="diagErroTexto" class="mt-1 font-mono text-[11px] text-red-300 break-all"></div>
                <pre id="diagErroTrace" class="mt-2 p-2 bg-black/60 rounded text-[10px] text-red-400 max-h-40 overflow-y-auto font-mono"></pre>
            </div>

            <!-- Tabela de Registros Contabilizados no Banco -->
            <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800 space-y-2">
                <h4 class="font-bold text-slate-200 flex items-center gap-1.5"><sl-icon name="table"></sl-icon> Linhas Encontradas por Tabela</h4>
                <div id="diagTabelasGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2"></div>
            </div>

            <!-- Últimos Logs de Erro do Servidor -->
            <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800 space-y-2">
                <h4 class="font-bold text-slate-400 flex items-center gap-1.5"><sl-icon name="file-earmark-text"></sl-icon> Últimas Linhas de Erro dos Logs do Servidor</h4>
                <div id="diagLogsBox" class="p-2.5 bg-black/60 rounded-lg text-[11px] font-mono text-slate-400 max-h-36 overflow-y-auto space-y-1"></div>
            </div>
        </div>
    </div>

    <!-- Seção de Importação / Restauração -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Card 1: Gerar Backup -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                    <sl-icon name="cloud-arrow-down" class="text-xl"></sl-icon>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Exportação Completa (Snapshot)</h3>
                    <p class="text-xs text-slate-500">Empacota 100% das tabelas em formato comprimido seguro `.procordis.bak` com validação SHA-256.</p>
                </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 text-xs space-y-2">
                <p class="font-bold text-slate-700 dark:text-slate-300">Conteúdo do Pacote de Backup:</p>
                <ul class="list-disc list-inside text-slate-500 space-y-1">
                    <li>Logins Administrativos & Senhas Criptografadas (`User`)</li>
                    <li>Configurações de Integração API Medware</li>
                    <li>Pacientes, Médicos, Unidades & Especialidades</li>
                    <li>Agendamentos, Procedimentos, Financiamento SUS/Convênio</li>
                    <li>Fichas de Anamnese de Enfermagem & Sinais Vitais</li>
                    <li>Senhas de Atendimento & Telão de Chamadas (TV)</li>
                </ul>
            </div>

            <a href="{{ path('app_admin_backup_download') }}" data-turbo="false" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2">
                <sl-icon name="download"></sl-icon> <span>Baixar Snapshot do Sistema</span>
            </a>
        </div>

        <!-- Card 2: Restaurar Backup -->
        <div class="bg-white/80 dark:bg-slate-900/80 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-xl bg-cyan-500/10 text-cyan-500 flex items-center justify-center">
                    <sl-icon name="cloud-arrow-up" class="text-xl"></sl-icon>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Restauração / Importação</h3>
                    <p class="text-xs text-slate-500">Envie um arquivo `.procordis.bak` para restaurar o sistema integralmente.</p>
                </div>
            </div>

            <form method="POST" action="{{ path('app_admin_backup_restaurar') }}" enctype="multipart/form-data" data-turbo="false" class="space-y-4" onsubmit="return confirmarRestauracao(this)">
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Selecione o Arquivo de Backup (.bak)</label>
                    <input type="file" name="backupFile" accept=".bak,.json,.zip" required class="w-full p-2 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-xs">
                </div>

                <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-700 dark:text-amber-300 space-y-1">
                    <p class="font-bold">Modo de Substituição do Banco:</p>
                    <label class="flex items-center gap-2 mt-1">
                        <input type="radio" name="modoLimpo" value="1" checked class="text-cyan-600 focus:ring-cyan-500">
                        <span><strong>Restauração Limpa (Recomendado)</strong>: Substituição total e idêntica ao backup</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="radio" name="modoLimpo" value="0" class="text-cyan-600 focus:ring-cyan-500">
                        <span><strong>Restauração Incremental (Merge)</strong>: Mantém dados atuais e mescla registros</span>
                    </label>
                </div>

                <button type="submit" id="btnRestaurarSubmit" class="w-full py-2.5 px-4 bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2">
                    <sl-icon name="upload"></sl-icon> <span>Restaurar Sistema Agora</span>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function confirmarRestauracao(form) {
        if (confirm("ATENÇÃO: A restauração substituirá os dados atuais pelo conteúdo do arquivo de backup.\n\nDeseja realmente prosseguir?")) {
            const btn = document.getElementById('btnRestaurarSubmit');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<sl-icon name="arrow-repeat" class="animate-spin"></sl-icon> <span>Restaurando banco de dados... (aguarde)</span>';
            }
            return true;
        }
        return false;
    }

    async function executarDiagnosticoOnline() {
        const painel = document.getElementById('painelDiagnostico');
        const loading = document.getElementById('diagLoading');
        const content = document.getElementById('diagContent');
        const alertaErro = document.getElementById('diagAlertaErro');

        painel.classList.remove('hidden');
        loading.classList.remove('hidden');
        content.classList.add('hidden');
        alertaErro.classList.add('hidden');

        try {
            const res = await fetch('{{ path("app_admin_backup_diagnostico_api") }}');
            const rawText = await res.text();

            let data;
            try {
                data = JSON.parse(rawText);
            } catch (jsonErr) {
                loading.classList.add('hidden');
                alertaErro.classList.remove('hidden');
                document.getElementById('diagErroTexto').innerHTML = '<strong>O servidor retornou uma mensagem HTML/PHP em vez de JSON:</strong><div class="mt-2 p-3 bg-black/80 rounded border border-red-500/40 text-red-300 font-mono text-xs overflow-x-auto">' + rawText + '</div>';
                content.classList.remove('hidden');
                return;
            }

            if (data.sucesso === false) {
                loading.classList.add('hidden');
                alertaErro.classList.remove('hidden');
                document.getElementById('diagErroTexto').textContent = data.erro || 'Erro não especificado retornado pelo servidor.';
                document.getElementById('diagErroTrace').textContent = data.trace || '';
                content.classList.remove('hidden');
                return;
            }

            // 1. Preencher Ambiente
            document.getElementById('diagPhpVersion').textContent = data.ambiente.php_version + ' (' + data.ambiente.sapi + ')';
            document.getElementById('diagMemoryLimit').textContent = data.ambiente.memory_limit;
            document.getElementById('diagMaxTime').textContent = data.ambiente.max_execution_time + 's';
            document.getElementById('diagOpenBasedir').textContent = data.ambiente.open_basedir;
            document.getElementById('diagExtZip').textContent = data.ambiente.extensoes.zip;
            document.getElementById('diagExtGz').textContent = data.ambiente.extensoes.zlib_gz;

            // 2. Preencher Pastas
            const varBkp = data.pastas.var_backup;
            document.getElementById('diagVarBackupStatus').innerHTML = varBkp.gravavel ? '<span class="text-emerald-400">Gravável [OK]</span>' : '<span class="text-red-400">Sem Permissão</span>';
            document.getElementById('diagVarBackupPath').textContent = varBkp.caminho;

            const sysTemp = data.pastas.sys_temp;
            document.getElementById('diagSysTempStatus').innerHTML = sysTemp.gravavel ? '<span class="text-emerald-400">Gravável [OK]</span>' : '<span class="text-red-400">Sem Permissão</span>';
            document.getElementById('diagSysTempPath').textContent = sysTemp.caminho;

            // 3. Preencher Teste de Geração
            const teste = data.teste_geracao;
            if (teste.sucesso) {
                document.getElementById('diagTesteStatus').innerHTML = '<span class="text-emerald-400">Sucesso Absoluto (100% OK)</span>';
                document.getElementById('diagTesteTempo').textContent = teste.tempo_ms + ' ms';
                document.getElementById('diagTesteRam').textContent = teste.memoria_pico_mb + ' MB';
                document.getElementById('diagTesteTamanho').textContent = teste.tamanho_formatado;
            } else {
                document.getElementById('diagTesteStatus').innerHTML = '<span class="text-red-400">Falha no Teste</span>';
                alertaErro.classList.remove('hidden');
                document.getElementById('diagErroTexto').textContent = teste.erro || 'Erro desconhecido';
                document.getElementById('diagErroTrace').textContent = teste.trace || '';
            }

            // 4. Preencher Tabelas
            const grid = document.getElementById('diagTabelasGrid');
            grid.innerHTML = '';
            for (const [tabela, info] of Object.entries(data.tabelas)) {
                const el = document.createElement('div');
                el.className = 'p-2 rounded bg-slate-900 border border-slate-800 text-center';
                el.innerHTML = `<div class="text-[10px] text-slate-400 truncate" title="${tabela}">${tabela}</div><div class="font-bold text-cyan-300">${info.total.toLocaleString()}</div>`;
                grid.appendChild(el);
            }

            // 5. Preencher Logs
            const logsBox = document.getElementById('diagLogsBox');
            if (data.ultimos_logs_erro && data.ultimos_logs_erro.length > 0) {
                logsBox.innerHTML = data.ultimos_logs_erro.map(l => `<div class="text-red-400 border-b border-slate-800 pb-0.5">${l}</div>`).join('');
            } else {
                logsBox.innerHTML = '<div class="text-emerald-400">Nenhum log crítico de erro recente encontrado.</div>';
            }

            loading.classList.add('hidden');
            content.classList.remove('hidden');
        } catch (err) {
            loading.classList.add('hidden');
            alertaErro.classList.remove('hidden');
            document.getElementById('diagErroTexto').textContent = 'Erro ao processar diagnóstico: ' + err.message;
            content.classList.remove('hidden');
        }
    }
</script>
{% endblock %}
