{% extends 'pub/base.html.twig' %}

{% block title %}Entrar | Procordis Administração{% endblock %}

{% block body %}
<div class="h-full w-full flex items-center justify-center p-4">
    <div class="w-full max-w-md p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-6 relative overflow-hidden">
        
        <!-- Glow top accent -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Logo e Cabeçalho -->
        <div class="text-center space-y-3">
            <div class="inline-block p-3 rounded-2xl bg-white shadow-sm border border-slate-200/80">
                <img src="/images/logo-A3qBa0m.svg" alt="Procordis Medicina Diagnóstica" class="h-12 w-auto mx-auto max-w-[220px]">
            </div>
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-800 dark:text-white">Acesso Administrativo</h1>
                <p class="text-xs text-slate-400">Entre com suas credenciais para gerenciar os painéis e integrações.</p>
            </div>
        </div>

        {% if error %}
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-xs font-semibold text-center">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="p-3.5 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 text-xs font-semibold text-center">
                Você já está autenticado como <strong>{{ app.user.userIdentifier }}</strong>. 
                <a href="{{ path('app_logout') }}" class="underline font-bold ml-1">Sair</a>
            </div>
        {% endif %}

        <!-- Formulário de Login -->
        <form method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5" for="username">
                    Usuário
                </label>
                <input class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white text-sm outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition" type="text" value="{{ last_username }}" name="_username" id="username" autocomplete="username" required autofocus placeholder="admin">
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5" for="password">
                    Senha
                </label>
                <input class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white text-sm outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition" type="password" name="_password" id="password" autocomplete="current-password" required placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="w-full py-3 rounded-xl font-extrabold text-sm text-slate-950 bg-gradient-to-r from-cyan-400 to-cyan-500 hover:from-cyan-300 hover:to-cyan-400 shadow-lg shadow-cyan-500/25 active:scale-[0.98] transition cursor-pointer" type="submit">
                Entrar no Painel
            </button>
        </form>

        <div class="text-center pt-2 border-t border-slate-100 dark:border-slate-800/80">
            <a href="/painel/espera" class="text-xs text-cyan-600 dark:text-cyan-400 hover:underline font-semibold">
                &larr; Voltar para os Painéis Visuais
            </a>
        </div>
    </div>
</div>
{% endblock %}
