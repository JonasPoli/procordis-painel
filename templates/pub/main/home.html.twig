{% extends 'pub/base.html.twig' %}

{% block title %}Procordis · Hub Central de Painéis e Atendimento{% endblock %}

{% block body %}
<div class="w-full max-w-7xl mx-auto space-y-8 sm:space-y-10 py-2 sm:py-4">

    <!-- Flash Messages (Alertas de Envio de Contato) -->
    {% for msg in app.flashes('contact_s') %}
        <sl-alert variant="success" open class="mb-4 shadow-lg rounded-2xl overflow-hidden border border-emerald-500/30">
            <sl-icon slot="icon" name="check-circle"></sl-icon>
            <span class="font-medium text-emerald-800 dark:text-emerald-300">{{ msg }}</span>
        </sl-alert>
    {% endfor %}
    {% for msg in app.flashes('contact_f') %}
        <sl-alert variant="danger" open class="mb-4 shadow-lg rounded-2xl overflow-hidden border border-rose-500/30">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <span class="font-medium text-rose-800 dark:text-rose-300">{{ msg }}</span>
        </sl-alert>
    {% endfor %}

    <!-- HERO SECTION INSTITUCIONAL & OPERACIONAL -->
    <section class="relative isolate overflow-hidden rounded-3xl bg-white/95 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800/80 p-6 sm:p-8 lg:p-12 shadow-xl shadow-slate-900/5 backdrop-blur-xl transition-all duration-300">
        <!-- Glows de Fundo Cardiológico / Moderno -->
        <div class="absolute -top-24 -right-24 -z-10 w-96 h-96 rounded-full bg-gradient-to-br from-cyan-400/20 via-sky-300/10 to-transparent blur-3xl dark:from-cyan-500/25 dark:via-indigo-500/15 pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 -z-10 w-96 h-96 rounded-full bg-gradient-to-tr from-indigo-400/15 via-rose-300/10 to-transparent blur-3xl dark:from-indigo-600/20 dark:via-rose-500/10 pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
            <div class="max-w-3xl space-y-4">
                <!-- Badges de Identificação -->
                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 dark:bg-cyan-500/15 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 text-xs font-bold uppercase tracking-wider">
                        <span class="h-2 w-2 rounded-full bg-cyan-500 animate-pulse"></span>
                        Associação Procordis
                    </span>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-semibold">
                        📍 Araraquara - SP
                    </span>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
                        ● Operacional 07h às 18h
                    </span>
                </div>

                <!-- Título Principal -->
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
                    Central de Gestão e <br class="hidden sm:inline">
                    <span class="bg-gradient-to-r from-cyan-600 via-sky-500 to-indigo-600 dark:from-cyan-400 dark:via-sky-300 dark:to-indigo-300 bg-clip-text text-transparent">
                        Painéis de Atendimento
                    </span>
                </h1>

                <!-- Descrição da Função da Plataforma -->
                <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
                    Hub integrado de controle da jornada do paciente da <strong>Procordis Cardiologia & Medicina Diagnóstica</strong>. Gerencie o fluxo em tempo real: desde a emissão e chamada de senhas no telão, triagem de enfermagem, acompanhamento dos consultórios médicos até métricas e relatórios de SLA.
                </p>

                <!-- Ações Rápidas de Destaque -->
                <div class="pt-2 flex flex-wrap items-center gap-3">
                    <a href="/painel/chamada" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-cyan-600/25 transition active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Abrir Telão TV</span>
                    </a>
                    <a href="/painel/espera" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-white font-bold text-xs sm:text-sm border border-slate-200 dark:border-slate-700 transition active:scale-95">
                        <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>Fila de Espera</span>
                    </a>
                    <a href="/painel/dashboard" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-white font-bold text-xs sm:text-sm border border-slate-200 dark:border-slate-700 transition active:scale-95">
                        <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        <span>Dashboard</span>
                    </a>
                </div>
            </div>

            <!-- Mini Cartão com Indicadores Institucionais da Procordis -->
            <div class="w-full lg:w-80 shrink-0 bg-slate-50/90 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800/80 p-5 rounded-2xl space-y-3.5 shadow-sm">
                <div class="p-3 bg-white rounded-xl shadow-sm border border-slate-200/80 flex items-center justify-center">
                    <img src="/images/logo-A3qBa0m.svg" alt="Associação Procordis" class="h-9 w-auto max-w-[200px] object-contain">
                </div>
                <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Dados da Clínica</span>
                    <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                </div>
                
                <div class="space-y-2.5 text-xs text-slate-600 dark:text-slate-300">
                    <div class="flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-cyan-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-white">Endereço:</p>
                            <p>Av. Queiroz Filho, 685 - Vila Sedenho, Araraquara - SP</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-cyan-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-white">Telefone:</p>
                            <a href="tel:1633974625" class="text-cyan-600 dark:text-cyan-400 font-bold hover:underline">(16) 3397-4625</a>
                        </div>
                    </div>

                    <div class="flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-cyan-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-white">E-mail Oficial:</p>
                            <a href="mailto:secretaria@procordis.org.br" class="text-cyan-600 dark:text-cyan-400 font-medium hover:underline break-all">secretaria@procordis.org.br</a>
                        </div>
                    </div>
                </div>

                <div class="pt-2 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 font-medium">
                    <span>Portal Institucional:</span>
                    <a href="https://procordis.org.br/" target="_blank" rel="noopener noreferrer" class="text-cyan-600 dark:text-cyan-400 font-bold hover:underline flex items-center gap-1">
                        procordis.org.br
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- SEÇÃO DOS CARDS: TODOS OS PAINÉIS DO SISTEMA -->
    <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                    <span class="h-3.5 w-1.5 rounded-full bg-cyan-500"></span>
                    Painéis de Atendimento e Módulos Operacionais
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                    Selecione o painel correspondente ao seu setor ou terminal de trabalho:
                </p>
            </div>
            <span class="text-xs font-mono font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-900 px-3 py-1 rounded-xl border border-slate-200 dark:border-slate-800 self-start sm:self-auto">
                8 Módulos Ativos
            </span>
        </div>

        <!-- Grade de Cards (2 colunas em tablets, 4 colunas em desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">

            <!-- CARD 01: Pré-Atendimento (SLA) -->
            <a href="/painel/aguardando" class="group relative flex flex-col justify-between rounded-3xl bg-white/90 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 p-5 shadow-sm hover:shadow-xl hover:border-cyan-500/50 dark:hover:border-cyan-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/5 rounded-bl-full pointer-events-none group-hover:bg-cyan-500/10 transition-colors"></div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="h-11 w-11 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-600 dark:text-cyan-400 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <span class="text-[10px] font-mono font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-md">
                            01. SLA
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Recepção & Triagem</span>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mt-0.5">
                            Pré-Atendimento (SLA)
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 line-clamp-3 leading-relaxed">
                            Monitoramento de senhas emitidas, tempo de espera até o guichê e conformidade de tempo na recepção.
                        </p>
                    </div>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-bold text-cyan-600 dark:text-cyan-400">
                    <span>Acessar Painel</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
            </a>

            <!-- CARD 02: Pós-Atendimento (Finalizados) -->
            <a href="/painel/finalizados" class="group relative flex flex-col justify-between rounded-3xl bg-white/90 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 p-5 shadow-sm hover:shadow-xl hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-bl-full pointer-events-none group-hover:bg-emerald-500/10 transition-colors"></div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="h-11 w-11 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <span class="text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md">
                            02. Finalizados
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Histórico & Saída</span>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mt-0.5">
                            Pós-Atendimento
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 line-clamp-3 leading-relaxed">
                            Histórico analítico dos pacientes atendidos, tempos totais de permanência e gráficos de produtividade diária.
                        </p>
                    </div>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-bold text-emerald-600 dark:text-emerald-400">
                    <span>Acessar Painel</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
            </a>

            <!-- CARD 03: Fila de Espera Geral -->
            <a href="/painel/espera" class="group relative flex flex-col justify-between rounded-3xl bg-white/90 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 p-5 shadow-sm hover:shadow-xl hover:border-sky-500/50 dark:hover:border-sky-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-sky-500/5 rounded-bl-full pointer-events-none group-hover:bg-sky-500/10 transition-colors"></div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="h-11 w-11 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        </div>
                        <span class="text-[10px] font-mono font-bold text-sky-600 dark:text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded-md">
                            03. Fila
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Salas de Espera</span>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mt-0.5">
                            Fila de Espera Geral
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 line-clamp-3 leading-relaxed">
                            Visualização em tempo real dos pacientes aguardando chamada com filtros por médico e alerta de maior espera.
                        </p>
                    </div>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-bold text-sky-600 dark:text-sky-400">
                    <span>Acessar Painel</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
            </a>

            <!-- CARD 04: Telão de Chamada TV -->
            <a href="/painel/chamada" class="group relative flex flex-col justify-between rounded-3xl bg-white/90 dark:bg-slate-900/80 border-2 border-cyan-500/30 p-5 shadow-md hover:shadow-2xl hover:border-cyan-500 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/10 rounded-bl-full pointer-events-none group-hover:bg-cyan-500/20 transition-colors"></div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="h-11 w-11 rounded-2xl bg-cyan-500 text-slate-950 flex items-center justify-center group-hover:scale-110 shadow-lg shadow-cyan-500/30 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        </div>
                        <span class="text-[10px] font-mono font-bold text-slate-950 bg-cyan-400 px-2 py-0.5 rounded-md uppercase">
                            04. Smart TV
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400">Recepção & TVs</span>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mt-0.5">
                            Telão de Chamada TV
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 line-clamp-3 leading-relaxed">
                            Exibição visual com aviso sonoro (chime) para chamada de senhas, nomes, consultórios e médicos.
                        </p>
                    </div>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-bold text-cyan-600 dark:text-cyan-400">
                    <span>Abrir Modo TV</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
            </a>

            <!-- CARD 05: Médicos & Salas -->
            <a href="/painel/medicos" class="group relative flex flex-col justify-between rounded-3xl bg-white/90 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 p-5 shadow-sm hover:shadow-xl hover:border-indigo-500/50 dark:hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-indigo-500/5 rounded-bl-full pointer-events-none group-hover:bg-indigo-500/10 transition-colors"></div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="h-11 w-11 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </div>
                        <span class="text-[10px] font-mono font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded-md">
                            05. Médicos
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Corpo Clínico</span>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mt-0.5">
                            Médicos & Consultórios
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 line-clamp-3 leading-relaxed">
                            Status ao vivo de cada cardiologista e sala (Disponível, Em Atendimento, Pausa) e paciente atual.
                        </p>
