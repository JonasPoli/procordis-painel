{% extends 'pub/base.html.twig' %}

{% block title %}Painel de Triagem | Procordis{% endblock %}

{% block body %}
<div class="h-full w-full grid grid-cols-1 lg:grid-cols-2 gap-[1vw] overflow-hidden">
    <!-- Fila de Espera para Triagem -->
    <div class="h-full bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-[1.2vw] shadow-md flex flex-col justify-between overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-[1vh] mb-[1vh] shrink-0">
            <div>
                <h2 class="text-[1.1vw] font-bold text-slate-900 dark:text-white">Aguardando Triagem</h2>
                <p class="text-[0.7vw] text-slate-500 dark:text-slate-400">Pacientes que emitiram senha na recepção</p>
            </div>
            <span id="total-aguardando" class="text-[1.2vw] font-mono font-bold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 border border-amber-300 dark:border-amber-800 px-[0.6vw] py-[0.2vh] rounded-lg">0</span>
        </div>

        <div id="lista-aguardando-triagem" class="space-y-[0.8vh] overflow-y-auto flex-1 pr-[0.3vw]">
            <p class="text-center py-[5vh] text-slate-400 text-[0.8vw]">Carregando...</p>
        </div>
    </div>

    <!-- Em Triagem Ativa -->
    <div class="h-full bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-[1.2vw] shadow-md flex flex-col justify-between overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-[1vh] mb-[1vh] shrink-0">
            <div>
                <h2 class="text-[1.1vw] font-bold text-slate-900 dark:text-white">Em Triagem / Anamnese</h2>
                <p class="text-[0.7vw] text-slate-500 dark:text-slate-400">Pacientes em pré-atendimento com a enfermagem</p>
            </div>
            <span id="total-em-triagem" class="text-[1.2vw] font-mono font-bold text-sky-700 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/60 border border-sky-300 dark:border-sky-800 px-[0.6vw] py-[0.2vh] rounded-lg">0</span>
        </div>

        <div id="lista-em-triagem" class="space-y-[0.8vh] overflow-y-auto flex-1 pr-[0.3vw]">
            <p class="text-center py-[5vh] text-slate-400 text-[0.8vw]">Carregando...</p>
        </div>
    </div>
</div>

<script>
    async function carregarTriagem() {
        try {
            const res = await fetch('/api/v1/painel/triagem');
            const data = await res.json();

            if (data.sucesso) {
                document.getElementById('total-aguardando').innerText = data.totalFilaTriagem;
                document.getElementById('total-em-triagem').innerText = data.totalEmTriagem;

                renderizarLista('lista-aguardando-triagem', data.filaTriagem, 'amber');
                renderizarLista('lista-em-triagem', data.emTriagem, 'sky');
            }
        } catch (e) {
            console.error("Erro ao carregar triagem:", e);
        }
    }

    function renderizarLista(containerId, lista, cor) {
        const container = document.getElementById(containerId);
        if (!lista || lista.length === 0) {
            container.innerHTML = `<p class="text-center py-[5vh] text-slate-400 text-[0.8vw] font-medium">Nenhum paciente nesta fila no momento</p>`;
            return;
        }

        container.innerHTML = lista.map(p => `
            <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-[1vh] px-[1vw] rounded-lg flex items-center justify-between">
                <div>
                    <p class="font-bold text-slate-900 dark:text-slate-100 flex items-center gap-[0.4vw] text-[0.8vw]">
                        ${p.pacienteNome}
                        ${p.prioridade ? '<span class="text-[0.6vw] uppercase px-[0.3vw] py-[0.1vh] font-bold rounded bg-rose-100 text-rose-700 border border-rose-300 dark:bg-rose-950 dark:text-rose-400 dark:border-rose-800">Prioritário</span>' : ''}
                    </p>
                    <p class="text-[0.7vw] text-slate-500 dark:text-slate-400 mt-[0.2vh]">Chegada: <span class="font-mono text-slate-700 dark:text-slate-300">${p.horarioChegada}</span></p>
                </div>
                <div class="text-right">
                    <span class="font-mono font-bold text-[0.85vw] text-${cor}-600 dark:text-${cor}-400">${p.tempoEsperaMinutos} min</span>
                </div>
            </div>
        `).join('');
    }

    setInterval(carregarTriagem, 2000);
    carregarTriagem();
</script>
{% endblock %}
