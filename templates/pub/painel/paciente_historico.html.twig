{% extends 'pub/base.html.twig' %}

{% block title %}Linha do Tempo do Paciente | Procordis{% endblock %}

{% block body %}
<div class="w-full flex flex-col justify-between gap-4">
    <!-- Card Principal de Informações do Paciente -->
    <div class="w-full bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 shrink-0">
        <div class="flex items-center gap-3">
            <a href="/painel/espera" class="h-10 w-10 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            </a>
            <div>
                <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 uppercase tracking-widest font-semibold">Linha do Tempo do Atendimento</span>
                <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white leading-tight mt-0.5">
                    {% if app.user %}
                        {{ agendamento.paciente.nomeCompleto ?? agendamento.paciente.nomeExibicao }}
                    {% else %}
                        Senha {{ agendamento.prioridade ? 'P' : 'N' }}{{ '%03d'|format(agendamento.id % 99 + 1) }}
                    {% endif %}
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Status: <span class="font-bold text-cyan-600 dark:text-cyan-400 uppercase">{{ agendamento.status }}</span></p>
            </div>
        </div>

        <div>
            <p class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 uppercase tracking-widest font-semibold">Médico & Especialidade</p>
            <h3 class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-200 mt-0.5">{{ agendamento.medico ? agendamento.medico.nome : 'A definir' }}</h3>
            <p class="text-xs text-indigo-600 dark:text-indigo-400 mt-0.5">{{ agendamento.especialidade ? agendamento.especialidade.nome : 'Clínica' }}</p>
        </div>

        <div class="flex items-center gap-4 bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-3 px-4 rounded-xl self-start sm:self-auto">
            <div>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-widest">Chegada</p>
                <p class="text-sm font-mono font-bold text-slate-800 dark:text-slate-200">{{ agendamento.horarioChegada ? agendamento.horarioChegada|date("H:i") : '--:--' }}</p>
            </div>
            <div class="h-6 w-px bg-slate-300 dark:bg-slate-800"></div>
            <div>
                <p class="text-[10px] text-cyan-600 dark:text-cyan-400 font-semibold uppercase tracking-widest">Tempo Espera</p>
                <p class="text-base font-mono font-black text-cyan-600 dark:text-cyan-400">{{ agendamento.tempoEsperaMinutos ?? 0 }} min</p>
            </div>
        </div>
    </div>

    <!-- Linha do Tempo de Etapas -->
    <div class="flex-1 w-full bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col justify-between">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-3 shrink-0">Etapas Percorridas no Atendimento</h3>

        <div id="timeline-container" class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-3 pl-4 space-y-3 overflow-y-auto flex-1">
            <p class="text-slate-400 text-xs">Carregando histórico do paciente...</p>
        </div>
    </div>
</div>

<script>
    async function carregarHistorico() {
        const agendamentoId = {{ agendamento.id }};
        try {
            const res = await fetch(`/api/v1/painel/paciente/${agendamentoId}/historico`);
            const data = await res.json();

            if (data.sucesso && data.historico) {
                renderizarTimeline(data.historico);
            }
        } catch (e) {
            console.error("Erro ao carregar histórico:", e);
        }
    }

    function renderizarTimeline(historico) {
        const container = document.getElementById('timeline-container');
        if (!historico || historico.length === 0) {
            container.innerHTML = `<p class="text-slate-400 text-[0.75vw]">Nenhum evento registrado no histórico.</p>`;
            return;
        }

        container.innerHTML = historico.map(h => `
            <div class="relative group">
                <div class="absolute -left-[1.3vw] top-[0.6vh] h-[1vh] w-[1vh] rounded-full bg-cyan-500 border-2 border-slate-100 dark:border-slate-950 shadow"></div>
                <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-[1vh] px-[1vw] rounded-lg">
                    <div class="flex items-center justify-between gap-[0.5vw]">
                        <h4 class="text-[0.8vw] font-bold text-slate-900 dark:text-white uppercase tracking-wider">${h.etapaRotulo}</h4>
                        <span class="font-mono text-[0.7vw] font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 px-[0.4vw] py-[0.1vh] rounded">
                            ${h.inicio} ${h.fim ? ` → ${h.fim}` : ''}
                        </span>
                    </div>
                    <p class="text-[0.7vw] text-slate-600 dark:text-slate-400 mt-[0.2vh]">Responsável: <span class="text-slate-800 dark:text-slate-200 font-medium">${h.responsavel || 'Sistema'}</span></p>
                    ${h.sala ? `<p class="text-[0.7vw] text-slate-600 dark:text-slate-400 mt-[0.1vh]">Local: <span class="text-emerald-600 dark:text-emerald-400 font-medium">${h.sala}</span></p>` : ''}
                </div>
            </div>
        `).join('');
    }

    carregarHistorico();
</script>
{% endblock %}
