{% extends 'pub/base.html.twig' %}

{% block title %}Tela 1: Pacientes Aguardando (Pré-Atendimento) | Procordis{% endblock %}

{% block body %}
<div class="h-full w-full flex flex-col justify-between overflow-hidden gap-[1vh]">
    <!-- Top KPIs Bar (5 Indicadores de Resumo - 12vh) -->
    <div class="h-[12vh] w-full grid grid-cols-5 gap-[0.8vw] shrink-0">
        <div class="bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-[0.8vw] rounded-xl shadow-sm flex flex-col justify-between">
            <p class="text-[0.6vw] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Senhas na Fila</p>
            <h3 id="kpi-senhas" class="text-[1.8vw] font-black text-cyan-600 dark:text-cyan-400 font-mono leading-none">0</h3>
            <p class="text-[0.6vw] text-slate-400">Aguardando atendimento</p>
        </div>

        <div class="bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-[0.8vw] rounded-xl shadow-sm flex flex-col justify-between">
            <p class="text-[0.6vw] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Média P/ Recepção</p>
            <h3 id="kpi-media-p-recepcao" class="text-[1.8vw] font-black text-indigo-600 dark:text-indigo-400 font-mono leading-none">00:00</h3>
            <p class="text-[0.6vw] text-slate-400">Da senha ao guichê</p>
        </div>

        <div class="bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-[0.8vw] rounded-xl shadow-sm flex flex-col justify-between">
            <p class="text-[0.6vw] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Média de Recepção</p>
            <h3 id="kpi-media-de-recepcao" class="text-[1.8vw] font-black text-sky-600 dark:text-sky-400 font-mono leading-none">00:00</h3>
            <p class="text-[0.6vw] text-slate-400">Duração no guichê</p>
        </div>

        <div class="bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-[0.8vw] rounded-xl shadow-sm flex flex-col justify-between">
            <p class="text-[0.6vw] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Média Tempo Total</p>
            <h3 id="kpi-media-total" class="text-[1.8vw] font-black text-emerald-600 dark:text-emerald-400 font-mono leading-none">00:00</h3>
            <p class="text-[0.6vw] text-slate-400">Permanência na clínica</p>
        </div>

        <div class="bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-[0.8vw] rounded-xl shadow-sm flex flex-col justify-between bg-amber-500/5 border-amber-500/30">
            <p class="text-[0.6vw] font-bold text-amber-700 dark:text-amber-400 uppercase tracking-widest">Maior Tempo Atend.</p>
            <h3 id="kpi-maior-tempo" class="text-[1.8vw] font-black text-amber-600 dark:text-amber-400 font-mono leading-none">00:00</h3>
            <p class="text-[0.6vw] text-amber-700/80 dark:text-amber-400/80 font-medium">Alerta de maior espera</p>
        </div>
    </div>

    <!-- Tabela Principal de Pacientes em Pré-Atendimento (78vh de Altura) -->
    <div class="flex-1 w-full bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-lg flex flex-col min-h-0">
        <div class="w-full overflow-y-auto flex-1">
            <table class="w-full text-left text-[0.75vw] text-slate-700 dark:text-slate-300">
                <thead class="bg-slate-100 dark:bg-slate-950/90 text-[0.65vw] uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-10 backdrop-blur">
                    <tr>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Senha</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Tipo Senha</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Etapa Atual</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw] text-center">Qtd</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Atendimento</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">AN (Access No.)</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Data</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Hora Senha</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Início Rec.</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Fim Rec.</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw] text-center">Tempo & SLA</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Guichê</th>
                        <th scope="col" class="py-[0.8vh] px-[0.8vw]">Procedimento</th>
                    </tr>
                </thead>
                <tbody id="tabela-aguardando-corpo" class="divide-y divide-slate-200/80 dark:divide-slate-800/60">
                    <tr>
                        <td colspan="13" class="py-[8vh] text-center text-slate-400">
                            Carregando pré-atendimento em tempo real...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    async function carregarPainelAguardando() {
        try {
            const res = await fetch('/api/v1/painel/aguardando');
            const data = await res.json();

            if (data.sucesso) {
                document.getElementById('kpi-senhas').innerText = data.kpis.totalSenhas;
                document.getElementById('kpi-media-p-recepcao').innerText = data.kpis.mediaTempoParaRecepcao;
                document.getElementById('kpi-media-de-recepcao').innerText = data.kpis.mediaTempoDeRecepcao;
                document.getElementById('kpi-media-total').innerText = data.kpis.mediaTempoTotalAtendimento;
                document.getElementById('kpi-maior-tempo').innerText = data.kpis.maiorTempoAtendimento;

                renderizarTabela(data.pacientes);
            }
        } catch (e) {
            console.error("Erro ao carregar pré-atendimento:", e);
        }
    }

    function renderizarTabela(pacientes) {
        const tbody = document.getElementById('tabela-aguardando-corpo');
        if (!pacientes || pacientes.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="13" class="py-[8vh] text-center text-slate-400 font-medium">
                        Nenhum paciente na fila de pré-atendimento no momento.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = pacientes.map(p => {
            let slaIcon = '🟢';
            let slaBadgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-400 dark:border-emerald-800';

            if (p.slaCor === 'amarelo') {
                slaIcon = '⚠️';
                slaBadgeClass = 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950 dark:text-amber-400 dark:border-amber-800';
            } else if (p.slaCor === 'vermelho') {
                slaIcon = '🚨';
                slaBadgeClass = 'bg-rose-100 text-rose-800 border-rose-300 dark:bg-rose-950 dark:text-rose-400 dark:border-rose-800 animate-pulse';
            }

            return `
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/90 transition-colors">
                    <td class="py-[0.8vh] px-[0.8vw] font-black font-mono text-cyan-600 dark:text-cyan-400 text-[0.85vw]">${p.senha}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-semibold text-slate-800 dark:text-slate-200">${p.tipoSenha}</td>
                    <td class="py-[0.8vh] px-[0.8vw]">
                        <span class="px-[0.5vw] py-[0.1vh] text-[0.6vw] font-bold rounded-md uppercase bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
                            ${p.etapaAtual}
                        </span>
                    </td>
                    <td class="py-[0.8vh] px-[0.8vw] text-center font-mono font-bold text-slate-800 dark:text-slate-200">${p.qtd}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-mono text-slate-500 dark:text-slate-400 text-[0.7vw]">${p.atendimento}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-mono text-slate-500 dark:text-slate-400 text-[0.7vw]">${p.an}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-mono text-slate-600 dark:text-slate-400">${p.data}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-mono text-slate-700 dark:text-slate-300">${p.horaSenha}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-mono text-slate-600 dark:text-slate-400">${p.inicioRecepcao}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-mono text-slate-600 dark:text-slate-400">${p.fimRecepcao}</td>
                    <td class="py-[0.8vh] px-[0.8vw] text-center">
                        <span class="inline-flex items-center gap-[0.3vw] px-[0.6vw] py-[0.1vh] text-[0.7vw] font-mono font-bold rounded-full border ${slaBadgeClass}">
                            ${slaIcon} ${p.tempoTotalFormatado}
                        </span>
                    </td>
                    <td class="py-[0.8vh] px-[0.8vw] font-medium text-slate-800 dark:text-slate-200">${p.guiche}</td>
                    <td class="py-[0.8vh] px-[0.8vw] font-semibold text-indigo-600 dark:text-indigo-400">${p.procedimento}</td>
                </tr>
            `;
        }).join('');
    }

    setInterval(carregarPainelAguardando, 2500);
    carregarPainelAguardando();
</script>
{% endblock %}
