{% extends 'pub/base.html.twig' %}

{% block title %}Painel dos Médicos | Procordis{% endblock %}

{% block body %}
<div class="w-full max-w-[1600px] mx-auto space-y-4 sm:space-y-5">
    <div id="grid-medicos" class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <div class="col-span-full text-center py-12 text-slate-400 text-sm">
            Carregando médicos e consultórios...
        </div>
    </div>
</div>

<script>
    async function carregarMedicos() {
        try {
            const res = await fetch('/api/v1/painel/medicos');
            const data = await res.json();

            if (data.sucesso && data.medicos) {
                renderizarGrid(data.medicos);
            }
        } catch (e) {
            console.error("Erro ao carregar médicos:", e);
        }
    }

    function renderizarGrid(medicos) {
        const grid = document.getElementById('grid-medicos');
        if (!medicos || medicos.length === 0) {
            grid.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400 text-sm">Nenhum médico cadastrado</div>`;
            return;
        }

        grid.innerHTML = medicos.map(m => {
            const emAtendimento = m.statusAtividade === 'em_atendimento';
            let statusBadge = `<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-100 text-emerald-700 border border-emerald-300 dark:bg-emerald-950 dark:text-emerald-400 dark:border-emerald-800">Disponível</span>`;
            if (emAtendimento) {
                statusBadge = `<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-indigo-100 text-indigo-700 border border-indigo-300 dark:bg-indigo-950 dark:text-indigo-400 dark:border-indigo-800 animate-pulse">Em Consulta</span>`;
            } else if (m.statusAtividade === 'em_pausa') {
                statusBadge = `<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-amber-100 text-amber-700 border border-amber-300 dark:bg-amber-950 dark:text-amber-400 dark:border-amber-800">Em Pausa</span>`;
            }

            return `
                <div class="rounded-2xl bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-4 sm:p-5 flex flex-col justify-between shadow-sm hover:border-slate-300 dark:hover:border-slate-700 transition">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-950 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-800">${m.crm || 'CRM'}</span>
                            ${statusBadge}
                        </div>

                        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-tight">${m.nome}</h3>
                        <p class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 mt-1">${m.especialidade}</p>

                        ${m.pacienteAtual ? `
                            <div class="mt-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-950/80 border border-indigo-200 dark:border-indigo-500/30">
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-widest font-semibold">Paciente em Consulta</p>
                                <p class="text-sm font-bold text-slate-900 dark:text-white mt-0.5">${m.pacienteAtual.nome}</p>
                                <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-200 dark:border-slate-800 text-xs">
                                    <span class="text-slate-600 dark:text-slate-400">${m.pacienteAtual.sala}</span>
                                    <span class="font-mono font-bold text-indigo-600 dark:text-indigo-400">${m.pacienteAtual.tempoDecorridoMinutos} min</span>
                                </div>
                            </div>
                        ` : `
                            <div class="mt-4 p-3 rounded-xl bg-slate-50/50 dark:bg-slate-950/40 border border-dashed border-slate-200 dark:border-slate-800 text-center text-xs text-slate-400">
                                Nenhum paciente em atendimento
                            </div>
                        `}
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                        <span>Fila do Médico:</span>
                        <span class="font-bold text-slate-900 dark:text-white">${m.pacientesAguardandoCount} pacientes</span>
                    </div>
                </div>
            `;
        }).join('');
    }

    setInterval(carregarMedicos, 2000);
    carregarMedicos();
</script>
{% endblock %}
