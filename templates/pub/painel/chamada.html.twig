{% extends 'pub/base.html.twig' %}

{% block title %}Telão de Chamadas | Procordis{% endblock %}

{% block body %}
<div class="w-full max-w-[1600px] mx-auto space-y-4 sm:space-y-5">
    <!-- Main Active Call Card (TV View) -->
    <div id="card-chamada-ativa" class="min-h-[360px] sm:min-h-[420px] w-full rounded-3xl bg-white/95 dark:bg-slate-900/90 border-2 border-cyan-500/40 p-5 sm:p-6 lg:p-8 shadow-2xl backdrop-blur-2xl flex flex-col justify-between text-center relative overflow-hidden transition-all duration-500">
        <!-- Badge Destaque -->
        <div class="flex items-center justify-between w-full">
            <span class="inline-block px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 font-bold text-xs sm:text-sm uppercase tracking-widest">
                Última Chamada no Telão
            </span>
            <button onclick="tocarChime()" title="Testar Som do Telão" class="bg-slate-100 dark:bg-slate-950 hover:bg-slate-200 dark:hover:bg-slate-800 text-cyan-600 dark:text-cyan-400 border border-slate-300 dark:border-cyan-500/30 px-3 py-1 rounded-xl transition active:scale-95 text-xs font-bold cursor-pointer">
                🔔 Testar Som
            </button>
        </div>

        <!-- Senha Grande -->
        <div class="my-2 lg:my-[1vh]">
            <h2 id="senha-numero" class="text-6xl sm:text-7xl md:text-8xl lg:text-[9vw] leading-none font-black font-mono tracking-tighter text-slate-900 dark:bg-gradient-to-r dark:from-cyan-300 dark:via-sky-200 dark:to-indigo-300 dark:bg-clip-text dark:text-transparent drop-shadow">
                ---
            </h2>
        </div>

        <!-- Paciente -->
        <div class="my-1 lg:my-[0.5vh]">
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 uppercase tracking-widest font-semibold">Paciente</p>
            <h3 id="paciente-nome" class="text-2xl sm:text-3xl md:text-4xl lg:text-[3vw] leading-tight font-extrabold text-slate-900 dark:text-white mt-1">
                Aguardando Chamadas...
            </h3>
        </div>

        <!-- Local & Médico -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 pt-3 sm:pt-4 border-t border-slate-200 dark:border-slate-800">
            <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-3 sm:p-4 rounded-2xl text-center">
                <p class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-widest font-semibold">Local de Atendimento</p>
                <p id="local-atendimento" class="text-xl sm:text-2xl lg:text-[2.2vw] leading-tight font-black text-emerald-600 dark:text-emerald-400 mt-1">
                    ---
                </p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 p-3 sm:p-4 rounded-2xl text-center">
                <p class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-widest font-semibold">Médico Responsável</p>
                <p id="medico-nome" class="text-lg sm:text-xl lg:text-[1.8vw] leading-tight font-bold text-indigo-600 dark:text-indigo-300 mt-1">
                    ---
                </p>
            </div>
        </div>
    </div>

    <!-- Ticker de Histórico de Chamadas Anteriores -->
    <div class="min-h-[180px] lg:h-[24vh] w-full bg-white/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-3xl p-4 sm:p-5 flex flex-col justify-between shadow-lg shrink-0">
        <h4 class="text-xs sm:text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Chamadas Anteriores
        </h4>

        <div id="grid-historico-chamadas" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 flex-1 items-center mt-2">
            <div class="bg-slate-50 dark:bg-slate-950/40 border border-slate-200 dark:border-slate-800 p-3 rounded-2xl text-center text-slate-400 text-xs">
                Sem histórico recente
            </div>
        </div>
    </div>
</div>

<script>
    let ultimaIdProcessada = null;

    function tocarChime() {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();

            const playNote = (freq, time, duration) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, ctx.currentTime + time);
                gain.gain.setValueAtTime(0.3, ctx.currentTime + time);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + time + duration);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(ctx.currentTime + time);
                osc.stop(ctx.currentTime + time + duration);
            };

            playNote(783.99, 0, 0.6);
            playNote(659.25, 0.25, 0.6);
            playNote(523.25, 0.5, 0.9);
        } catch (e) {
            console.log("Audio error:", e);
        }
    }

    async function buscarUltimasChamadas() {
        try {
            const res = await fetch('/api/v1/painel/chamada/ultimas');
            const data = await res.json();

            if (data.sucesso && data.todasChamadas && data.todasChamadas.length > 0) {
                const atual = data.todasChamadas[0];

                if (ultimaIdProcessada !== null && ultimaIdProcessada !== atual.id) {
                    tocarChime();
                    animarCardChamada();
                }
                ultimaIdProcessada = atual.id;

                document.getElementById('senha-numero').innerText = atual.senha || '---';
                document.getElementById('paciente-nome').innerText = atual.pacienteNomeMascarado || '---';
                document.getElementById('local-atendimento').innerText = atual.guicheOuConsultorio || '---';
                document.getElementById('medico-nome').innerText = atual.medicoNome || 'Dr. Médico';

                renderizarHistorico(data.todasChamadas.slice(1, 5));
            }
        } catch (e) {
            console.error("Erro ao buscar chamadas no telão:", e);
        }
    }

    function animarCardChamada() {
        const card = document.getElementById('card-chamada-ativa');
        card.classList.add('ring-4', 'ring-cyan-500', 'scale-[1.02]');
        setTimeout(() => {
            card.classList.remove('ring-4', 'ring-cyan-500', 'scale-[1.02]');
        }, 1500);
    }

    function renderizarHistorico(lista) {
        const grid = document.getElementById('grid-historico-chamadas');
        if (!lista || lista.length === 0) {
            grid.innerHTML = `<div class="col-span-4 bg-slate-50 dark:bg-slate-950/40 border border-slate-200 dark:border-slate-800 p-[1vh] rounded-xl text-center text-slate-400 text-[0.75vw]">Nenhuma chamada anterior registrada</div>`;
            return;
        }

        grid.innerHTML = lista.map(c => `
            <div class="bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 p-[1vh] px-[1vw] rounded-xl flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[1.3vw] font-black font-mono text-cyan-600 dark:text-cyan-400 leading-tight block">${c.senha}</span>
                    <p class="text-[0.75vw] font-semibold text-slate-800 dark:text-slate-200 truncate max-w-[10vw]">${c.pacienteNomeMascarado}</p>
                </div>
                <div class="text-right">
                    <span class="text-[0.75vw] font-bold text-emerald-600 dark:text-emerald-400 block">${c.guicheOuConsultorio}</span>
                    <span class="text-[0.65vw] text-slate-500 dark:text-slate-400 font-mono">${c.dataHoraChamada}</span>
                </div>
            </div>
        `).join('');
    }

    setInterval(buscarUltimasChamadas, 1500);
    buscarUltimasChamadas();
</script>
{% endblock %}
